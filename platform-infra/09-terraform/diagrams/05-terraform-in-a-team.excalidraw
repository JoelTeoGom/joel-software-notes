      "text": "GitOps (Argo CD)  =  pull",
      "fontSize": 18,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 15,
      "containerId": null,
      "originalText": "GitOps (Argo CD)  =  pull",
