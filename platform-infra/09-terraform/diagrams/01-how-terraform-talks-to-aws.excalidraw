      "roundness": null,
      "seed": 208324308,
      "version": 1,
      "versionNonce": 0,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1795191002189,
      "link": null,
      "locked": false,
      "text": "Why the provider is pinned (~> 5.0)",
      "fontSize": 18,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 15,
      "containerId": null,
      "originalText": "Why the provider is pinned (~> 5.0)",
      "lineHeight": 1.25
    },
    {
      "id": "note-body-37",
      "type": "text",
      "x": 1540,
      "y": 810,
      "width": 474.8636474609375,
      "height": 60,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1504231532,
      "version": 1,
      "versionNonce": 0,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1795191002189,
      "link": null,
      "locked": false,
      "text": "The provider is a separate binary with its own versions.\nterraform init downloads it to .terraform/ and writes the\nexact version and hashes to .terraform.lock.hcl (committed).",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 54,
      "containerId": null,
      "originalText": "The provider is a separate binary with its own versions.\nterraform init downloads it to .terraform/ and writes the\nexact version and hashes to .terraform.lock.hcl (committed).",
      "lineHeight": 1.25
    },
