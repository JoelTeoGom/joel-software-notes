      "link": null,
      "locked": false
    },
    {
      "id": "04-where-the-state-lives/note-heading-112",
      "type": "text",
      "x": 1280,
      "y": 3496,
      "width": 364.9137878417969,
      "height": 22.5,
      "angle": 0,
      "strokeColor": "#c92a2a",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 401922004,
      "version": 1,
      "versionNonce": 0,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1795190909925,
      "link": null,
      "locked": false,
      "text": "The state holds every value in plaintext",
      "fontSize": 18,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 15,
      "containerId": null,
      "originalText": "The state holds every value in plaintext",
      "lineHeight": 1.25
    },
    {
      "id": "04-where-the-state-lives/note-body-113",
      "type": "text",
      "x": 1280,
      "y": 3530,
      "width": 442.1917724609375,
      "height": 160,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 809779052,
      "version": 1,
      "versionNonce": 0,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1795190909926,
      "link": null,
      "locked": false,
      "text": "Including jwt_secret, even with sensitive = true\n(that only hides it in the plan output).\n\n- never commit it: *.tfstate is in .gitignore\n- whoever reads the bucket reads the secrets\n- better: keep the secret in SSM Parameter Store or\n  Secrets Manager and pass only its name; the Lambda\n  reads the value when it starts",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 154,
      "containerId": null,
      "originalText": "Including jwt_secret, even with sensitive = true\n(that only hides it in the plan output).\n\n- never commit it: *.tfstate is in .gitignore\n- whoever reads the bucket reads the secrets\n- better: keep the secret in SSM Parameter Store or\n  Secrets Manager and pass only its name; the Lambda\n  reads the value when it starts",
      "lineHeight": 1.25
    },
    {
      "id": "04-where-the-state-lives/text-114",
