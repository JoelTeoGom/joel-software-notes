    },
    {
      "id": "02-plan-and-apply/note-heading-63",
      "type": "text",
      "x": 60,
      "y": 1846,
      "width": 292.17584228515625,
      "height": 22.5,
      "angle": 0,
      "strokeColor": "#f08c00",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1459493586,
      "version": 1,
      "versionNonce": 0,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1795191003268,
      "link": null,
      "locked": false,
      "text": "No agent, so drift waits for you",
      "fontSize": 18,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 15,
      "containerId": null,
      "originalText": "No agent, so drift waits for you",
      "lineHeight": 1.25
    },
    {
      "id": "02-plan-and-apply/note-body-64",
      "type": "text",
      "x": 60,
      "y": 1880,
      "width": 454.84765625,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 866333518,
      "version": 1,
      "versionNonce": 0,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1795191003269,
      "link": null,
      "locked": false,
      "text": "Nothing watches AWS between runs. If someone turns off\nthe TTL in the console, AWS and the code disagree until\nthe next plan shows  ~ ttl enabled: false -> true.\nArgo CD self-heals; Terraform only reports and fixes\nwhen you run it (or a scheduled CI job does).",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 94,
      "containerId": null,
      "originalText": "Nothing watches AWS between runs. If someone turns off\nthe TTL in the console, AWS and the code disagree until\nthe next plan shows  ~ ttl enabled: false -> true.\nArgo CD self-heals; Terraform only reports and fixes\nwhen you run it (or a scheduled CI job does).",
      "lineHeight": 1.25
    },
    {
      "id": "02-plan-and-apply/note-65",
      "type": "rectangle",
      "x": 720,
      "y": 1830,
      "width": 640,
      "height": 200,
      "angle": 0,
      "strokeColor": "#f08c00",
      "backgroundColor": "#fff9db",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": {
        "type": 3
      },
      "seed": 836169874,
      "version": 1,
      "versionNonce": 0,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1795191003269,
      "link": null,
      "locked": false
    },
    {
      "id": "02-plan-and-apply/note-heading-66",
      "type": "text",
      "x": 740,
      "y": 1846,
      "width": 295.73980712890625,
      "height": 22.5,
      "angle": 0,
      "strokeColor": "#f08c00",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 800823694,
      "version": 1,
      "versionNonce": 0,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1795191003269,
      "link": null,
      "locked": false,
      "text": "Read the plan before every apply",
      "fontSize": 18,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 15,
      "containerId": null,
      "originalText": "Read the plan before every apply",
      "lineHeight": 1.25
    },
    {
      "id": "02-plan-and-apply/note-body-67",
      "type": "text",
      "x": 740,
      "y": 1880,
      "width": 429.10369873046875,
      "height": 80,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1854869074,
      "version": 1,
      "versionNonce": 0,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1795191003269,
      "link": null,
      "locked": false,
      "text": "Look for 'must be replaced': changing a table name\nmeans destroy + create, and the data is gone.\nplan -out=file then apply file applies exactly what you\nreviewed, even if the code changed in between.",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 74,
      "containerId": null,
      "originalText": "Look for 'must be replaced': changing a table name\nmeans destroy + create, and the data is gone.\nplan -out=file then apply file applies exactly what you\nreviewed, even if the code changed in between.",
      "lineHeight": 1.25
    },
