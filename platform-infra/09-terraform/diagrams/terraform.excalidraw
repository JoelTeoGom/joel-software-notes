      "seed": 1812480596,
      "version": 1,
      "versionNonce": 0,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1795190909925,
      "link": null,
      "locked": false,
      "text": "versioning on: a broken state can be rolled back\nencrypted, not public, created outside this Terraform",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 34,
      "containerId": null,
      "originalText": "versioning on: a broken state can be rolled back\nencrypted, not public, created outside this Terraform",
      "lineHeight": 1.25
    },
    {
      "id": "04-where-the-state-lives/note-111",
      "type": "rectangle",
      "x": 1260,
      "y": 3480,
      "width": 820,
      "height": 380,
      "angle": 0,
      "strokeColor": "#c92a2a",
      "backgroundColor": "#fff5f5",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
