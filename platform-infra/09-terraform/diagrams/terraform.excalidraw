    {
      "id": "04-where-the-state-lives/text-110",
      "type": "text",
      "x": 680,
      "y": 3790,
      "width": 422.9757080078125,
      "height": 40,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
