    {
      "id": "01-how-terraform-talks-to-aws/note-heading-30",
      "type": "text",
      "x": 60,
      "y": 776,
      "width": 288.50384521484375,
      "height": 22.5,
      "angle": 0,
      "strokeColor": "#f08c00",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1630180948,
      "version": 1,
      "versionNonce": 0,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1795191002188,
      "link": null,
      "locked": false,
      "text": "Where the credentials come from",
      "fontSize": 18,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 15,
      "containerId": null,
      "originalText": "Where the credentials come from",
      "lineHeight": 1.25
    },
    {
      "id": "01-how-terraform-talks-to-aws/note-body-31",
      "type": "text",
      "x": 60,
      "y": 810,
      "width": 445.6956787109375,
      "height": 60,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 221227244,
      "version": 1,
      "versionNonce": 0,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1795191002188,
      "link": null,
      "locked": false,
      "text": "Not from the .tf files. The provider reads them like the\nAWS CLI does: env vars, ~/.aws, or an IAM role in CI.\nThe API answers 403 if that identity lacks permission.",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 54,
      "containerId": null,
      "originalText": "Not from the .tf files. The provider reads them like the\nAWS CLI does: env vars, ~/.aws, or an IAM role in CI.\nThe API answers 403 if that identity lacks permission.",
      "lineHeight": 1.25
    },
    {
      "id": "01-how-terraform-talks-to-aws/note-32",
      "type": "rectangle",
      "x": 780,
      "y": 760,
      "width": 700,
      "height": 150,
      "angle": 0,
      "strokeColor": "#f08c00",
      "backgroundColor": "#fff9db",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": {
        "type": 3
      },
      "seed": 1571597268,
      "version": 1,
      "versionNonce": 0,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1795191002188,
      "link": null,
      "locked": false
    },
    {
      "id": "01-how-terraform-talks-to-aws/note-heading-33",
      "type": "text",
      "x": 800,
      "y": 776,
      "width": 235.0978546142578,
      "height": 22.5,
      "angle": 0,
      "strokeColor": "#f08c00",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 564374380,
      "version": 1,
      "versionNonce": 0,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1795191002189,
      "link": null,
      "locked": false,
      "text": "Terraform is a translator",
      "fontSize": 18,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 15,
      "containerId": null,
      "originalText": "Terraform is a translator",
      "lineHeight": 1.25
    },
    {
      "id": "01-how-terraform-talks-to-aws/note-body-34",
      "type": "text",
      "x": 800,
      "y": 810,
      "width": 409.039794921875,
      "height": 60,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 2085622100,
      "version": 1,
      "versionNonce": 0,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1795191002189,
      "link": null,
      "locked": false,
      "text": "Every resource block is one AWS object, and every\nargument is a setting you would pick in the console.\nThe provider knows which API call sets each one.",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 54,
      "containerId": null,
      "originalText": "Every resource block is one AWS object, and every\nargument is a setting you would pick in the console.\nThe provider knows which API call sets each one.",
      "lineHeight": 1.25
    },
    {
      "id": "01-how-terraform-talks-to-aws/note-35",
      "type": "rectangle",
      "x": 1520,
      "y": 760,
      "width": 880,
      "height": 150,
      "angle": 0,
      "strokeColor": "#f08c00",
      "backgroundColor": "#fff9db",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": {
        "type": 3
      },
      "seed": 1030970860,
      "version": 1,
      "versionNonce": 0,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1795191002189,
      "link": null,
      "locked": false
    },
    {
      "id": "01-how-terraform-talks-to-aws/note-heading-36",
      "type": "text",
      "x": 1540,
      "y": 776,
      "width": 310.7337646484375,
      "height": 22.5,
      "angle": 0,
      "strokeColor": "#f08c00",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 208324308,
      "version": 1,
      "versionNonce": 0,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1795191002189,
      "link": null,
      "locked": false,
      "text": "Why the provider is pinned (~> 5.0)",
      "fontSize": 18,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 15,
      "containerId": null,
      "originalText": "Why the provider is pinned (~> 5.0)",
      "lineHeight": 1.25
    },
    {
      "id": "01-how-terraform-talks-to-aws/note-body-37",
      "type": "text",
      "x": 1540,
      "y": 810,
      "width": 474.8636474609375,
      "height": 60,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1504231532,
      "version": 1,
      "versionNonce": 0,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1795191002189,
      "link": null,
      "locked": false,
      "text": "The provider is a separate binary with its own versions.\nterraform init downloads it to .terraform/ and writes the\nexact version and hashes to .terraform.lock.hcl (committed).",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 54,
      "containerId": null,
      "originalText": "The provider is a separate binary with its own versions.\nterraform init downloads it to .terraform/ and writes the\nexact version and hashes to .terraform.lock.hcl (committed).",
      "lineHeight": 1.25
    },
