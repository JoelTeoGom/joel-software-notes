      "text": "Terraform in CI  =  push",
      "fontSize": 18,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 15,
      "containerId": null,
      "originalText": "Terraform in CI  =  push",
      "lineHeight": 1.25
    },
    {
      "id": "05-terraform-in-a-team/note-body-152",
      "type": "text",
      "x": 1100,
      "y": 5252.5,
      "width": 523.503662109375,
      "height": 60,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1889231791,
      "version": 1,
      "versionNonce": 0,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1795191005554,
      "link": null,
      "locked": false,
      "text": "CI calls the AWS APIs with a role it assumes for a few minutes.\nDrift is only seen when plan runs: teams schedule a nightly plan\nthat alerts when AWS no longer matches main.",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 54,
      "containerId": null,
      "originalText": "CI calls the AWS APIs with a role it assumes for a few minutes.\nDrift is only seen when plan runs: teams schedule a nightly plan\nthat alerts when AWS no longer matches main.",
      "lineHeight": 1.25
    },
