      "baseline": 15,
      "containerId": null,
      "originalText": "No agent, so drift waits for you",
      "lineHeight": 1.25
    },
    {
      "id": "note-body-64",
      "type": "text",
      "x": 60,
      "y": 770,
      "width": 454.84765625,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 866333518,
      "version": 1,
      "versionNonce": 0,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1795191003269,
      "link": null,
      "locked": false,
      "text": "Nothing watches AWS between runs. If someone turns off\nthe TTL in the console, AWS and the code disagree until\nthe next plan shows  ~ ttl enabled: false -> true.\nArgo CD self-heals; Terraform only reports and fixes\nwhen you run it (or a scheduled CI job does).",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 94,
      "containerId": null,
      "originalText": "Nothing watches AWS between runs. If someone turns off\nthe TTL in the console, AWS and the code disagree until\nthe next plan shows  ~ ttl enabled: false -> true.\nArgo CD self-heals; Terraform only reports and fixes\nwhen you run it (or a scheduled CI job does).",
      "lineHeight": 1.25
    },
