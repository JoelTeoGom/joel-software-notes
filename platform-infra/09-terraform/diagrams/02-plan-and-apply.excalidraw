    },
    {
      "id": "note-body-70",
      "type": "text",
      "x": 1420,
      "y": 770,
      "width": 329.98382568359375,
      "height": 120,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 500239886,
      "version": 1,
      "versionNonce": 0,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1795191003270,
      "link": null,
      "locked": false,
      "text": "init      download providers and modules\nfmt       format the code\nvalidate  check syntax and types\nplan      show the changes, touch nothing\napply     make the changes\ndestroy   delete everything in the state",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 114,
      "containerId": null,
      "originalText": "init      download providers and modules\nfmt       format the code\nvalidate  check syntax and types\nplan      show the changes, touch nothing\napply     make the changes\ndestroy   delete everything in the state",
      "lineHeight": 1.25
    },
