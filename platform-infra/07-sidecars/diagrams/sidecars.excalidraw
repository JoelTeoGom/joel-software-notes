    {
      "id": "01-every-team-writes-a-client:sc1-11",
      "type": "text",
      "x": 22,
      "y": 466,
      "width": 448.432861328125,
      "height": 80,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aA",
      "roundness": null,
      "seed": 159879382,
      "version": 2,
      "versionNonce": 1914166090,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792703854946,
      "link": null,
      "locked": false,
      "text": "- Regions tried one after another: latencies add up.\n- Tiny connection pool: requests queue for a socket.\n- Lock contention in their cache.\n- TCS answered in < 6 ms (p99); the TEAM saw it slow.",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- Regions tried one after another: latencies add up.\n- Tiny connection pool: requests queue for a socket.\n- Lock contention in their cache.\n- TCS answered in < 6 ms (p99); the TEAM saw it slow.",
      "autoResize": true,
      "lineHeight": 1.25
    },
