      "updated": 1792703854946,
      "link": null,
      "locked": false,
      "text": "Why the TCS team fixed it for them",
      "fontSize": 17,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Why the TCS team fixed it for them",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "01-every-team-writes-a-client:sc1-14",
      "type": "text",
      "x": 712,
      "y": 466,
      "width": 453.10491943359375,
      "height": 80,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aD",
      "roundness": null,
      "seed": 1197510218,
      "version": 2,
      "versionNonce": 171744150,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792703854946,
      "link": null,
      "locked": false,
      "text": "- N teams writing N clients = N copies of the same bugs.\n- TCS is on everyone's critical path: a bad failover\n  in one client still looks like 'TCS is down'.\n- The TCS team knows best how TCS should be called.",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- N teams writing N clients = N copies of the same bugs.\n- TCS is on everyone's critical path: a bad failover\n  in one client still looks like 'TCS is down'.\n- The TCS team knows best how TCS should be called.",
      "autoResize": true,
      "lineHeight": 1.25
    },
