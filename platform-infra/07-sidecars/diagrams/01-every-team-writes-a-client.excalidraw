      "boundElements": null,
      "updated": 1792703854667,
      "link": null,
      "locked": false,
      "text": "if t, ok := cache.Get(id); ok { return t, nil }\nch := make(chan *Tenant, len(regions))\nfor _, r := range regions {      // in PARALLEL\n  go func(r string) { ... ch <- t }(r)\n}\nselect {\ncase t := <-ch: cache.Set(id, t); return t, nil\ncase <-time.After(100 * time.Millisecond): ...\n}\n// + pool sized for the load, + SNS invalidation",
      "fontSize": 14,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "if t, ok := cache.Get(id); ok { return t, nil }\nch := make(chan *Tenant, len(regions))\nfor _, r := range regions {      // in PARALLEL\n  go func(r string) { ... ch <- t }(r)\n}\nselect {\ncase t := <-ch: cache.Set(id, t); return t, nil\ncase <-time.After(100 * time.Millisecond): ...\n}\n// + pool sized for the load, + SNS invalidation",
      "autoResize": true,
      "lineHeight": 1.2
    },
