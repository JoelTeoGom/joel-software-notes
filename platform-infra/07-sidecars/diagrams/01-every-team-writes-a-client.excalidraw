      "link": null,
      "locked": false,
      "text": "func GetTenant(id string) (*Tenant, error) {\n  resp, err := http.Get(usEast + id)\n  if err != nil {\n    // waited the WHOLE timeout first\n    resp, err = http.Get(euWest + id)\n  }\n  ...  // no cache, or 'cache 30 s'\n}\n// http.DefaultClient: 2 idle conns per host",
      "fontSize": 14,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "func GetTenant(id string) (*Tenant, error) {\n  resp, err := http.Get(usEast + id)\n  if err != nil {\n    // waited the WHOLE timeout first\n    resp, err = http.Get(euWest + id)\n  }\n  ...  // no cache, or 'cache 30 s'\n}\n// http.DefaultClient: 2 idle conns per host",
      "autoResize": true,
      "lineHeight": 1.2
    },
