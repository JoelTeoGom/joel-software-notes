      "link": null,
      "locked": false,
      "text": "- cache for up to 1 hour\n- listens to SNS invalidations\n  (updates land in seconds)\n- asks several regions in\n  PARALLEL, keeps the first answer\n- a properly sized pool\n- same API as the real TCS",
      "fontSize": 15,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- cache for up to 1 hour\n- listens to SNS invalidations\n  (updates land in seconds)\n- asks several regions in\n  PARALLEL, keeps the first answer\n- a properly sized pool\n- same API as the real TCS",
      "autoResize": true,
      "lineHeight": 1.25
    },
