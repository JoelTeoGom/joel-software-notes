      "isDeleted": false,
      "boundElements": null,
      "updated": 1792703819825,
      "link": null,
      "locked": false,
      "text": "A fixed outbound IP",
      "fontSize": 19,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "A fixed outbound IP",
      "autoResize": true,
