    {
      "id": "02-k8s-ingress-object-vs-controller:ie2-25",
      "type": "text",
      "x": 650,
      "y": 1448,
      "width": 461.7181396484375,
      "height": 37.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
