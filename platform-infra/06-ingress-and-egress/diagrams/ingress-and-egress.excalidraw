      "isDeleted": false,
      "boundElements": null,
      "updated": 1792703819825,
      "link": null,
      "locked": false,
      "text": "Routing depends on a lookup to the\ntenant directory on every request, for\nhundreds of thousands of tenants that\nmove between shards: static rules can't\ndo it. So it's option 2 or 3 (the article\ndoesn't say which).",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Routing depends on a lookup to the\ntenant directory on every request, for\nhundreds of thousands of tenants that\nmove between shards: static rules can't\ndo it. So it's option 2 or 3 (the article\ndoesn't say which).",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "04-egress:ie4-1",
