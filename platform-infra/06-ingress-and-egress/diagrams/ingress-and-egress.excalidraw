      "isDeleted": false,
      "boundElements": null,
      "updated": 1792703819825,
      "link": null,
      "locked": false,
      "text": "NetworkPolicy with egress rules:\n'this pod may only talk to its\nDB and DNS'. A compromised pod\ncan't send data anywhere else.\n(needs a CNI that enforces it:\nCalico, Cilium)",
      "fontSize": 15,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "NetworkPolicy with egress rules:\n'this pod may only talk to its\nDB and DNS'. A compromised pod\ncan't send data anywhere else.\n(needs a CNI that enforces it:\nCalico, Cilium)",
      "autoResize": true,
      "lineHeight": 1.25
    },
