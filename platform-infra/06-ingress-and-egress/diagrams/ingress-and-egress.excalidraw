      "isDeleted": false,
      "boundElements": null,
      "updated": 1792703819825,
      "link": null,
      "locked": false,
      "text": "Without a controller installed, an Ingress object does nothing.\nThe controller IS the L7 reverse proxy.",
      "fontSize": 15,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Without a controller installed, an Ingress object does nothing.\nThe controller IS the L7 reverse proxy.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "02-k8s-ingress-object-vs-controller:ie2-26",
      "type": "rectangle",
