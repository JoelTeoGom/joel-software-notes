      "text": "Egress: what's allowed out, and from which IP",
      "fontSize": 17,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Egress: what's allowed out, and from which IP",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "01-directions:ie1-28",
      "type": "text",
      "x": 712,
      "y": 606,
      "width": 418.48089599609375,
      "height": 80,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aR",
