      "seed": 1663294107,
      "version": 2,
      "versionNonce": 1853683701,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792703819825,
      "link": null,
      "locked": false,
      "text": "Often ignored (by default a pod can reach anything).\nYou control it for security (block exfiltration),\nfor a fixed outbound IP, and to audit what leaves.\nSee diagram 04.",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Often ignored (by default a pod can reach anything).\nYou control it for security (block exfiltration),\nfor a fixed outbound IP, and to audit what leaves.\nSee diagram 04.",
      "autoResize": true,
      "lineHeight": 1.25
    },
