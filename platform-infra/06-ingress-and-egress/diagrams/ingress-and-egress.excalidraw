      "versionNonce": 732718933,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792703819825,
      "link": null,
      "locked": false
    },
    {
      "id": "03-programming-an-ingress:ie3-4",
      "type": "text",
      "x": 24,
      "y": 2018,
      "width": 269.28778076171875,
      "height": 23.75,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b00",
      "roundness": null,
      "seed": 1951075317,
      "version": 2,
      "versionNonce": 19932283,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792703819825,
      "link": null,
      "locked": false,
      "text": "1. Off-the-shelf, static rules",
      "fontSize": 19,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. Off-the-shelf, static rules",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "03-programming-an-ingress:ie3-5",
      "type": "text",
      "x": 24,
      "y": 2065,
      "width": 222.89646911621094,
      "height": 160,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b01",
      "roundness": null,
      "seed": 313760219,
      "version": 2,
      "versionNonce": 78558389,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792703819825,
      "link": null,
      "locked": false,
      "text": "nginx / Traefik / ALB rules:\nhost + path -> service.\n\nPerfect when the routing\ntable is small and changes\nwith deploys.\n\nNo code.",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "nginx / Traefik / ALB rules:\nhost + path -> service.\n\nPerfect when the routing\ntable is small and changes\nwith deploys.\n\nNo code.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "03-programming-an-ingress:ie3-6",
