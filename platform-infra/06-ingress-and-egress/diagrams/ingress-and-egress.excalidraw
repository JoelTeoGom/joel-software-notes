      "isDeleted": false,
      "boundElements": null,
      "updated": 1792703819825,
      "link": null,
      "locked": false,
      "text": "Egress: when you control what goes out",
      "fontSize": 34,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Egress: when you control what goes out",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "04-egress:ie4-2",
