      "seed": 2113934363,
      "version": 2,
      "versionNonce": 510412405,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792703819825,
      "link": null,
      "locked": false,
      "text": "A payment provider or bank only\naccepts calls from IPs you\nregister (allowlist). All traffic\nleaves through one NAT gateway\n/ egress gateway with an\nElastic IP.",
      "fontSize": 15,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "A payment provider or bank only\naccepts calls from IPs you\nregister (allowlist). All traffic\nleaves through one NAT gateway\n/ egress gateway with an\nElastic IP.",
      "autoResize": true,
      "lineHeight": 1.25
    },
