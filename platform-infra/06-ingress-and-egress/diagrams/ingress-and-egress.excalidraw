    {
      "id": "02-k8s-ingress-object-vs-controller:ie2-31",
      "type": "text",
      "x": 642,
      "y": 1606,
      "width": 538.1611938476562,
      "height": 40,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aw",
      "roundness": null,
      "seed": 903943477,
      "version": 2,
      "versionNonce": 144602939,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792703819825,
      "link": null,
      "locked": false,
      "text": "Know both: Ingress (rules, ingressClassName, pathType, TLS secret)\nand Gateway API (Gateway + HTTPRoute).",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Know both: Ingress (rules, ingressClassName, pathType, TLS secret)\nand Gateway API (Gateway + HTTPRoute).",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "03-programming-an-ingress:ie3-1",
      "type": "text",
      "x": 0,
      "y": 1880,
      "width": 752.962158203125,
      "height": 42.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "ax",
      "roundness": null,
      "seed": 1682818203,
      "version": 2,
      "versionNonce": 806612469,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792703819825,
      "link": null,
      "locked": false,
      "text": "Can you program an ingress? Yes: three ways",
      "fontSize": 34,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Can you program an ingress? Yes: three ways",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "03-programming-an-ingress:ie3-2",
      "type": "text",
      "x": 2,
      "y": 1932,
      "width": 911.6190185546875,
      "height": 25,
      "angle": 0,
      "strokeColor": "#868e96",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "ay",
      "roundness": null,
      "seed": 601007765,
      "version": 2,
      "versionNonce": 2111952859,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792703819825,
      "link": null,
      "locked": false,
      "text": "'ingress' is a role, not a product; it can be config, a proxy plus your logic, or your own code",
      "fontSize": 20,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "'ingress' is a role, not a product; it can be config, a proxy plus your logic, or your own code",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "03-programming-an-ingress:ie3-3",
      "type": "rectangle",
      "x": 0,
      "y": 2000,
      "width": 425,
      "height": 300,
