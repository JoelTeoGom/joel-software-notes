      "isDeleted": false,
      "boundElements": null,
      "updated": 1792703819825,
      "link": null,
      "locked": false,
      "text": "2. Proxy + your logic",
      "fontSize": 19,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "2. Proxy + your logic",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "03-programming-an-ingress:ie3-8",
      "type": "text",
      "x": 479,
      "y": 2065,
      "width": 236.62451171875,
      "height": 200,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b04",
      "roundness": null,
      "seed": 1614172853,
      "version": 2,
      "versionNonce": 1957134779,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792703819825,
      "link": null,
      "locked": false,
      "text": "Envoy or nginx do the heavy\nlifting (TLS, pools, retries,\nmetrics). You add a hook:\n\nEnvoy ext_proc / ext_authz,\na Lua filter (OpenResty)\n-> calls your lookup service\n-> sets the upstream.\n\nThe most common choice.",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Envoy or nginx do the heavy\nlifting (TLS, pools, retries,\nmetrics). You add a hook:\n\nEnvoy ext_proc / ext_authz,\na Lua filter (OpenResty)\n-> calls your lookup service\n-> sets the upstream.\n\nThe most common choice.",
      "autoResize": true,
      "lineHeight": 1.25
    },
