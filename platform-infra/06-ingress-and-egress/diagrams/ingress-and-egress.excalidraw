      "locked": false
    },
    {
      "id": "03-programming-an-ingress:ie3-7",
      "type": "text",
      "x": 479,
      "y": 2018,
      "width": 196.5935821533203,
      "height": 23.75,
      "angle": 0,
      "strokeColor": "#6741d9",
