      "link": null,
      "locked": false,
      "text": "Egress: when you control what goes out",
      "fontSize": 34,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Egress: when you control what goes out",
