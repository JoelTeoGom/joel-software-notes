      "isDeleted": false,
      "boundElements": null,
      "updated": 1792703819731,
      "link": null,
      "locked": false,
      "text": "A fixed outbound IP",
      "fontSize": 19,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "A fixed outbound IP",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "ie4-8",
      "type": "text",
      "x": 402,
      "y": 210,
      "width": 245.8966827392578,
      "height": 112.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a7",
      "roundness": null,
      "seed": 1258588245,
      "version": 2,
      "versionNonce": 1936922203,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792703819731,
      "link": null,
      "locked": false,
      "text": "A payment provider or bank only\naccepts calls from IPs you\nregister (allowlist). All traffic\nleaves through one NAT gateway\n/ egress gateway with an\nElastic IP.",
      "fontSize": 15,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "A payment provider or bank only\naccepts calls from IPs you\nregister (allowlist). All traffic\nleaves through one NAT gateway\n/ egress gateway with an\nElastic IP.",
      "autoResize": true,
      "lineHeight": 1.25
    },
