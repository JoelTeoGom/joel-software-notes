      "isDeleted": false,
      "boundElements": null,
      "updated": 1792703819731,
      "link": null,
      "locked": false,
      "text": "Instances without public IPs\nstill need to pull packages or\ncall APIs: they go out through\na NAT gateway (out only;\nnobody can connect in).",
      "fontSize": 15,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Instances without public IPs\nstill need to pull packages or\ncall APIs: they go out through\na NAT gateway (out only;\nnobody can connect in).",
      "autoResize": true,
      "lineHeight": 1.25
    },
