      "boundElements": null,
      "updated": 1792703819731,
      "link": null,
      "locked": false,
      "text": "by default everything can go out; these are the reasons to stop that",
      "fontSize": 20,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "by default everything can go out; these are the reasons to stop that",
