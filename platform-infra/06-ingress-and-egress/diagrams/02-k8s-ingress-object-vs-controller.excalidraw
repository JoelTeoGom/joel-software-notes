      "seed": 656378043,
      "version": 2,
      "versionNonce": 2135823637,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792703819469,
      "link": null,
      "locked": false,
      "text": "apiVersion: networking.k8s.io/v1\nkind: Ingress\nspec:\n  ingressClassName: nginx\n  rules:\n  - host: acme.example.com\n    http:\n      paths:\n      - path: /\n        pathType: Prefix\n        backend:\n          service: {name: web, port: {number: 80}}",
      "fontSize": 14,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "apiVersion: networking.k8s.io/v1\nkind: Ingress\nspec:\n  ingressClassName: nginx\n  rules:\n  - host: acme.example.com\n    http:\n      paths:\n      - path: /\n        pathType: Prefix\n        backend:\n          service: {name: web, port: {number: 80}}",
      "autoResize": true,
      "lineHeight": 1.2
