      "updated": 1792703819469,
      "link": null,
      "locked": false,
      "text": "Without a controller installed, an Ingress object does nothing.\nThe controller IS the L7 reverse proxy.",
      "fontSize": 15,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Without a controller installed, an Ingress object does nothing.\nThe controller IS the L7 reverse proxy.",
      "autoResize": true,
      "lineHeight": 1.25
