      "isDeleted": false,
      "boundElements": null,
      "updated": 1792703819613,
      "link": null,
      "locked": false,
      "text": "A service that reads Host,\nlooks up the target and\nforwards. Full control, but\nTLS, timeouts, pooling,\nretries and metrics are\nall yours to get right.",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "A service that reads Host,\nlooks up the target and\nforwards. Full control, but\nTLS, timeouts, pooling,\nretries and metrics are\nall yours to get right.",
      "autoResize": true,
      "lineHeight": 1.25
    },
