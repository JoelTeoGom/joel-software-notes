      "boundElements": null,
      "updated": 1792703819613,
      "link": null,
      "locked": false,
      "text": "func handler(w http.ResponseWriter, r *http.Request) {\n    tenant := strings.Split(r.Host, \".\")[0]   // \"acme\"\n    target := tcs.Lookup(tenant, r.URL.Path)  // \"http://jira-shard9...\"\n    u, _ := url.Parse(target)\n    httputil.NewSingleHostReverseProxy(u).ServeHTTP(w, r)\n}",
      "fontSize": 14,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "func handler(w http.ResponseWriter, r *http.Request) {\n    tenant := strings.Split(r.Host, \".\")[0]   // \"acme\"\n    target := tcs.Lookup(tenant, r.URL.Path)  // \"http://jira-shard9...\"\n    u, _ := url.Parse(target)\n    httputil.NewSingleHostReverseProxy(u).ServeHTTP(w, r)\n}",
      "autoResize": true,
      "lineHeight": 1.2
    },
