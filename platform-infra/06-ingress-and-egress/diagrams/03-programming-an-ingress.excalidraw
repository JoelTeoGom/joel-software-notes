      "updated": 1792703819613,
      "link": null,
      "locked": false,
      "text": "1. Off-the-shelf, static rules",
      "fontSize": 19,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. Off-the-shelf, static rules",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "ie3-5",
      "type": "text",
      "x": 64,
      "y": 215,
      "width": 222.89646911621094,
      "height": 160,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
