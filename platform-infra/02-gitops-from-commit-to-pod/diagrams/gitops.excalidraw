      "updated": 1792703352704,
      "link": null,
      "locked": false,
      "text": "lab-manifests/\n  apps/                         base YAML per service\n    email-service/base/\n      deployment.yaml  cronjob.yaml\n      configmap.yaml   externalsecret.yaml\n      migrate-job.yaml kustomization.yaml\n    gateway/base/...\n  envs/                         what changes per env\n    dev/\n      email-service/kustomization.yaml  ns + tag\n      gateway/kustomization.yaml\n    prod/\n      email-service/kustomization.yaml  ns + tag\n  platform/                     cluster-level stuff\n    argocd/applications/        Argo CD Applications\n    namespaces/  rbac/  external-secrets/",
      "fontSize": 15,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "lab-manifests/\n  apps/                         base YAML per service\n    email-service/base/\n      deployment.yaml  cronjob.yaml\n      configmap.yaml   externalsecret.yaml\n      migrate-job.yaml kustomization.yaml\n    gateway/base/...\n  envs/                         what changes per env\n    dev/\n      email-service/kustomization.yaml  ns + tag\n      gateway/kustomization.yaml\n    prod/\n      email-service/kustomization.yaml  ns + tag\n  platform/                     cluster-level stuff\n    argocd/applications/        Argo CD Applications\n    namespaces/  rbac/  external-secrets/",
      "autoResize": true,
      "lineHeight": 1.2
