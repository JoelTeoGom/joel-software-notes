    },
    {
      "id": "05-how-argo-cd-sees-changes:go5-17",
      "type": "text",
      "x": 22,
      "y": 4882.75,
      "width": 398.11285400390625,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b2L",
      "roundness": null,
      "seed": 1427118583,
      "version": 2,
      "versionNonce": 1347906457,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792703352704,
      "link": null,
      "locked": false,
      "text": "- Polling: re-checks the repo every 3 min (default).\n- Webhook: Git POSTs to argocd/api/webhook\n  (signed with a shared secret). It's only a\n  'go look' ping: no YAML, no credentials inside.\n- Homelab: polling only, nothing exposed.",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- Polling: re-checks the repo every 3 min (default).\n- Webhook: Git POSTs to argocd/api/webhook\n  (signed with a shared secret). It's only a\n  'go look' ping: no YAML, no credentials inside.\n- Homelab: polling only, nothing exposed.",
      "autoResize": true,
      "lineHeight": 1.25
    },
