      "text": "1 commit or 10 piled-up commits = the same result: only the final state matters.",
      "fontSize": 18,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1 commit or 10 piled-up commits = the same result: only the final state matters.",
