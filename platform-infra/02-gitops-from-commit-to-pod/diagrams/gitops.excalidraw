    },
    {
      "id": "01-push-vs-pull:go1-36",
      "type": "text",
      "x": 542,
      "y": 746,
      "width": 370.7047119140625,
      "height": 80,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aZ",
      "roundness": null,
      "seed": 296826167,
      "version": 2,
      "versionNonce": 384195673,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792703352704,
      "link": null,
      "locked": false,
      "text": "- Different permissions: few people can\n  change prod, everyone can change code.\n- One snapshot of what runs where, per env.\n- A deploy = a commit; a rollback = git revert.",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- Different permissions: few people can\n  change prod, everyone can change code.\n- One snapshot of what runs where, per env.\n- A deploy = a commit; a rollback = git revert.",
      "autoResize": true,
      "lineHeight": 1.25
    },
