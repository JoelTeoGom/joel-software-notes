      "versionNonce": 8416921,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792703352704,
      "link": null,
      "locked": false,
      "text": "Why pull wins",
      "fontSize": 17,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Why pull wins",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "01-push-vs-pull:go1-33",
      "type": "text",
      "x": 22,
      "y": 746,
      "width": 392.6407775878906,
      "height": 120,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aW",
      "roundness": null,
      "seed": 1174013945,
      "version": 2,
      "versionNonce": 418784119,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792703352704,
      "link": null,
      "locked": false,
      "text": "1. No cluster credentials in CI:\n   a compromised pipeline can't touch the cluster.\n2. No drift: manual changes get reverted.\n   Git is the source of truth.\n3. Only outbound connections from the cluster\n   (agent -> Git, nodes -> registry).",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. No cluster credentials in CI:\n   a compromised pipeline can't touch the cluster.\n2. No drift: manual changes get reverted.\n   Git is the source of truth.\n3. Only outbound connections from the cluster\n   (agent -> Git, nodes -> registry).",
      "autoResize": true,
      "lineHeight": 1.25
    },
