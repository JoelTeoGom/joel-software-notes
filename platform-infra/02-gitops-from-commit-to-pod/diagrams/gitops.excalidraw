      "locked": false,
      "text": "Why a separate manifest repo",
      "fontSize": 17,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Why a separate manifest repo",
      "autoResize": true,
