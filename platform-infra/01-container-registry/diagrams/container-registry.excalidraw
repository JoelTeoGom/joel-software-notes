      "isDeleted": false,
      "boundElements": null,
      "updated": 1792703100782,
      "link": null,
      "locked": false,
      "text": "Every tag means exactly one build.\nThe image tag in the manifest repo changes\non every release, so Git is the history of\nwhat ran where, and rollback = git revert.",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Every tag means exactly one build.\nThe image tag in the manifest repo changes\non every release, so Git is the history of\nwhat ran where, and rollback = git revert.",
      "autoResize": true,
      "lineHeight": 1.25
    },
