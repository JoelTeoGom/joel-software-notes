      "isDeleted": false,
      "boundElements": null,
      "updated": 1792703100782,
      "link": null,
      "locked": false,
      "text": "Plain HTTPS calls: one GET for the manifest, one GET per\nmissing blob. Each blob is verified against its sha256,\nso a corrupted or tampered layer is rejected.",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Plain HTTPS calls: one GET for the manifest, one GET per\nmissing blob. Each blob is verified against its sha256,\nso a corrupted or tampered layer is rejected.",
      "autoResize": true,
      "lineHeight": 1.25
    },
