      "versionNonce": 437839611,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792703100782,
      "link": null,
      "locked": false,
      "text": "docker login / a token for CI.  In Kubernetes: imagePullSecrets\non the pod, or (ECR) the node's IAM role. A private registry\nwithout credentials is an ImagePullBackOff.",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "docker login / a token for CI.  In Kubernetes: imagePullSecrets\non the pod, or (ECR) the node's IAM role. A private registry\nwithout credentials is an ImagePullBackOff.",
      "autoResize": true,
      "lineHeight": 1.25
    },
