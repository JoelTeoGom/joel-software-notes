      "isDeleted": false,
      "boundElements": null,
      "updated": 1792703100782,
      "link": null,
      "locked": false,
      "text": "Digest = the content's hash",
      "fontSize": 17,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Digest = the content's hash",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "01-what-a-registry-stores:reg1-36",
      "type": "text",
      "x": 482,
      "y": 756,
      "width": 293.4566345214844,
      "height": 60,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aZ",
      "roundness": null,
      "seed": 1059395733,
      "version": 2,
      "versionNonce": 1696487765,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792703100782,
      "link": null,
      "locked": false,
      "text": "Like a commit hash: sha256 of the\nmanifest. Change one byte and it's a\ndifferent digest. Can't be moved.",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Like a commit hash: sha256 of the\nmanifest. Change one byte and it's a\ndifferent digest. Can't be moved.",
      "autoResize": true,
      "lineHeight": 1.25
    },
