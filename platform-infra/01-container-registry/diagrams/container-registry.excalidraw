    },
    {
      "id": "01-what-a-registry-stores:reg1-33",
      "type": "text",
      "x": 22,
      "y": 756,
      "width": 307.0406494140625,
      "height": 60,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aW",
      "roundness": null,
      "seed": 2012359163,
      "version": 2,
      "versionNonce": 923804987,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792703100782,
      "link": null,
      "locked": false,
      "text": "Like a git branch: it points to a\nmanifest and can be moved to another\none ('latest'). Human-friendly.",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Like a git branch: it points to a\nmanifest and can be moved to another\none ('latest'). Human-friendly.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "01-what-a-registry-stores:reg1-34",
      "type": "rectangle",
      "x": 460,
      "y": 710,
