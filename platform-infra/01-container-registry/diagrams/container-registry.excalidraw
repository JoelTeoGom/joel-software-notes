      "isDeleted": false,
      "boundElements": null,
      "updated": 1792703100782,
      "link": null,
      "locked": false
    },
    {
      "id": "01-what-a-registry-stores:reg1-35",
      "type": "text",
      "x": 482,
      "y": 726,
      "width": 238.88345336914062,
