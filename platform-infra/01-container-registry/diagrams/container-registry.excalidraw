      "versionNonce": 515132187,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792703100782,
      "link": null,
      "locked": false,
      "text": "Two images on the same base share\nthose blobs: stored once, pushed once,\npulled once per node.",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Two images on the same base share\nthose blobs: stored once, pushed once,\npulled once per node.",
      "autoResize": true,
      "lineHeight": 1.25
    },
