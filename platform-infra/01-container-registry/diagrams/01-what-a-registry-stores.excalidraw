      "text": "Like a git branch: it points to a\nmanifest and can be moved to another\none ('latest'). Human-friendly.",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Like a git branch: it points to a\nmanifest and can be moved to another\none ('latest'). Human-friendly.",
      "autoResize": true,
      "lineHeight": 1.25
    },
