      "seed": 958813269,
      "version": 2,
      "versionNonce": 1955520021,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792703130345,
      "link": null,
      "locked": false,
      "text": "Docker Hub     public default, rate-limited pulls\nGHCR           ghcr.io, next to your GitHub repos and Actions\nECR            AWS; nodes pull with their IAM role, no secret in the cluster\nArtifact Reg.  GCP (Cloud Run / GKE pull it natively)\nHarbor         self-hosted, for on-prem or a homelab (+ scanning, replication)",
      "fontSize": 15,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Docker Hub     public default, rate-limited pulls\nGHCR           ghcr.io, next to your GitHub repos and Actions\nECR            AWS; nodes pull with their IAM role, no secret in the cluster\nArtifact Reg.  GCP (Cloud Run / GKE pull it natively)\nHarbor         self-hosted, for on-prem or a homelab (+ scanning, replication)",
      "autoResize": true,
      "lineHeight": 1.2
    },
