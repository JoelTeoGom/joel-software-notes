      "boundElements": null,
      "updated": 1792703130345,
      "link": null,
      "locked": false,
      "text": "Same Deployment, two versions running.\nRollback to 'latest'? Which one?\nThe manifest in Git didn't change, so\nGitOps can't even see the deploy.",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Same Deployment, two versions running.\nRollback to 'latest'? Which one?\nThe manifest in Git didn't change, so\nGitOps can't even see the deploy.",
      "autoResize": true,
      "lineHeight": 1.25
    },
