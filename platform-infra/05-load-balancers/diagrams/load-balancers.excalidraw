    },
    {
      "id": "04-algorithms-and-grpc:lb4-33",
      "type": "text",
      "x": 880,
      "y": 3385,
      "width": 324.51214599609375,
      "height": 112.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0P",
      "roundness": null,
      "seed": 397185872,
      "version": 2,
      "versionNonce": 1802689360,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792703816898,
      "link": null,
      "locked": false,
      "text": "L4 balances connections, not requests:\nevery request of that client lands on\nbackend 1, the others sit idle.\nFix: an L7 proxy that understands HTTP/2\n(Envoy, ALB with gRPC, a service mesh)\nor client-side balancing.",
      "fontSize": 15,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "L4 balances connections, not requests:\nevery request of that client lands on\nbackend 1, the others sit idle.\nFix: an L7 proxy that understands HTTP/2\n(Envoy, ALB with gRPC, a service mesh)\nor client-side balancing.",
      "autoResize": true,
      "lineHeight": 1.25
    },
