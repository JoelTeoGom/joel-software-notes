    {
      "id": "03-lbs-scale-too:lb3-14",
      "type": "text",
      "x": 720,
      "y": 2185,
      "width": 398.59271240234375,
      "height": 80,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
