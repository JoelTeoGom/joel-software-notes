    {
      "id": "01-what-each-lb-sees:lb1-13",
      "type": "text",
      "x": 20,
      "y": 506,
      "width": 795.24560546875,
      "height": 37.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
