    {
      "id": "02-aws-elb-family:lb2-13",
      "type": "text",
      "x": 22,
      "y": 1581,
      "width": 244.4934539794922,
      "height": 21.25,
      "angle": 0,
      "strokeColor": "#e67700",
      "backgroundColor": "transparent",
