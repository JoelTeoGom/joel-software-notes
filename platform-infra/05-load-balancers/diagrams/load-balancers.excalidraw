      "text": "ONE HTTP/2 connection,\nthousands of requests inside",
      "fontSize": 15,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "ONE HTTP/2 connection,\nthousands of requests inside",
