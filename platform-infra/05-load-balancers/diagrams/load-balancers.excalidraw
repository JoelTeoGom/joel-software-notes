      "isDeleted": false,
      "boundElements": null,
      "updated": 1792703816898,
      "link": null,
      "locked": false,
      "text": "previous generation\n\nL4 (TCP) or basic L7 (HTTP)\none set of instances per LB\n\nalgorithm: round robin (TCP),\nleast outstanding requests\n(HTTP/HTTPS)\n\nwhat Atlassian called 'ELB'",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "previous generation\n\nL4 (TCP) or basic L7 (HTTP)\none set of instances per LB\n\nalgorithm: round robin (TCP),\nleast outstanding requests\n(HTTP/HTTPS)\n\nwhat Atlassian called 'ELB'",
      "autoResize": true,
      "lineHeight": 1.25
    },
