    },
    {
      "id": "03-lbs-scale-too:lb3-18",
      "type": "text",
      "x": 22,
      "y": 2466,
      "width": 389.728759765625,
      "height": 60,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "ap",
      "roundness": null,
      "seed": 106088272,
      "version": 2,
      "versionNonce": 1662717776,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792703816898,
      "link": null,
      "locked": false,
      "text": "One long-lived ALB that deployments don't touch.\nA deploy only changes the instances behind it\n(target group), so the LB stays warm.",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "One long-lived ALB that deployments don't touch.\nA deploy only changes the instances behind it\n(target group), so the LB stays warm.",
      "autoResize": true,
      "lineHeight": 1.25
    },
