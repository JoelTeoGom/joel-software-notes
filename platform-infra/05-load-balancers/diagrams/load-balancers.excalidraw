      "roundness": null,
      "seed": 1959621040,
      "version": 2,
      "versionNonce": 1030990256,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792703816898,
      "link": null,
      "locked": false,
      "text": "None of them is 'one machine'",
      "fontSize": 17,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "None of them is 'one machine'",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "02-aws-elb-family:lb2-14",
      "type": "text",
      "x": 22,
      "y": 1611,
      "width": 1078.177978515625,
      "height": 40,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aX",
      "roundness": null,
      "seed": 507494736,
      "version": 2,
      "versionNonce": 1144588624,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792703816898,
      "link": null,
      "locked": false,
      "text": "Each one is a fleet of AWS-managed nodes behind a DNS name (my-lb-123.elb.amazonaws.com). Only the NLB gives you fixed IPs;\nwith the ALB and CLB the IPs change as AWS scales the fleet, so you always point DNS at the name (alias record), never at an IP.",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Each one is a fleet of AWS-managed nodes behind a DNS name (my-lb-123.elb.amazonaws.com). Only the NLB gives you fixed IPs;\nwith the ALB and CLB the IPs change as AWS scales the fleet, so you always point DNS at the name (alias record), never at an IP.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
