      "link": null,
      "locked": false,
      "text": "The fix",
      "fontSize": 17,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The fix",
      "autoResize": true,
