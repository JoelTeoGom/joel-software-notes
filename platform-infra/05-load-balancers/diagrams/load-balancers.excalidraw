    {
      "id": "01-what-each-lb-sees:lb1-10",
      "type": "text",
      "x": 20,
      "y": 336,
      "width": 306.01708984375,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
