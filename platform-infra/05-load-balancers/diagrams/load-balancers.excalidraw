    },
    {
      "id": "03-lbs-scale-too:lb3-21",
      "type": "text",
      "x": 712,
      "y": 2466,
      "width": 460.3049621582031,
      "height": 60,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "as",
      "roundness": null,
      "seed": 737009584,
      "version": 2,
      "versionNonce": 2145851312,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792703816898,
      "link": null,
      "locked": false,
      "text": "Different algorithm: the CLB sent work to the node with\nthe fewest outstanding requests; the ALB used round\nrobin. p99 went from ~7-10 ms to ~20 ms (next diagram).",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Different algorithm: the CLB sent work to the node with\nthe fewest outstanding requests; the ALB used round\nrobin. p99 went from ~7-10 ms to ~20 ms (next diagram).",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
