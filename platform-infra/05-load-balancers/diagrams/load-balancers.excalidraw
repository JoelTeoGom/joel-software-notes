      "seed": 344319920,
      "version": 2,
      "versionNonce": 1133715376,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792703816898,
      "link": null,
      "locked": false,
      "text": "L4: TCP, UDP, TLS\n\none static IP per AZ\n(you can allowlist it)\nkeeps the client's IP\nmillions of requests/s,\nvery low latency\n\nalgorithm: flow hash\n(one connection -> one target)",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "L4: TCP, UDP, TLS\n\none static IP per AZ\n(you can allowlist it)\nkeeps the client's IP\nmillions of requests/s,\nvery low latency\n\nalgorithm: flow hash\n(one connection -> one target)",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "02-aws-elb-family:lb2-12",
