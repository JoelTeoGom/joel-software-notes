      "isDeleted": false,
      "boundElements": null,
      "updated": 1792703816898,
      "link": null,
      "locked": false,
      "text": "how work is spread decides what happens when one backend is slow, or when connections live forever",
      "fontSize": 20,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "how work is spread decides what happens when one backend is slow, or when connections live forever",
