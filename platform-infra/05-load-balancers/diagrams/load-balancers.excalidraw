      "isDeleted": false,
      "boundElements": null,
      "updated": 1792703816898,
      "link": null,
      "locked": false,
      "text": "Algorithms, and why L4 breaks gRPC",
      "fontSize": 34,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Algorithms, and why L4 breaks gRPC",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "04-algorithms-and-grpc:lb4-2",
      "type": "text",
