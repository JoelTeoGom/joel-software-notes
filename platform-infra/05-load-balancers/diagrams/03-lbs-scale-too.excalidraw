    {
      "id": "lb3-21",
      "type": "text",
      "x": 752,
      "y": 611,
      "width": 460.3049621582031,
      "height": 60,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
