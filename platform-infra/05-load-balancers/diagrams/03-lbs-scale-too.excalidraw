    {
      "id": "lb3-18",
      "type": "text",
      "x": 62,
      "y": 611,
      "width": 389.728759765625,
      "height": 60,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aH",
      "roundness": null,
      "seed": 1611209552,
      "version": 2,
      "versionNonce": 1975494064,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792703816670,
      "link": null,
      "locked": false,
      "text": "One long-lived ALB that deployments don't touch.\nA deploy only changes the instances behind it\n(target group), so the LB stays warm.",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "One long-lived ALB that deployments don't touch.\nA deploy only changes the instances behind it\n(target group), so the LB stays warm.",
      "autoResize": true,
      "lineHeight": 1.25
    },
