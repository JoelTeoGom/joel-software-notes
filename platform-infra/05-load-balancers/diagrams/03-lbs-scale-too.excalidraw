      "index": "aK",
      "roundness": null,
      "seed": 1182354352,
      "version": 2,
      "versionNonce": 596943696,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792703816670,
      "link": null,
      "locked": false,
      "text": "Different algorithm: the CLB sent work to the node with\nthe fewest outstanding requests; the ALB used round\nrobin. p99 went from ~7-10 ms to ~20 ms (next diagram).",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Different algorithm: the CLB sent work to the node with\nthe fewest outstanding requests; the ALB used round\nrobin. p99 went from ~7-10 ms to ~20 ms (next diagram).",
      "autoResize": true,
      "lineHeight": 1.25
    },
