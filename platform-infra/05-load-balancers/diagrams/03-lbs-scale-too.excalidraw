      "isDeleted": false,
      "boundElements": null,
      "updated": 1792703816670,
      "link": null,
      "locked": false,
      "text": "The deploy tool created the whole stack,\nload balancer included, and switched DNS\nto it: all traffic at once -> out of memory\n-> no LB to answer -> 5 min down in 2 US regions.",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The deploy tool created the whole stack,\nload balancer included, and switched DNS\nto it: all traffic at once -> out of memory\n-> no LB to answer -> 5 min down in 2 US regions.",
      "autoResize": true,
      "lineHeight": 1.25
    },
