      "boundElements": null,
      "updated": 1792703816432,
      "link": null,
      "locked": false,
      "text": "terminates TLS, parses HTTP, routes each REQUEST by host, path, headers.\nCan retry, add headers (X-Forwarded-For), do sticky sessions.   AWS ALB, nginx, Envoy, Ingress controllers",
      "fontSize": 15,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "terminates TLS, parses HTTP, routes each REQUEST by host, path, headers.\nCan retry, add headers (X-Forwarded-For), do sticky sessions.   AWS ALB, nginx, Envoy, Ingress controllers",
      "autoResize": true,
      "lineHeight": 1.25
    },
