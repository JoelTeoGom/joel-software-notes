    },
    {
      "id": "lb2-14",
      "type": "text",
      "x": 62,
      "y": 581,
      "width": 1078.177978515625,
      "height": 40,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aD",
      "roundness": null,
      "seed": 814857040,
      "version": 2,
      "versionNonce": 373593424,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792703816570,
      "link": null,
      "locked": false,
      "text": "Each one is a fleet of AWS-managed nodes behind a DNS name (my-lb-123.elb.amazonaws.com). Only the NLB gives you fixed IPs;\nwith the ALB and CLB the IPs change as AWS scales the fleet, so you always point DNS at the name (alias record), never at an IP.",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Each one is a fleet of AWS-managed nodes behind a DNS name (my-lb-123.elb.amazonaws.com). Only the NLB gives you fixed IPs;\nwith the ALB and CLB the IPs change as AWS scales the fleet, so you always point DNS at the name (alias record), never at an IP.",
      "autoResize": true,
      "lineHeight": 1.25
    }
  ],
