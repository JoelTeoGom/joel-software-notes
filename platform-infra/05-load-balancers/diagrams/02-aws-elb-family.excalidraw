      "updated": 1792703816570,
      "link": null,
      "locked": false,
      "text": "None of them is 'one machine'",
      "fontSize": 17,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "None of them is 'one machine'",
      "autoResize": true,
