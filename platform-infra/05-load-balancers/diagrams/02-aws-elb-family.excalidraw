      "isDeleted": false,
      "boundElements": null,
      "updated": 1792703816570,
      "link": null,
      "locked": false,
      "text": "L7: HTTP, HTTPS, gRPC, WebSocket\n\nrules by host, path, header,\nquery -> target groups\n(instances, IPs, Lambdas)\n\nalgorithm: round robin by default,\nleast outstanding requests\noptional",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "L7: HTTP, HTTPS, gRPC, WebSocket\n\nrules by host, path, header,\nquery -> target groups\n(instances, IPs, Lambdas)\n\nalgorithm: round robin by default,\nleast outstanding requests\noptional",
      "autoResize": true,
      "lineHeight": 1.25
    },
