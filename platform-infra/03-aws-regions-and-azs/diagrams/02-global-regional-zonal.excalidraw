    },
    {
      "id": "rg2-32",
      "type": "text",
      "x": 62,
      "y": 766,
      "width": 465.16888427734375,
      "height": 80,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aV",
      "roundness": null,
      "seed": 1068730616,
      "version": 2,
      "versionNonce": 46268808,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792703571941,
      "link": null,
      "locked": false,
      "text": "- Zonal things die with their AZ: run 2+ copies in 2+ AZs.\n- Regional services already survive an AZ failure.\n- Multi-region is a choice you pay for: latency for\n  far-away users, region outages, data residency.",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- Zonal things die with their AZ: run 2+ copies in 2+ AZs.\n- Regional services already survive an AZ failure.\n- Multi-region is a choice you pay for: latency for\n  far-away users, region outages, data residency.",
      "autoResize": true,
      "lineHeight": 1.25
    },
