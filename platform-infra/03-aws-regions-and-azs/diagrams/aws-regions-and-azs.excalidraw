      "isDeleted": false,
      "boundElements": null,
      "updated": 1792703572039,
      "link": null,
      "locked": false,
      "text": "AWS has a fixed list (eu-west-1,\nus-east-1, ap-southeast-2, ...).\nYou choose where to deploy.",
