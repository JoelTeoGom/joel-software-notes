      "isDeleted": false,
      "boundElements": null,
      "updated": 1792703572039,
      "link": null,
      "locked": false,
      "text": "A fire or power cut takes out one AZ,\nnot the region. Spread instances over\n2-3 AZs and you survive it.",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "A fire or power cut takes out one AZ,\nnot the region. Spread instances over\n2-3 AZs and you survive it.",
