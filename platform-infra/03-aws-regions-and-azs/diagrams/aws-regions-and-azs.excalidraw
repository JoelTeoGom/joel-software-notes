      "seed": 93251064,
      "version": 2,
      "versionNonce": 230266104,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792703572039,
      "link": null,
      "locked": false,
      "text": "- Traffic between AZs and between regions costs money.\n- Between regions: ~70-150 ms and eventual\n  consistency (each region has its own copy).\n- Atlassian replicates its tenant directory to every region.",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- Traffic between AZs and between regions costs money.\n- Between regions: ~70-150 ms and eventual\n  consistency (each region has its own copy).\n- Atlassian replicates its tenant directory to every region.",
      "autoResize": true,
      "lineHeight": 1.25
    },
