      "boundElements": null,
      "updated": 1792703568242,
      "link": null,
      "locked": false,
      "text": "GET https://acme.atlassian.net/browse/PROJ-123        Acme's tenant lives in eu-west-1, shard 9",
      "fontSize": 15,
      "fontFamily": 3,
      "textAlign": "center",
      "verticalAlign": "middle",
