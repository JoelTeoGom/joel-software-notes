    {
      "id": "pr1-42",
      "type": "text",
      "x": 62,
      "y": 768,
      "width": 433.53314208984375,
      "height": 21.25,
      "angle": 0,
      "strokeColor": "#e8590c",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
