      "link": null,
      "locked": false,
      "text": "Caching and TTL",
      "fontSize": 17,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Caching and TTL",
      "autoResize": true,
