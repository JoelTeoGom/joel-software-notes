      "isDeleted": false,
      "boundElements": null,
      "updated": 1792703568405,
      "link": null,
      "locked": false,
      "text": "What the DNS knows about you",
      "fontSize": 17,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "What the DNS knows about you",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "pr2-29",
      "type": "text",
      "x": 62,
      "y": 526,
      "width": 334.36871337890625,
      "height": 80,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aS",
      "roundness": null,
      "seed": 1175461682,
      "version": 2,
      "versionNonce": 558381870,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792703568405,
      "link": null,
      "locked": false,
      "text": "Only where your resolver is (or the\nclient subnet it forwards). It picks the\nregion closest to YOU, not to the tenant:\nit has no idea where Acme lives.",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Only where your resolver is (or the\nclient subnet it forwards). It picks the\nregion closest to YOU, not to the tenant:\nit has no idea where Acme lives.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
