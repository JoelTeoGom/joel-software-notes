    {
      "id": "pr4-53",
      "type": "text",
      "x": 62,
      "y": 756,
      "width": 379.0481872558594,
      "height": 21.25,
      "angle": 0,
      "strokeColor": "#e67700",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aq",
      "roundness": null,
      "seed": 777471602,
      "version": 2,
      "versionNonce": 468230318,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792703568690,
      "link": null,
      "locked": false,
      "text": "Why not let any Jira node serve any tenant?",
      "fontSize": 17,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Why not let any Jira node serve any tenant?",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "pr4-54",
      "type": "text",
      "x": 62,
      "y": 786,
      "width": 549.8731079101562,
      "height": 60,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "ar",
      "roundness": null,
      "seed": 2054951342,
      "version": 2,
      "versionNonce": 1827768626,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792703568690,
      "link": null,
      "locked": false,
      "text": "A Jira request makes dozens of SQL queries. From the US to an EU\ndatabase that's ~80 ms EACH. So you route once, early, and run\nthe whole request next to the data.",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "A Jira request makes dozens of SQL queries. From the US to an EU\ndatabase that's ~80 ms EACH. So you route once, early, and run\nthe whole request next to the data.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "pr4-55",
      "type": "rectangle",
      "x": 730,
      "y": 740,
      "width": 650,
      "height": 150,
      "angle": 0,
      "strokeColor": "#e67700",
      "backgroundColor": "#fff9db",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "as",
      "roundness": {
        "type": 3
      },
      "seed": 139044914,
      "version": 2,
      "versionNonce": 1001151214,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792703568690,
      "link": null,
      "locked": false
    },
    {
      "id": "pr4-56",
      "type": "text",
      "x": 752,
      "y": 756,
      "width": 114.8177490234375,
      "height": 21.25,
      "angle": 0,
      "strokeColor": "#e67700",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "at",
      "roundness": null,
      "seed": 950643694,
      "version": 2,
      "versionNonce": 1745720050,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792703568690,
      "link": null,
      "locked": false,
      "text": "The way back",
      "fontSize": 17,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The way back",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "pr4-57",
      "type": "text",
      "x": 752,
      "y": 786,
      "width": 571.649169921875,
      "height": 60,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "au",
      "roundness": null,
      "seed": 1091162610,
      "version": 2,
      "versionNonce": 394186030,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792703568690,
      "link": null,
      "locked": false,
      "text": "The response goes back over the same connections: Jira -> shard LB ->\ningress -> ALB -> browser. No new lookups. TCP is bidirectional,\nso there is no 'return route' to resolve.",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The response goes back over the same connections: Jira -> shard LB ->\ningress -> ALB -> browser. No new lookups. TCP is bidirectional,\nso there is no 'return route' to resolve.",
      "autoResize": true,
      "lineHeight": 1.25
    },
