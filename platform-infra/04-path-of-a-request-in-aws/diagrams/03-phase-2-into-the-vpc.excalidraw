      "index": "au",
      "roundness": null,
      "seed": 2134797870,
      "version": 2,
      "versionNonce": 977758062,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792703568523,
      "link": null,
      "locked": false,
      "text": "Who sees the Host header?",
      "fontSize": 17,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Who sees the Host header?",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "pr3-58",
      "type": "text",
      "x": 742,
      "y": 786,
      "width": 533.5370483398438,
      "height": 60,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "av",
      "roundness": null,
      "seed": 1825133490,
      "version": 2,
      "versionNonce": 2111278706,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792703568523,
      "link": null,
      "locked": false,
      "text": "Only an L7 component. The ALB keeps Host: acme.atlassian.net\nwhen it forwards, so the ingress can read the tenant from it.\n(It could even route by host itself; Atlassian's routing is dynamic.)",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Only an L7 component. The ALB keeps Host: acme.atlassian.net\nwhen it forwards, so the ingress can read the tenant from it.\n(It could even route by host itself; Atlassian's routing is dynamic.)",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "sfIcAYGLPfw3UVXQJUdWZ",
      "type": "text",
      "x": 373.2513427734375,
      "y": 317.5,
      "width": 183.497314453125,
      "height": 105,
      "angle": 0,
