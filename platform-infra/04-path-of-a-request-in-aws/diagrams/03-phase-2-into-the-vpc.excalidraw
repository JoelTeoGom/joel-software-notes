      "updated": 1792703568523,
      "link": null,
      "locked": false,
      "text": "Internet Gateway vs load balancer",
      "fontSize": 17,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Internet Gateway vs load balancer",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "pr3-55",
      "type": "text",
      "x": 62,
      "y": 786,
      "width": 540.7530517578125,
      "height": 60,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "as",
      "roundness": null,
      "seed": 1124867054,
      "version": 2,
      "versionNonce": 269172014,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792703568523,
      "link": null,
      "locked": false,
      "text": "The IGW has no IP you call, no TLS, no logic: it connects the VPC\nto the internet (route 0.0.0.0/0 -> igw). The request is addressed\nto the load balancer; the IGW is on the way, like your home router.",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The IGW has no IP you call, no TLS, no logic: it connects the VPC\nto the internet (route 0.0.0.0/0 -> igw). The request is addressed\nto the load balancer; the IGW is on the way, like your home router.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "pr3-56",
      "type": "rectangle",
      "x": 720,
      "y": 740,
