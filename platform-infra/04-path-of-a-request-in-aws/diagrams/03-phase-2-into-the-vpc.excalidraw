      "isDeleted": false,
      "boundElements": null,
      "updated": 1792703568526,
      "link": null,
      "locked": false,
      "text": "ALB  :443\n\nTLS ends here\ncert *.atlassian.net (ACM)\nsecurity group: 443 from\nthe internet",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "center",
