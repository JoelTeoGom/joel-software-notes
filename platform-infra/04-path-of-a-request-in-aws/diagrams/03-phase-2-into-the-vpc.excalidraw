    {
      "id": "pr3-57",
      "type": "text",
      "x": 742,
      "y": 756,
      "width": 229.72048950195312,
      "height": 21.25,
      "angle": 0,
      "strokeColor": "#e67700",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
