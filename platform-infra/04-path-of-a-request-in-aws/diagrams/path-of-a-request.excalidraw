      "updated": 1792703568917,
      "link": null,
      "locked": false,
      "text": "Two connections, one request",
      "fontSize": 17,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Two connections, one request",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "03-phase-2-into-the-vpc:pr3-52",
      "type": "text",
      "x": 752,
      "y": 2412,
      "width": 360.9375,
      "height": 100.80000000000001,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b15",
      "roundness": null,
      "seed": 1292080110,
      "version": 2,
      "versionNonce": 2009190514,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792703568917,
      "link": null,
      "locked": false,
      "text": "connection 1: browser -> ALB      (HTTPS)\nconnection 2: ALB -> ingress EC2   (new TCP)\n\nThe ALB picks a healthy instance and\nFORWARDS the request. It is not a redirect:\nthe browser never sees the ingress.",
      "fontSize": 14,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "connection 1: browser -> ALB      (HTTPS)\nconnection 2: ALB -> ingress EC2   (new TCP)\n\nThe ALB picks a healthy instance and\nFORWARDS the request. It is not a redirect:\nthe browser never sees the ingress.",
      "autoResize": true,
      "lineHeight": 1.2
    },
