      "isDeleted": false,
      "boundElements": null,
      "updated": 1792703568917,
      "link": null,
      "locked": false,
      "text": "The response goes back over the same connections: Jira -> shard LB ->\ningress -> ALB -> browser. No new lookups. TCP is bidirectional,\nso there is no 'return route' to resolve.",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The response goes back over the same connections: Jira -> shard LB ->\ningress -> ALB -> browser. No new lookups. TCP is bidirectional,\nso there is no 'return route' to resolve.",
      "autoResize": true,
      "lineHeight": 1.25
    },
