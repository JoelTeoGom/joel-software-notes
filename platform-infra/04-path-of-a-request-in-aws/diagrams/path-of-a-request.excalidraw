      "isDeleted": false,
      "boundElements": null,
      "updated": 1792703568915,
      "link": null,
      "locked": false,
      "text": "One record serves every tenant:\nacme, globex, initech... all resolve to\nthe same load balancers. Nothing to\ncreate when a customer signs up.",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "One record serves every tenant:\nacme, globex, initech... all resolve to\nthe same load balancers. Nothing to\ncreate when a customer signs up.",
      "autoResize": true,
      "lineHeight": 1.25
    },
