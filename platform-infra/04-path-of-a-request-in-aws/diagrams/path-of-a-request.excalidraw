      "seed": 2136326126,
      "version": 2,
      "versionNonce": 492921970,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792703568917,
      "link": null,
      "locked": false,
      "text": "The PROXY makes the second request\nand returns the answer. The client\nnever knows the backend exists.",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The PROXY makes the second request\nand returns the answer. The client\nnever knows the backend exists.",
      "autoResize": true,
      "lineHeight": 1.25
    },
