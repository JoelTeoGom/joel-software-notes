    },
    {
      "id": "03-phase-2-into-the-vpc:pr3-57",
      "type": "text",
      "x": 712,
      "y": 2686,
      "width": 229.72048950195312,
      "height": 21.25,
      "angle": 0,
      "strokeColor": "#e67700",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
