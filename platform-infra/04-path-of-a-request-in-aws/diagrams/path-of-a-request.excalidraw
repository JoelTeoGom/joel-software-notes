      "boundElements": null,
      "updated": 1792703568917,
      "link": null,
      "locked": false,
      "text": "1 request ->   2 LB opens its own connection ->\n3 response <-  4 LB returns it <-",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1 request ->   2 LB opens its own connection ->\n3 response <-  4 LB returns it <-",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "05-redirect-forward-node-process:pr5-33",
      "type": "text",
      "x": 730,
      "y": 4500,
      "width": 302.96063232421875,
      "height": 60,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
