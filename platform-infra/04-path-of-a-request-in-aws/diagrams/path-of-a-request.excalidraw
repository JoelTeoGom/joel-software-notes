      "boundElements": null,
      "updated": 1792703568915,
      "link": null,
      "locked": false,
      "text": "Only where your resolver is (or the\nclient subnet it forwards). It picks the\nregion closest to YOU, not to the tenant:\nit has no idea where Acme lives.",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Only where your resolver is (or the\nclient subnet it forwards). It picks the\nregion closest to YOU, not to the tenant:\nit has no idea where Acme lives.",
      "autoResize": true,
      "lineHeight": 1.25
    },
