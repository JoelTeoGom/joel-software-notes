      "link": null,
      "locked": false,
      "text": "Why not let any Jira node serve any tenant?",
      "fontSize": 17,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Why not let any Jira node serve any tenant?",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "04-phase-3-to-the-data:pr4-54",
      "type": "text",
      "x": 22,
      "y": 3776,
      "width": 549.8731079101562,
      "height": 60,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b23",
      "roundness": null,
      "seed": 224190318,
      "version": 2,
      "versionNonce": 185244914,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792703568917,
      "link": null,
      "locked": false,
      "text": "A Jira request makes dozens of SQL queries. From the US to an EU\ndatabase that's ~80 ms EACH. So you route once, early, and run\nthe whole request next to the data.",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "A Jira request makes dozens of SQL queries. From the US to an EU\ndatabase that's ~80 ms EACH. So you route once, early, and run\nthe whole request next to the data.",
      "autoResize": true,
      "lineHeight": 1.25
    },
