      "isDeleted": false,
      "boundElements": null,
      "updated": 1792703568915,
      "link": null,
      "locked": false,
      "text": "Browser, OS and resolver cache the\nanswer for the TTL. A short TTL lets\nRoute 53 move users away from a\nregion that fails its health checks.",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Browser, OS and resolver cache the\nanswer for the TTL. A short TTL lets\nRoute 53 move users away from a\nregion that fails its health checks.",
      "autoResize": true,
      "lineHeight": 1.25
    },
