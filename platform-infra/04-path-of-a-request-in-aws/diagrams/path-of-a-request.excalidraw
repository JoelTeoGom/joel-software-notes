      "updated": 1792703568917,
      "link": null,
      "locked": false,
      "text": "Internet Gateway vs load balancer",
      "fontSize": 17,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Internet Gateway vs load balancer",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "03-phase-2-into-the-vpc:pr3-55",
      "type": "text",
      "x": 32,
      "y": 2716,
      "width": 540.7530517578125,
      "height": 60,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b18",
      "roundness": null,
      "seed": 1097096114,
      "version": 2,
      "versionNonce": 951189998,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792703568917,
      "link": null,
      "locked": false,
      "text": "The IGW has no IP you call, no TLS, no logic: it connects the VPC\nto the internet (route 0.0.0.0/0 -> igw). The request is addressed\nto the load balancer; the IGW is on the way, like your home router.",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The IGW has no IP you call, no TLS, no logic: it connects the VPC\nto the internet (route 0.0.0.0/0 -> igw). The request is addressed\nto the load balancer; the IGW is on the way, like your home router.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
