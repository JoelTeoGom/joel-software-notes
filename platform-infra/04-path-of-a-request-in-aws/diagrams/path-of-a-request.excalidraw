      "index": "b1A",
      "roundness": null,
      "seed": 2072122738,
      "version": 2,
      "versionNonce": 1396151342,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792703568917,
      "link": null,
      "locked": false,
      "text": "Who sees the Host header?",
      "fontSize": 17,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Who sees the Host header?",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "03-phase-2-into-the-vpc:pr3-58",
      "type": "text",
      "x": 712,
      "y": 2716,
      "width": 533.5370483398438,
      "height": 60,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1B",
      "roundness": null,
      "seed": 90813102,
      "version": 2,
      "versionNonce": 1289588146,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792703568917,
      "link": null,
      "locked": false,
      "text": "Only an L7 component. The ALB keeps Host: acme.atlassian.net\nwhen it forwards, so the ingress can read the tenant from it.\n(It could even route by host itself; Atlassian's routing is dynamic.)",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Only an L7 component. The ALB keeps Host: acme.atlassian.net\nwhen it forwards, so the ingress can read the tenant from it.\n(It could even route by host itself; Atlassian's routing is dynamic.)",
      "autoResize": true,
      "lineHeight": 1.25
    },
