      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "LB -> node IP:30080 (NodePort)\nkube-proxy rules (iptables/IPVS)\n-> pod IP:8080\nthe pod may be on ANOTHER node\n(an extra hop)",
      "autoResize": true,
      "lineHeight": 1.25
    },
