      "locked": false
    },
    {
      "id": "01-what-a-cdn-is:cd1-27",
      "type": "text",
      "x": 712,
      "y": 686,
      "width": 129.64170837402344,
      "height": 21.25,
      "angle": 0,
      "strokeColor": "#e67700",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
