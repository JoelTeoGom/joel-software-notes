      "seed": 524187067,
      "version": 2,
      "versionNonce": 1768161659,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792703857683,
      "link": null,
      "locked": false,
      "text": "The cache key",
      "fontSize": 17,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The cache key",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "03-what-gets-cached:cd3-8",
      "type": "text",
      "x": 712,
      "y": 2062,
      "width": 426.5625,
      "height": 134.4,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b05",
      "roundness": null,
      "seed": 1381570421,
      "version": 2,
      "versionNonce": 1341335477,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792703857683,
      "link": null,
      "locked": false,
      "text": "cache key = what identifies 'the same response'\n\n  default:  host + path (+ query string, if enabled)\n  add only what changes the response:\n    Accept-Encoding (gzip / br)\n  never the whole cookie or user header:\n    every user becomes a separate entry\n    -> hit ratio ~0",
      "fontSize": 14,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "cache key = what identifies 'the same response'\n\n  default:  host + path (+ query string, if enabled)\n  add only what changes the response:\n    Accept-Encoding (gzip / br)\n  never the whole cookie or user header:\n    every user becomes a separate entry\n    -> hit ratio ~0",
      "autoResize": true,
      "lineHeight": 1.2
    },
    {
      "id": "03-what-gets-cached:cd3-9",
