      "seed": 1645658427,
      "version": 2,
      "versionNonce": 341814523,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792703857683,
      "link": null,
      "locked": false,
      "text": "Not only images",
      "fontSize": 17,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Not only images",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "01-what-a-cdn-is:cd1-28",
      "type": "text",
      "x": 712,
      "y": 716,
      "width": 444.68890380859375,
      "height": 80,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aR",
      "roundness": null,
      "seed": 10306549,
      "version": 2,
      "versionNonce": 611972149,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792703857683,
      "link": null,
      "locked": false,
      "text": "Anything cacheable over HTTP: JS, CSS, fonts, video\nsegments, downloads, even GET API responses. And for\nNON-cacheable traffic it still helps: TLS ends near the\nuser and the edge keeps warm connections to the origin.",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Anything cacheable over HTTP: JS, CSS, fonts, video\nsegments, downloads, even GET API responses. And for\nNON-cacheable traffic it still helps: TLS ends near the\nuser and the edge keeps warm connections to the origin.",
      "autoResize": true,
      "lineHeight": 1.25
    },
