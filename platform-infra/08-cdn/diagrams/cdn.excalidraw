    },
    {
      "id": "02-hit-and-miss:cd2-32",
      "type": "text",
      "x": 22,
      "y": 1592,
      "width": 705.46875,
      "height": 84,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "ax",
      "roundness": null,
      "seed": 1377581557,
      "version": 2,
      "versionNonce": 1852860981,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792703857683,
      "link": null,
      "locked": false,
      "text": "first request :  user -> edge (miss) -> regional cache (miss) -> origin    ~100-200 ms\nnext requests :  user -> edge (hit)                                         ~10 ms\nTTL expires   :  edge revalidates with the origin (If-None-Match / ETag)\n                 304 Not Modified -> keeps serving its copy, no body transferred\ncache hit ratio = hits / all requests.  90%+ for static assets is normal.",
      "fontSize": 14,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "first request :  user -> edge (miss) -> regional cache (miss) -> origin    ~100-200 ms\nnext requests :  user -> edge (hit)                                         ~10 ms\nTTL expires   :  edge revalidates with the origin (If-None-Match / ETag)\n                 304 Not Modified -> keeps serving its copy, no body transferred\ncache hit ratio = hits / all requests.  90%+ for static assets is normal.",
      "autoResize": true,
      "lineHeight": 1.2
    },
    {
      "id": "03-what-gets-cached:cd3-1",
      "type": "text",
      "x": 0,
      "y": 1890,
      "width": 604.552490234375,
      "height": 42.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "ay",
      "roundness": null,
      "seed": 408177627,
      "version": 2,
      "versionNonce": 1053441947,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792703857683,
      "link": null,
      "locked": false,
      "text": "What gets cached, and for how long",
      "fontSize": 34,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "What gets cached, and for how long",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "03-what-gets-cached:cd3-2",
      "type": "text",
      "x": 2,
      "y": 1942,
      "width": 923.6190795898438,
      "height": 25,
      "angle": 0,
      "strokeColor": "#868e96",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "az",
      "roundness": null,
      "seed": 2127246165,
      "version": 2,
      "versionNonce": 430922645,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792703857683,
      "link": null,
      "locked": false,
      "text": "the origin decides with HTTP headers; the CDN decides what makes two requests 'the same'",
      "fontSize": 20,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "the origin decides with HTTP headers; the CDN decides what makes two requests 'the same'",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "03-what-gets-cached:cd3-3",
      "type": "rectangle",
      "x": 0,
      "y": 2010,
      "width": 650,
      "height": 210,
      "angle": 0,
      "strokeColor": "#e8590c",
      "backgroundColor": "#fff4e6",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b00",
      "roundness": {
        "type": 3
      },
      "seed": 221517947,
      "version": 2,
      "versionNonce": 540382267,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792703857683,
      "link": null,
      "locked": false
    },
    {
      "id": "03-what-gets-cached:cd3-4",
      "type": "text",
      "x": 22,
      "y": 2028,
      "width": 167.29661560058594,
      "height": 21.25,
      "angle": 0,
      "strokeColor": "#e8590c",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b01",
      "roundness": null,
      "seed": 571736245,
      "version": 2,
      "versionNonce": 1456021749,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792703857683,
      "link": null,
      "locked": false,
      "text": "The origin's headers",
      "fontSize": 17,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The origin's headers",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "03-what-gets-cached:cd3-5",
      "type": "text",
      "x": 22,
      "y": 2062,
      "width": 410.15625,
      "height": 134.4,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b02",
      "roundness": null,
      "seed": 967921947,
      "version": 2,
      "versionNonce": 781014235,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792703857683,
      "link": null,
      "locked": false,
      "text": "Cache-Control: public, max-age=31536000, immutable\n   -> any cache may keep it for a year\n\nCache-Control: public, s-maxage=60, max-age=0\n   -> the CDN keeps it 60 s, browsers revalidate\n\nCache-Control: private / no-store\n   -> never in a shared cache (per-user data)",
      "fontSize": 14,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Cache-Control: public, max-age=31536000, immutable\n   -> any cache may keep it for a year\n\nCache-Control: public, s-maxage=60, max-age=0\n   -> the CDN keeps it 60 s, browsers revalidate\n\nCache-Control: private / no-store\n   -> never in a shared cache (per-user data)",
      "autoResize": true,
      "lineHeight": 1.2
    },
    {
      "id": "03-what-gets-cached:cd3-6",
      "type": "rectangle",
      "x": 690,
