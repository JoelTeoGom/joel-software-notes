      "versionNonce": 1262697045,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792703857683,
      "link": null,
      "locked": false
    },
    {
      "id": "03-what-gets-cached:cd3-7",
      "type": "text",
      "x": 712,
      "y": 2028,
      "width": 120.01972961425781,
      "height": 21.25,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
