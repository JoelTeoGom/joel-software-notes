      "version": 2,
      "versionNonce": 134286709,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792703857683,
      "link": null,
      "locked": false,
      "text": "How the user reaches the nearest edge",
      "fontSize": 17,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "How the user reaches the nearest edge",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "01-what-a-cdn-is:cd1-25",
      "type": "text",
      "x": 22,
      "y": 716,
      "width": 477.39300537109375,
      "height": 80,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aO",
      "roundness": null,
      "seed": 1217203355,
      "version": 2,
      "versionNonce": 1048080475,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792703857683,
      "link": null,
      "locked": false,
      "text": "Same idea as before: DNS (static.example.com -> CNAME to\nthe CDN, which answers with a nearby edge) and/or anycast\n(one IP announced from every location; the network\ndelivers you to the closest). CloudFront, Cloudflare, Fastly.",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Same idea as before: DNS (static.example.com -> CNAME to\nthe CDN, which answers with a nearby edge) and/or anycast\n(one IP announced from every location; the network\ndelivers you to the closest). CloudFront, Cloudflare, Fastly.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "01-what-a-cdn-is:cd1-26",
      "type": "rectangle",
