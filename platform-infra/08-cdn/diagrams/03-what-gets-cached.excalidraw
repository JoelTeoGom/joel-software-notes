      "link": null,
      "locked": false,
      "text": "the origin decides with HTTP headers; the CDN decides what makes two requests 'the same'",
      "fontSize": 20,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "the origin decides with HTTP headers; the CDN decides what makes two requests 'the same'",
      "autoResize": true,
      "lineHeight": 1.25
    },
