      "versionNonce": 2143517339,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792703857276,
      "link": null,
      "locked": false,
      "text": "Anything cacheable over HTTP: JS, CSS, fonts, video\nsegments, downloads, even GET API responses. And for\nNON-cacheable traffic it still helps: TLS ends near the\nuser and the edge keeps warm connections to the origin.",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Anything cacheable over HTTP: JS, CSS, fonts, video\nsegments, downloads, even GET API responses. And for\nNON-cacheable traffic it still helps: TLS ends near the\nuser and the edge keeps warm connections to the origin.",
      "autoResize": true,
      "lineHeight": 1.25
    },
