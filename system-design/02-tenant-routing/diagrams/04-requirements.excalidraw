      "link": null,
      "locked": false,
      "text": "Reads are constant and critical; writes (new tenant, move a shard, change a license) are rare and can be slow.\nThat asymmetry is the hint for the design: CQRS.",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "tr4-21",
      "originalText": "Reads are constant and critical; writes (new tenant, move a shard, change a license) are rare and can be slow.\nThat asymmetry is the hint for the design: CQRS.",
      "autoResize": true,
      "lineHeight": 1.25
    }
