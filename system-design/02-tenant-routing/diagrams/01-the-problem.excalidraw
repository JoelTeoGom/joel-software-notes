      "isDeleted": false,
      "boundElements": null,
      "updated": 1792704162306,
      "link": null,
      "locked": false,
      "text": "The ingress has a copy, Jira has a copy, Confluence\nhas a copy... Moving a tenant means updating all of\nthem at once, or they disagree and send traffic to\nthe wrong place.",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The ingress has a copy, Jira has a copy, Confluence\nhas a copy... Moving a tenant means updating all of\nthem at once, or they disagree and send traffic to\nthe wrong place.",
      "autoResize": true,
      "lineHeight": 1.25
    },
