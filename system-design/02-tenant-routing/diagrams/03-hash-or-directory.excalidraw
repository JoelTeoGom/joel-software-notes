      "text": "a hash needs no lookup but decides placement for you; a directory costs a lookup but lets you place each tenant",
      "fontSize": 20,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "a hash needs no lookup but decides placement for you; a directory costs a lookup but lets you place each tenant",
      "autoResize": true,
      "lineHeight": 1.25
