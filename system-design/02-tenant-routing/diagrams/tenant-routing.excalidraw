    {
      "id": "03-hash-or-directory:tr3-2",
      "type": "text",
      "x": 2,
      "y": 1982,
      "width": 1139.458740234375,
      "height": 25,
      "angle": 0,
      "strokeColor": "#868e96",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
