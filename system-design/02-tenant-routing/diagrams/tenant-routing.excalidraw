      "seed": 1900538655,
      "version": 2,
      "versionNonce": 403272479,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792704162766,
      "link": null,
      "locked": false,
      "text": "Everyone asks it. It grew from 'route Jira calls' into\na general tenant metadata service across Atlassian\nCloud. Each consumer only sees its own section\n(Jira never gets Confluence's DB password).",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Everyone asks it. It grew from 'route Jira calls' into\na general tenant metadata service across Atlassian\nCloud. Each consumer only sees its own section\n(Jira never gets Confluence's DB password).",
      "autoResize": true,
      "lineHeight": 1.25
    },
