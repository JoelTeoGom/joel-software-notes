    {
      "id": "03-hash-or-directory:tr3-7",
      "type": "text",
      "x": 30,
      "y": 2210,
      "width": 363.4727783203125,
      "height": 140,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
