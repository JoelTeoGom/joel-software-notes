    {
      "id": "xQoONoy4bvlFPjDHh0j-e",
      "type": "text",
      "x": 109.60687255859375,
      "y": 2465,
      "width": 1120.7862548828125,
      "height": 20,
      "angle": 0,
      "strokeColor": "#6741d9",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
