    {
      "id": "01-the-problem:tr1-30",
      "type": "text",
      "x": 705.75,
      "y": 596,
      "width": 423.9688720703125,
      "height": 80,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
