      "isDeleted": false,
      "boundElements": null,
      "updated": 1792704162766,
      "link": null,
      "locked": false,
      "text": "Option A: every service keeps its own map",
      "fontSize": 17,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Option A: every service keeps its own map",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "01-the-problem:tr1-27",
      "type": "text",
      "x": 25.75,
      "y": 596,
      "width": 414.1129150390625,
      "height": 80,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aQ",
      "roundness": null,
      "seed": 864930449,
      "version": 2,
      "versionNonce": 1365688977,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792704162766,
      "link": null,
      "locked": false,
      "text": "The ingress has a copy, Jira has a copy, Confluence\nhas a copy... Moving a tenant means updating all of\nthem at once, or they disagree and send traffic to\nthe wrong place.",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The ingress has a copy, Jira has a copy, Confluence\nhas a copy... Moving a tenant means updating all of\nthem at once, or they disagree and send traffic to\nthe wrong place.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
