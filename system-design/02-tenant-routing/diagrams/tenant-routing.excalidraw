      "index": "b16",
      "roundness": null,
      "seed": 2044625393,
      "version": 3,
      "versionNonce": 1259412369,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792704162767,
      "link": null,
      "locked": false,
      "text": "Atlassian needed placement control, so it took the directory, and the rest of the story is about making that lookup cheap and unbreakable.",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "03-hash-or-directory:tr3-13",
      "originalText": "Atlassian needed placement control, so it took the directory, and the rest of the story is about making that lookup cheap and unbreakable.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "hELCUITOfBH0B5WzD5QaX",
      "type": "text",
      "x": 223.5831298828125,
      "y": 3325,
      "width": 892.833740234375,
      "height": 40,
      "angle": 0,
      "strokeColor": "#e67700",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b17",
      "roundness": null,
      "seed": 1534794705,
      "version": 3,
      "versionNonce": 2127356415,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792704162767,
      "link": null,
      "locked": false,
      "text": "Reads are constant and critical; writes (new tenant, move a shard, change a license) are rare and can be slow.\nThat asymmetry is the hint for the design: CQRS.",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "04-requirements:tr4-21",
      "originalText": "Reads are constant and critical; writes (new tenant, move a shard, change a license) are rare and can be slow.\nThat asymmetry is the hint for the design: CQRS.",
      "autoResize": true,
      "lineHeight": 1.25
    }
