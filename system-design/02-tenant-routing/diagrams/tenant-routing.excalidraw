      "locked": false,
      "text": "DB-per-tenant was inherited, not chosen",
      "fontSize": 17,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "DB-per-tenant was inherited, not chosen",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "02-shards-and-db-per-tenant:tr2-64",
      "type": "text",
      "x": 712,
      "y": 1586,
      "width": 427.1529235839844,
      "height": 80,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0V",
      "roundness": null,
      "seed": 1219538719,
      "version": 2,
      "versionNonce": 525481759,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792704162766,
      "link": null,
      "locked": false,
      "text": "Jira's pre-AWS setup already worked that way and it\nwasn't feasible to change during the migration.\nIsolation is logical: if rds-eu-07 dies, every tenant\non it is down.",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Jira's pre-AWS setup already worked that way and it\nwasn't feasible to change during the migration.\nIsolation is logical: if rds-eu-07 dies, every tenant\non it is down.",
      "autoResize": true,
      "lineHeight": 1.25
    },
