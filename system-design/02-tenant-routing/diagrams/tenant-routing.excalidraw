      "isDeleted": false,
      "boundElements": null,
      "updated": 1792704162766,
      "link": null,
      "locked": false,
      "text": "+ put each tenant exactly where you want:\n  EU customers in the EU, a huge one alone\n+ move ONE tenant: copy its data, flip its\n  entry\n- every request needs a lookup, so the\n  directory must be very fast and must\n  never go down",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "+ put each tenant exactly where you want:\n  EU customers in the EU, a huge one alone\n+ move ONE tenant: copy its data, flip its\n  entry\n- every request needs a lookup, so the\n  directory must be very fast and must\n  never go down",
      "autoResize": true,
      "lineHeight": 1.25
