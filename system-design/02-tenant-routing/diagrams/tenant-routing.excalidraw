      "versionNonce": 836568049,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792704162766,
      "link": null,
      "locked": false,
      "text": "+ no lookup service, nothing to replicate\n- the function decides where acme goes,\n  not you (can't say 'EU tenants in the EU')\n- adding shards moves tenants you didn't pick\n  (consistent hashing moves fewer, but still\n  ones you didn't choose)\n- moving a tenant = moving its whole DB",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "+ no lookup service, nothing to replicate\n- the function decides where acme goes,\n  not you (can't say 'EU tenants in the EU')\n- adding shards moves tenants you didn't pick\n  (consistent hashing moves fewer, but still\n  ones you didn't choose)\n- moving a tenant = moving its whole DB",
      "autoResize": true,
      "lineHeight": 1.25
    },
