      "isDeleted": false,
      "boundElements": null,
      "updated": 1792704162766,
      "link": null,
      "locked": false,
      "text": "everything shared   same servers + same DB, rows tagged with tenant_id\nAtlassian (Jira)    same servers + a DATABASE per tenant   <- still multi-tenant\nsingle-tenant       dedicated servers and DB per customer",
      "fontSize": 14,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "everything shared   same servers + same DB, rows tagged with tenant_id\nAtlassian (Jira)    same servers + a DATABASE per tenant   <- still multi-tenant\nsingle-tenant       dedicated servers and DB per customer",
      "autoResize": true,
      "lineHeight": 1.2
    },
