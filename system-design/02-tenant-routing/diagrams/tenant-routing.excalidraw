      "updated": 1792704162766,
      "link": null,
      "locked": false,
      "text": "Why shards (small groups of tenants)",
      "fontSize": 17,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Why shards (small groups of tenants)",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "02-shards-and-db-per-tenant:tr2-61",
      "type": "text",
      "x": 22,
      "y": 1586,
      "width": 411.31292724609375,
      "height": 80,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0S",
      "roundness": null,
      "seed": 1626490513,
      "version": 2,
      "versionNonce": 1156267665,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792704162766,
      "link": null,
      "locked": false,
      "text": "- Blast radius: a bad shard hurts few customers.\n- Noisy neighbours stay inside their shard.\n- Scale out by adding shards; move a big tenant to\n  its own instance.",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- Blast radius: a bad shard hurts few customers.\n- Noisy neighbours stay inside their shard.\n- Scale out by adding shards; move a big tenant to\n  its own instance.",
      "autoResize": true,
      "lineHeight": 1.25
    },
