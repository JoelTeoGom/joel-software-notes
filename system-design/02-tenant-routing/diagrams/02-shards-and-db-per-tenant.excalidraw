      "isDeleted": false,
      "boundElements": null,
      "updated": 1792704162436,
      "link": null,
      "locked": false,
      "text": "- Blast radius: a bad shard hurts few customers.\n- Noisy neighbours stay inside their shard.\n- Scale out by adding shards; move a big tenant to\n  its own instance.",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- Blast radius: a bad shard hurts few customers.\n- Noisy neighbours stay inside their shard.\n- Scale out by adding shards; move a big tenant to\n  its own instance.",
      "autoResize": true,
      "lineHeight": 1.25
    },
