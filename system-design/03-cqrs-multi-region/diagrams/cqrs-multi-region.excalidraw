      "isDeleted": false,
      "boundElements": null,
      "updated": 1792704165717,
      "link": null,
      "locked": false,
      "text": "Kinesis vs SNS: one consumer vs every node",
      "fontSize": 34,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Kinesis vs SNS: one consumer vs every node",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "03-kinesis-vs-sns:cq3-2",
      "type": "text",
      "x": 2,
