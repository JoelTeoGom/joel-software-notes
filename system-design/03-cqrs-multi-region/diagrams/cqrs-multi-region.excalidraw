      "isDeleted": false,
      "boundElements": null,
      "updated": 1792704165717,
      "link": null,
      "locked": false,
      "text": "both deliver messages, but to opposite audiences, which is why the design needs both",
      "fontSize": 20,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "both deliver messages, but to opposite audiences, which is why the design needs both",
