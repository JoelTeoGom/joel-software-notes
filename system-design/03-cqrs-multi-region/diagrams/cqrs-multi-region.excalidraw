      "versionNonce": 372331851,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792704165717,
      "link": null,
      "locked": false
    },
    {
      "id": "04-what-cqrs-buys:cq4-4",
      "type": "text",
      "x": 22,
      "y": 3166,
      "width": 359.7996826171875,
      "height": 22.5,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1H",
      "roundness": null,
      "seed": 372658213,
      "version": 2,
      "versionNonce": 540129509,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792704165718,
      "link": null,
      "locked": false,
      "text": "Strong consistency without slowing reads",
      "fontSize": 18,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Strong consistency without slowing reads",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "04-what-cqrs-buys:cq4-5",
      "type": "text",
      "x": 22,
      "y": 3206,
      "width": 272.43182373046875,
      "height": 37.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1I",
      "roundness": null,
      "seed": 1261564075,
      "version": 2,
      "versionNonce": 2140042219,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792704165718,
      "link": null,
      "locked": false,
      "text": "Catalogue can use transactions and\nchecks; TCS never waits for it.",
      "fontSize": 15,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Catalogue can use transactions and\nchecks; TCS never waits for it.",
      "autoResize": true,
      "lineHeight": 1.25
