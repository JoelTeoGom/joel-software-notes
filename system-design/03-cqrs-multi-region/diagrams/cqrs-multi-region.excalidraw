      "locked": false,
      "text": "A bonus: rebuildable reads",
      "fontSize": 17,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "A bonus: rebuildable reads",
