      "updated": 1792704165717,
      "link": null,
      "locked": false,
      "text": "The contrast",
      "fontSize": 17,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The contrast",
      "autoResize": true,
