      "version": 2,
      "versionNonce": 1140064619,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792704165717,
      "link": null,
      "locked": false,
      "text": "Push-based (usually to an SQS queue per node).",
      "fontSize": 15,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Push-based (usually to an SQS queue per node).",
