    {
      "id": "03-kinesis-vs-sns:cq3-28",
      "type": "text",
      "x": 720,
      "y": 2520,
      "width": 281.7619323730469,
      "height": 56.25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
