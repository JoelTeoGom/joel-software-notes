      "isDeleted": false,
      "boundElements": null,
      "updated": 1792704165717,
      "link": null,
      "locked": false,
      "text": "EVERY subscriber gets its own copy:\neach node has its own cache, so each\nnode must hear about the change.",
      "fontSize": 15,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "EVERY subscriber gets its own copy:\neach node has its own cache, so each\nnode must hear about the change.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "03-kinesis-vs-sns:cq3-29",
      "type": "text",
      "x": 720,
      "y": 2600,
      "width": 359.04254150390625,
      "height": 18.75,
      "angle": 0,
