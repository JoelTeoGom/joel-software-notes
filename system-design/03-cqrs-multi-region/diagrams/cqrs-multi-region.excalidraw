      "updated": 1792704165717,
      "link": null,
      "locked": false,
      "text": "Hit or miss is the whole game",
      "fontSize": 17,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Hit or miss is the whole game",
