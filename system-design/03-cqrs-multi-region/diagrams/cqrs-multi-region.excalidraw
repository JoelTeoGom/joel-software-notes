    },
    {
      "id": "03-kinesis-vs-sns:cq3-32",
      "type": "text",
      "x": 22,
      "y": 2732,
      "width": 853.125,
      "height": 67.2,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1D",
      "roundness": null,
      "seed": 489596261,
      "version": 2,
      "versionNonce": 1072250405,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792704165717,
      "link": null,
      "locked": false,
      "text": "Kinesis -> DynamoDB      one writer per region   competing consumers   DynamoDB is shared, write it once\nSNS     -> node caches   every node              broadcast / fan-out   every node has its own cache\n\nWrites must be idempotent and ordered per tenant: version each record and write only if newer.",
      "fontSize": 14,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Kinesis -> DynamoDB      one writer per region   competing consumers   DynamoDB is shared, write it once\nSNS     -> node caches   every node              broadcast / fan-out   every node has its own cache\n\nWrites must be idempotent and ordered per tenant: version each record and write only if newer.",
      "autoResize": true,
      "lineHeight": 1.2
    },
    {
      "id": "04-what-cqrs-buys:cq4-1",
      "type": "text",
      "x": 0,
      "y": 3030,
      "width": 741.9461669921875,
      "height": 42.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1E",
      "roundness": null,
      "seed": 243568491,
      "version": 2,
      "versionNonce": 2095899307,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792704165717,
      "link": null,
      "locked": false,
      "text": "What CQRS bought them, and what it costs",
      "fontSize": 34,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "What CQRS bought them, and what it costs",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "04-what-cqrs-buys:cq4-2",
      "type": "text",
      "x": 2,
      "y": 3082,
      "width": 695.09912109375,
      "height": 25,
      "angle": 0,
      "strokeColor": "#868e96",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1F",
      "roundness": null,
      "seed": 1969139909,
      "version": 2,
      "versionNonce": 1053307269,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792704165717,
      "link": null,
      "locked": false,
      "text": "split the side that must be correct from the side that must be fast",
      "fontSize": 20,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "split the side that must be correct from the side that must be fast",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "04-what-cqrs-buys:cq4-3",
      "type": "rectangle",
      "x": 0,
      "y": 3150,
      "width": 650,
      "height": 130,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "#ebfbee",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1G",
      "roundness": {
        "type": 3
      },
