      "boundElements": null,
      "updated": 1792704165506,
      "link": null,
      "locked": false,
      "text": "EVERY subscriber gets its own copy:\neach node has its own cache, so each\nnode must hear about the change.",
      "fontSize": 15,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "EVERY subscriber gets its own copy:\neach node has its own cache, so each\nnode must hear about the change.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
