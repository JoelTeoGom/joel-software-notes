      "text": "hit: microseconds\n(no network after the\nTCS call itself)\n\nmiss: a DynamoDB\nread, single-digit ms",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "hit: microseconds\n(no network after the\nTCS call itself)\n\nmiss: a DynamoDB\nread, single-digit ms",
      "autoResize": true,
      "lineHeight": 1.25
    },
