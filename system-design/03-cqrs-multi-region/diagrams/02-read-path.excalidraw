      "versionNonce": 1218623909,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792704165427,
      "link": null,
      "locked": false,
      "text": "Writes are rare, so almost every read is a hit. The lessons in 'caching at scale' are about the tail: the few slow misses and the slow clients.",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Writes are rare, so almost every read is a hit. The lessons in 'caching at scale' are about the tail: the few slow misses and the slow clients.",
      "autoResize": true,
      "lineHeight": 1.25
    },
