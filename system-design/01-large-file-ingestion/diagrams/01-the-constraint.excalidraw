      "link": null,
      "locked": false,
      "text": "r := bufio.NewReaderSize(f, 1<<20)  // 1 MB buffer\ncsvr := csv.NewReader(r)\nfor {\n    rec, err := csvr.Read()   // one row at a time\n    ...  -> batch of 5,000 rows -> next stage\n}",
      "fontSize": 13,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "r := bufio.NewReaderSize(f, 1<<20)  // 1 MB buffer\ncsvr := csv.NewReader(r)\nfor {\n    rec, err := csvr.Read()   // one row at a time\n    ...  -> batch of 5,000 rows -> next stage\n}",
      "autoResize": true,
      "lineHeight": 1.2
    },
    {
