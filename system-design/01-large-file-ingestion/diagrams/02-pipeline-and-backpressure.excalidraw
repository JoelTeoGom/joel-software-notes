      "seed": 845703842,
      "version": 4,
      "versionNonce": 1996942742,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1792325048647,
      "link": null,
      "locked": false,
      "text": "3. Absorb spikes\n\nBounded queues between stages\nsmooth out jitter: a slow DB batch\ndoes not stall the workers at once.\nQueue full = backpressure.",
      "fontSize": 21,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "c3",
      "originalText": "3. Absorb spikes\n\nBounded queues between stages\nsmooth out jitter: a slow DB batch\ndoes not stall the workers at once.\nQueue full = backpressure.",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
