      "text": "Backpressure flows backwards: slow DB > Queue 2 fills > workers wait > Queue 1 fills > reader stops",
      "fontSize": 21,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "bp",
      "originalText": "Backpressure flows backwards: slow DB > Queue 2 fills > workers wait > Queue 1 fills > reader stops",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
