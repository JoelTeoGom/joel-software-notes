    {
      "id": "vrFlC5Z0dJ2HkM9lUaOew",
      "type": "text",
      "x": 1121.7646026611328,
      "y": 626.25,
      "width": 366.4707946777344,
      "height": 157.5,
      "angle": 0,
      "strokeColor": "#22c55e",
      "backgroundColor": "transparent",
