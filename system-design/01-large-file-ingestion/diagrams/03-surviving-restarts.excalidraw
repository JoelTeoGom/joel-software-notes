      "link": null,
      "locked": false,
      "text": "Restart: seek to the last committed offset and continue. Anything after it is re-processed,\nwhich is safe because the writes are idempotent.",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Restart: seek to the last committed offset and continue. Anything after it is re-processed,\nwhich is safe because the writes are idempotent.",
      "autoResize": true,
      "lineHeight": 1.25
    },
