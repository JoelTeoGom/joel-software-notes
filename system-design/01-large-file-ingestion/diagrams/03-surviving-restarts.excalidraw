    {
      "id": "fi3-5",
      "type": "text",
      "x": 70,
      "y": 200,
      "width": 386.8648376464844,
      "height": 120,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a4",
      "roundness": null,
      "seed": 2063316257,
      "version": 2,
      "versionNonce": 1067108975,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792704138054,
      "link": null,
      "locked": false,
      "text": "one INSERT per row:  10 M round trips\none INSERT per 5,000 rows:  2,000 round trips\n\nBulk paths are faster still:\nCOPY (Postgres), LOAD DATA (MySQL),\nmulti-row INSERT ... VALUES (...), (...)",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "one INSERT per row:  10 M round trips\none INSERT per 5,000 rows:  2,000 round trips\n\nBulk paths are faster still:\nCOPY (Postgres), LOAD DATA (MySQL),\nmulti-row INSERT ... VALUES (...), (...)",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "fi3-6",
      "type": "text",
      "x": 70,
      "y": 365,
      "width": 346.01666259765625,
      "height": 40,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a5",
      "roundness": null,
      "seed": 194931055,
      "version": 2,
      "versionNonce": 874551297,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792704138054,
      "link": null,
      "locked": false,
      "text": "Few, fixed writers = a bounded number of\nDB connections, whatever the worker count.",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Few, fixed writers = a bounded number of\nDB connections, whatever the worker count.",
      "autoResize": true,
      "lineHeight": 1.25
    },
