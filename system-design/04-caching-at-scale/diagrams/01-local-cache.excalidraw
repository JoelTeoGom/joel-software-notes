    {
      "id": "ca1-15",
      "type": "text",
      "x": 780,
      "y": 480,
      "width": 359.5207214355469,
      "height": 160,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aE",
      "roundness": null,
      "seed": 1819636816,
      "version": 2,
      "versionNonce": 2065587888,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792704145961,
      "link": null,
      "locked": false,
      "text": "The goal was to avoid ALL network calls on\nas many requests as possible. A distributed\ncache is still a network call.\n\nThe catch: N nodes = N separate caches, so\neach one must hear about changes:\ninvalidation via SNS. Updates now take a bit\nlonger to land; reads got massively faster.",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The goal was to avoid ALL network calls on\nas many requests as possible. A distributed\ncache is still a network call.\n\nThe catch: N nodes = N separate caches, so\neach one must hear about changes:\ninvalidation via SNS. Updates now take a bit\nlonger to land; reads got massively faster.",
      "autoResize": true,
      "lineHeight": 1.25
    },
