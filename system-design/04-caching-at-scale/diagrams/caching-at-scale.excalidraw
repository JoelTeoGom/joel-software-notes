      "text": "Lesson 1: DynamoDB is fast, but not fast enough every time",
      "fontSize": 34,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Lesson 1: DynamoDB is fast, but not fast enough every time",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "01-local-cache:ca1-2",
      "type": "text",
