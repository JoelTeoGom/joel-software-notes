    {
      "id": "02-guava-vs-caffeine:ca2-18",
      "type": "text",
      "x": 22,
      "y": 1636,
      "width": 242.24948120117188,
      "height": 21.25,
      "angle": 0,
      "strokeColor": "#e67700",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aW",
      "roundness": null,
      "seed": 1299558064,
      "version": 2,
      "versionNonce": 835157168,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792704146411,
      "link": null,
      "locked": false,
      "text": "Where the problem came from",
      "fontSize": 17,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Where the problem came from",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "02-guava-vs-caffeine:ca2-19",
      "type": "text",
      "x": 22,
      "y": 1666,
      "width": 1080.7381591796875,
      "height": 40,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aX",
      "roundness": null,
      "seed": 822465616,
      "version": 2,
      "versionNonce": 1308616272,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792704146411,
      "link": null,
      "locked": false,
      "text": "After moving to the ALB (round robin), requests kept landing on nodes that were busy with cache maintenance or reloading expired keys.\nA drop-in swap to Caffeine (same API family) cut the p99, and its extra features improved the average too.",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "After moving to the ALB (round robin), requests kept landing on nodes that were busy with cache maintenance or reloading expired keys.\nA drop-in swap to Caffeine (same API family) cut the p99, and its extra features improved the average too.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "03-caches-at-every-layer:ca3-1",
      "type": "text",
      "x": 0,
      "y": 1930,
      "width": 656.6064453125,
      "height": 42.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aY",
      "roundness": null,
      "seed": 707549360,
      "version": 2,
      "versionNonce": 2132043440,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792704146411,
      "link": null,
      "locked": false,
      "text": "The final shape: caches at every layer",
      "fontSize": 34,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The final shape: caches at every layer",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "03-caches-at-every-layer:ca3-2",
      "type": "text",
      "x": 2,
      "y": 1982,
      "width": 842.01904296875,
      "height": 25,
      "angle": 0,
      "strokeColor": "#868e96",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aZ",
      "roundness": null,
      "seed": 535218768,
      "version": 2,
      "versionNonce": 2010029136,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792704146411,
      "link": null,
      "locked": false,
      "text": "most lookups never leave the caller's machine; TCS sees fewer requests than before",
      "fontSize": 20,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "most lookups never leave the caller's machine; TCS sees fewer requests than before",
      "autoResize": true,
      "lineHeight": 1.25
    },
