      "updated": 1792704146411,
      "link": null,
      "locked": false,
      "text": "Two options",
      "fontSize": 18,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Two options",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "01-local-cache:ca1-8",
      "type": "text",
      "x": 702,
      "y": 180,
      "width": 337.42474365234375,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a7",
      "roundness": null,
      "seed": 921900624,
      "version": 2,
      "versionNonce": 1651664976,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792704146411,
      "link": null,
      "locked": false,
      "text": "1. optimise the calls (DNS, connections, ...)\n2. don't call DynamoDB on every request\n   = cache. Fixes it at the root, is even\n   faster, and costs less (DynamoDB bills\n   per read).",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. optimise the calls (DNS, connections, ...)\n2. don't call DynamoDB on every request\n   = cache. Fixes it at the root, is even\n   faster, and costs less (DynamoDB bills\n   per read).",
      "autoResize": true,
      "lineHeight": 1.25
    },
