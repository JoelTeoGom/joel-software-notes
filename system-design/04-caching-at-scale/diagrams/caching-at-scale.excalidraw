      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aF",
      "roundness": null,
      "seed": 936210000,
      "version": 2,
      "versionNonce": 1746124880,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792704146411,
      "link": null,
      "locked": false,
      "text": "Lesson 3: the cache library matters for the p99",
      "fontSize": 34,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Lesson 3: the cache library matters for the p99",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "02-guava-vs-caffeine:ca2-2",
      "type": "text",
      "x": 2,
      "y": 972,
      "width": 930.8788452148438,
      "height": 25,
      "angle": 0,
      "strokeColor": "#868e96",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aG",
      "roundness": null,
      "seed": 147021488,
      "version": 2,
      "versionNonce": 608382128,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792704146411,
      "link": null,
      "locked": false,
      "text": "Guava is a good general cache; Caffeine fixed the three things that hurt TCS's tail latency",
      "fontSize": 20,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Guava is a good general cache; Caffeine fixed the three things that hurt TCS's tail latency",
      "autoResize": true,
      "lineHeight": 1.25
    },
