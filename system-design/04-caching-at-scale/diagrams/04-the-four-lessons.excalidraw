      "link": null,
      "locked": false,
      "text": "AWS is a foundation, not a solution: managed services remove whole classes of problems and replace them with new, higher-level ones.",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "AWS is a foundation, not a solution: managed services remove whole classes of problems and replace them with new, higher-level ones.",
      "autoResize": true,
      "lineHeight": 1.25
    },
