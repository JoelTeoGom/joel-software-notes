   "text": "SET SESSION lock_wait_timeout = 2;\nALTER TABLE orders\n  ADD COLUMN order_type VARCHAR(16) NULL,\n  ALGORITHM = INSTANT;",
   "fontSize": 15,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "SET SESSION lock_wait_timeout = 2;\nALTER TABLE orders\n  ADD COLUMN order_type VARCHAR(16) NULL,\n  ALGORITHM = INSTANT;",
   "lineHeight": 1.25,
   "autoResize": true
  },
