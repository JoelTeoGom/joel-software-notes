   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "2. Replicas fall behind",
   "fontSize": 19,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "2. Replicas fall behind",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "r3PZH84kPlmCnFaq",
   "type": "text",
   "x": 752,
   "y": 201.75,
   "width": 477.0,
   "height": 60.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1253426695,
   "version": 1,
   "versionNonce": 1213815578,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "The ALTER replicates as one statement. Every replica\nreplays it for hours, and nothing that comes after it\nis applied meanwhile: replication lag for hours.",
   "fontSize": 16,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "The ALTER replicates as one statement. Every replica\nreplays it for hours, and nothing that comes after it\nis applied meanwhile: replication lag for hours.",
   "lineHeight": 1.25,
   "autoResize": true
  },
