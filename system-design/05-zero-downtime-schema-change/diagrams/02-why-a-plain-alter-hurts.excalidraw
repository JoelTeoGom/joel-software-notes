  },
  {
   "id": "32jGDpi1AF7w2PKa",
   "type": "text",
   "x": 62,
   "y": 166,
   "width": 352.6875,
   "height": 23.75,
   "angle": 0,
   "strokeColor": "#e03131",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
