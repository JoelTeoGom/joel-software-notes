   "updated": 1,
   "link": null,
   "locked": false,
   "text": "chunk copy      INSERT IGNORE INTO gho SELECT ... FROM orders WHERE id BETWEEN a AND b\nbinlog INSERT   INSERT IGNORE INTO gho VALUES (...)\nbinlog UPDATE   UPDATE gho SET <every column> WHERE id = ?\nbinlog DELETE   DELETE FROM gho WHERE id = ?",
   "fontSize": 16,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "chunk copy      INSERT IGNORE INTO gho SELECT ... FROM orders WHERE id BETWEEN a AND b\nbinlog INSERT   INSERT IGNORE INTO gho VALUES (...)\nbinlog UPDATE   UPDATE gho SET <every column> WHERE id = ?\nbinlog DELETE   DELETE FROM gho WHERE id = ?",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
