  {
   "id": "IhXZUpRP9HBvLfhY",
   "type": "text",
   "x": 62,
   "y": 751.75,
   "width": 1224.0,
   "height": 40.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
