   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "An UPDATE that changes the primary key becomes DELETE + INSERT. Nothing is checked first: a statement on a missing row simply affects 0 rows.",
   "fontSize": 16,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "An UPDATE that changes the primary key becomes DELETE + INSERT. Nothing is checked first: a statement on a missing row simply affects 0 rows.",
   "lineHeight": 1.25,
   "autoResize": true
  },
