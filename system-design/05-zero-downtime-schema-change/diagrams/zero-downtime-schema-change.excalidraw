  {
   "id": "Z8RgifcFmC4bvUmQ",
   "type": "text",
   "x": 80,
   "y": 2528,
   "width": 954.0,
   "height": 40.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 55544441,
   "version": 1,
   "versionNonce": 196122999,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "PK ranges follow InnoDB's clustered index, so each batch reads neighbouring pages and locks only its rows.\n\"AND order_type IS NULL\" makes every batch safe to rerun. Slow down when replica lag grows.",
   "fontSize": 16,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "PK ranges follow InnoDB's clustered index, so each batch reads neighbouring pages and locks only its rows.\n\"AND order_type IS NULL\" makes every batch safe to rerun. Slow down when replica lag grows.",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "O9r13kl8Bwr0RkCw",
   "type": "text",
   "x": 40,
   "y": 2770,
   "width": 1166.625,
   "height": 42.5,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
