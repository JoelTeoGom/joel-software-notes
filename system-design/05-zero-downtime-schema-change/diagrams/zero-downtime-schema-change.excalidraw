   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "The old table stays as _orders_del.\nDrop it later, at a quiet moment:\ndropping 200 GB can stall I/O.\nIt's also your rollback copy.",
   "fontSize": 16,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "The old table stays as _orders_del.\nDrop it later, at a quiet moment:\ndropping 200 GB can stall I/O.\nIt's also your rollback copy.",
   "lineHeight": 1.25,
   "autoResize": true
  },
