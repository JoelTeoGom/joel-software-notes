   "versionNonce": 1548728698,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "a shared PK (or unique key), the binlog\nin ROW format with full images, and\nroughly 2x the disk for a while.",
   "fontSize": 16,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "a shared PK (or unique key), the binlog\nin ROW format with full images, and\nroughly 2x the disk for a while.",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "cCaXruPcnSwvycOi",
   "type": "text",
   "x": 40,
   "y": 3791,
   "width": 937.125,
   "height": 42.5,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
