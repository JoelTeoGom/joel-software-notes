   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "\"Our orders table in MySQL has 500 million rows and takes\n2,000 writes per second, day and night. Product needs a new\ncolumn, order_type, filled in for every existing row.\nHow do you ship it without taking the site down?\"",
   "fontSize": 18,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "\"Our orders table in MySQL has 500 million rows and takes\n2,000 writes per second, day and night. Product needs a new\ncolumn, order_type, filled in for every existing row.\nHow do you ship it without taking the site down?\"",
   "lineHeight": 1.25,
   "autoResize": true
  },
