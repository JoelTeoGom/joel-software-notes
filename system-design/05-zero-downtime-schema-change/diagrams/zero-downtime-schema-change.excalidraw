   "versionNonce": 664577237,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Keeping the copy right: every write is idempotent",
   "fontSize": 34,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Keeping the copy right: every write is idempotent",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "9zye51MXr8kcdxSx",
   "type": "text",
