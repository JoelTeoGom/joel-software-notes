  {
   "id": "5gb16jc5Kv3ecQwP",
   "type": "text",
   "x": 62,
   "y": 1661.75,
   "width": 1017.0,
   "height": 20.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
