   "roundness": null,
   "seed": 1803591815,
   "version": 1,
   "versionNonce": 1369367512,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "No long exclusive locks, keep the heavy work out of the write path, and be able to pause, throttle and roll back.",
   "fontSize": 16,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "No long exclusive locks, keep the heavy work out of the write path, and be able to pause, throttle and roll back.",
   "lineHeight": 1.25,
   "autoResize": true
  },
