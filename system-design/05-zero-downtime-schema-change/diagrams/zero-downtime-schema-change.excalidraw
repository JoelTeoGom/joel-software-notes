  },
  {
   "id": "N3Z5DKYAYQ7yydSb",
   "type": "text",
   "x": 62,
   "y": 1081.75,
   "width": 441.0,
   "height": 60.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1495918861,
   "version": 1,
   "versionNonce": 2055823970,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Not every change can be INSTANT. A rebuild copies\nall 200 GB, eats disk I/O for hours and needs\nroughly twice the disk space while it runs.",
   "fontSize": 16,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Not every change can be INSTANT. A rebuild copies\nall 200 GB, eats disk I/O for hours and needs\nroughly twice the disk space while it runs.",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "uyjqtfJMSN9DlviD",
