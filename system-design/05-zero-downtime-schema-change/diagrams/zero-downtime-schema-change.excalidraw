   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Why it always converges",
   "fontSize": 19,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Why it always converges",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "IhXZUpRP9HBvLfhY",
   "type": "text",
   "x": 62,
   "y": 4512.75,
   "width": 1224.0,
   "height": 40.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1961817595,
   "version": 1,
   "versionNonce": 1206182966,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Every event carries the full row and the binlog is replayed in order, so once the tool has caught up, each row equals its latest change.\nRows inserted after the start (id above the max noted at the beginning) are never copied: they only arrive through the binlog.",
   "fontSize": 16,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Every event carries the full row and the binlog is replayed in order, so once the tool has caught up, each row equals its latest change.\nRows inserted after the start (id above the max noted at the beginning) are never copied: they only arrive through the binlog.",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
