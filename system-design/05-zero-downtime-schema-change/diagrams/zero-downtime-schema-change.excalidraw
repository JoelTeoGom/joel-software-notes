   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Its connection drops, the lock is\nreleased, and the RENAME fails because\nthe sentry table still exists: the old\ntable stays exactly as it was.",
   "fontSize": 16,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Its connection drops, the lock is\nreleased, and the RENAME fails because\nthe sentry table still exists: the old\ntable stays exactly as it was.",
   "lineHeight": 1.25,
   "autoResize": true
  },
