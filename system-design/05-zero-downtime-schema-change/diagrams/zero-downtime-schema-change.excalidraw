  {
   "id": "r3PZH84kPlmCnFaq",
   "type": "text",
   "x": 752,
   "y": 1081.75,
   "width": 477.0,
   "height": 60.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
