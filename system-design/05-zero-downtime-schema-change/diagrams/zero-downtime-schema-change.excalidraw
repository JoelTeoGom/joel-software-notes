   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Why a single writer?",
   "fontSize": 19,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Why a single writer?",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "t8FTjYpyV0Iqs18v",
   "type": "text",
   "x": 527,
   "y": 3491.75,
   "width": 369.0,
   "height": 60.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 2141393624,
   "version": 1,
   "versionNonce": 1471916296,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "It issues both the chunk copies (1) and\nthe replayed events (2). The primary sees\none extra connection; throttling = stop.",
   "fontSize": 16,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "It issues both the chunk copies (1) and\nthe replayed events (2). The primary sees\none extra connection; throttling = stop.",
   "lineHeight": 1.25,
   "autoResize": true
  },
