   "updated": 1,
   "link": null,
   "locked": false,
   "text": "1. app: id 9 goes v1 -> v2 -> v3\n2. the chunk copies id 9 as v3\n3. events v2 and v3 arrive later:\n    briefly stale (v2), then v3 again",
   "fontSize": 16,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "1. app: id 9 goes v1 -> v2 -> v3\n2. the chunk copies id 9 as v3\n3. events v2 and v3 arrive later:\n    briefly stale (v2), then v3 again",
   "lineHeight": 1.25,
   "autoResize": true
  },
