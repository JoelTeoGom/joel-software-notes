   "autoResize": true
  },
  {
   "id": "Eda4okMtsYfZPJps",
   "type": "text",
   "x": 80,
   "y": 1490,
   "width": 585.0,
   "height": 40.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 11907396,
   "version": 1,
   "versionNonce": 1916972369,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "The table looks frozen even if the ALTER itself would take 10 ms.\nOne forgotten transaction in a SQL client is enough.",
   "fontSize": 16,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "The table looks frozen even if the ALTER itself would take 10 ms.\nOne forgotten transaction in a SQL client is enough.",
   "lineHeight": 1.25,
   "autoResize": true
  },
