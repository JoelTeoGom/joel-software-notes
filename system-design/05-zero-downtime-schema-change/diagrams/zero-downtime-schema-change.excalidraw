   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "500M rows at ~20k rows/s\n= ~7 hours of copying.\nIt will be slow, so it must be\nsafe to leave running unattended.",
   "fontSize": 16,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "500M rows at ~20k rows/s\n= ~7 hours of copying.\nIt will be slow, so it must be\nsafe to leave running unattended.",
   "lineHeight": 1.25,
   "autoResize": true
  },
