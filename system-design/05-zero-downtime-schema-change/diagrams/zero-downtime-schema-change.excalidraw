   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Why not triggers?",
   "fontSize": 19,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Why not triggers?",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "PtcchhnKXX6SYaxV",
   "type": "text",
   "x": 62,
   "y": 3491.75,
   "width": 405.0,
   "height": 60.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1457921752,
   "version": 1,
   "versionNonce": 1283950126,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Triggers run inside every app transaction:\nextra latency, lock contention, and they\ncan't be paused. The binlog is already there.",
   "fontSize": 16,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Triggers run inside every app transaction:\nextra latency, lock contention, and they\ncan't be paused. The binlog is already there.",
   "lineHeight": 1.25,
   "autoResize": true
  },
