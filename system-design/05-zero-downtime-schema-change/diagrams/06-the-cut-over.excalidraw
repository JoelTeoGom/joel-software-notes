   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Step 3 is how the tool knows it has applied every change made before the lock: its own marker is the last thing in the binlog.",
   "fontSize": 16,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Step 3 is how the tool knows it has applied every change made before the lock: its own marker is the last thing in the binlog.",
