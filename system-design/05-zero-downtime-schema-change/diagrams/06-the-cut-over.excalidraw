   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Give up after a few seconds (gh-ost:\n3 s by default), release everything\nand retry later. Never let production\nqueue up behind the migration.",
   "fontSize": 16,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Give up after a few seconds (gh-ost:\n3 s by default), release everything\nand retry later. Never let production\nqueue up behind the migration.",
   "lineHeight": 1.25,
   "autoResize": true
  },
