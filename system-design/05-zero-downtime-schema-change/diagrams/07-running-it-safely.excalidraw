   "locked": false,
   "text": "\"Add it INSTANT and backfill in PK batches if the change allows it. Otherwise: ghost table + chunked copy + binlog replay\nwith idempotent writes + atomic cut-over with a lock timeout, throttled on replica lag and tested on a replica first.\"",
   "fontSize": 16,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "\"Add it INSTANT and backfill in PK batches if the change allows it. Otherwise: ghost table + chunked copy + binlog replay\nwith idempotent writes + atomic cut-over with a lock timeout, throttled on replica lag and tested on a replica first.\"",
   "lineHeight": 1.25,
   "autoResize": true
  }
