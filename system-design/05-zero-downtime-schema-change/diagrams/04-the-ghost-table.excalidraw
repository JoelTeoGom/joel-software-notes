   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "It issues both the chunk copies (1) and\nthe replayed events (2). The primary sees\none extra connection; throttling = stop.",
   "fontSize": 16,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "It issues both the chunk copies (1) and\nthe replayed events (2). The primary sees\none extra connection; throttling = stop.",
