   "text": "Why not triggers?",
   "fontSize": 19,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Why not triggers?",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "PtcchhnKXX6SYaxV",
   "type": "text",
   "x": 62,
   "y": 751.75,
   "width": 405.0,
   "height": 60.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
