   "seed": 1457921752,
   "version": 1,
   "versionNonce": 1283950126,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Triggers run inside every app transaction:\nextra latency, lock contention, and they\ncan't be paused. The binlog is already there.",
   "fontSize": 16,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Triggers run inside every app transaction:\nextra latency, lock contention, and they\ncan't be paused. The binlog is already there.",
   "lineHeight": 1.25,
   "autoResize": true
  },
