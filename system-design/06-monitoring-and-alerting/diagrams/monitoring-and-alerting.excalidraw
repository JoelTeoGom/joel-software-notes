   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Why it's risk #1:\n- cost scales with ACTIVE SERIES (an index in RAM),\n  not with samples\n- the system is shared: one team's bad label takes\n  down everyone's monitoring, and everyone's alerts\n- so: series limits per team / service, enforced",
   "originalText": "Why it's risk #1:\n- cost scales with ACTIVE SERIES (an index in RAM),\n  not with samples\n- the system is shared: one team's bad label takes\n  down everyone's monitoring, and everyone's alerts\n- so: series limits per team / service, enforced",
   "fontSize": 16,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
