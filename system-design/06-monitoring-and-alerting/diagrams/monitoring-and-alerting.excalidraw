   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Scraping is cheap for the app (counters in memory);\nthe cost is ingesting and storing the points.\nMonitoring must not cost more than the services.",
