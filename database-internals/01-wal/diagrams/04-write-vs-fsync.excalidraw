   "roundness": null,
   "seed": 953888337,
   "version": 1,
   "versionNonce": 1720695506,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Why not skip fsync?",
   "fontSize": 17,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Why not skip fsync?",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "kcF2fcUHfvpBGZaC",
   "type": "text",
   "x": 60,
   "y": 675.25,
   "width": 497.25,
   "height": 63.75,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1196429732,
   "version": 1,
   "versionNonce": 1179180682,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Without it the bytes may still sit in kernel memory.\nPower cut after COMMIT returned = a lost commit.\nfsync is what makes the D in ACID true.",
   "fontSize": 17,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Without it the bytes may still sit in kernel memory.\nPower cut after COMMIT returned = a lost commit.\nfsync is what makes the D in ACID true.",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "A0Fym9noT4gjNpqd",
   "type": "rectangle",
   "x": 745,
   "y": 630,
   "width": 665,
   "height": 127.0,
   "angle": 0,
   "strokeColor": "#e67700",
   "backgroundColor": "#fff9db",
