   "originalText": "Where you feel it",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "HGwqOAVW1o9zSjhX",
   "type": "text",
   "x": 765,
   "y": 675.25,
   "width": 497.25,
   "height": 63.75,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1507739800,
   "version": 1,
   "versionNonce": 228325261,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "At low load, commit latency ~ fsync latency. That's\nwhy databases love disks with power-loss protection:\nthey can safely ack an fsync from their own cache.",
   "fontSize": 17,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "At low load, commit latency ~ fsync latency. That's\nwhy databases love disks with power-loss protection:\nthey can safely ack an fsync from their own cache.",
   "lineHeight": 1.25,
   "autoResize": true
  }
 ],
