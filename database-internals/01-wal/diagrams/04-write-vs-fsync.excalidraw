   "versionNonce": 726495097,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "background process, every 200 ms:\nwrite() + fsync() whatever is pending",
   "fontSize": 17,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "background process, every 200 ms:\nwrite() + fsync() whatever is pending",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "hhssnGbquPeWqrpY",
   "type": "text",
   "x": 880,
   "y": 530,
   "width": 432.0,
   "height": 60.0,
   "angle": 0,
   "strokeColor": "#495057",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 319232999,
   "version": 1,
   "versionNonce": 1801809687,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "COMMIT returns without waiting for the fsync.\nCrash = lose the last few hundred ms of commits.\nNever corruption: the WAL stays consistent.",
   "fontSize": 16,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "COMMIT returns without waiting for the fsync.\nCrash = lose the last few hundred ms of commits.\nNever corruption: the WAL stays consistent.",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "0j5nDAp7Kg2e2f3K",
   "type": "rectangle",
   "x": 40,
   "y": 630,
   "width": 665,
   "height": 127.0,
   "angle": 0,
   "strokeColor": "#e67700",
   "backgroundColor": "#fff9db",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": {
    "type": 3
   },
   "seed": 160771885,
   "version": 1,
   "versionNonce": 1613683643,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false
  },
  {
   "id": "fUPVRDgOjpYZ0PFd",
   "type": "text",
   "x": 60,
   "y": 648,
   "width": 181.6875,
   "height": 21.25,
   "angle": 0,
   "strokeColor": "#e67700",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
