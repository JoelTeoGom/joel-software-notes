   "updated": 1,
   "link": null,
   "locked": false,
   "text": "A producer (inserts) chasing a consumer (write-out).\nIf the producer laps it, it stalls. wal_buffers sets\nthe size (default: 1/32 of shared_buffers, max 16 MB).",
   "fontSize": 17,
   "fontFamily": 1,
   "textAlign": "left",
