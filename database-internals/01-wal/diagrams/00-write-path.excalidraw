  },
  {
   "id": "acsmeSCOStSs3dEr",
   "type": "text",
   "x": 60,
   "y": 776,
   "width": 374.0625,
   "height": 23.75,
   "angle": 0,
   "strokeColor": "#e03131",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
