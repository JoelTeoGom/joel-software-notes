   "roundness": null,
   "seed": 30383379,
   "version": 1,
   "versionNonce": 1520458120,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Why this is fast",
   "fontSize": 17,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Why this is fast",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "iIRCDjSs8Io3wfG3",
   "type": "text",
   "x": 525,
   "y": 645.25,
   "width": 363.375,
   "height": 63.75,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 26339746,
   "version": 1,
   "versionNonce": 1232793534,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "WAL = small sequential appends.\nData pages = random writes, done\nlater and in bulk by the checkpointer.",
   "fontSize": 17,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "WAL = small sequential appends.\nData pages = random writes, done\nlater and in bulk by the checkpointer.",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "SeecVL9DQ83eH0EZ",
   "type": "rectangle",
   "x": 970,
