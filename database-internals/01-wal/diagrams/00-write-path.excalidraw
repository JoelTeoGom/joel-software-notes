   "seed": 1509369502,
   "version": 1,
   "versionNonce": 974410540,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "COMMIT returns once the WAL record is\non disk (3). The dirty page can wait\nseconds, even minutes (4).",
   "fontSize": 17,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "COMMIT returns once the WAL record is\non disk (3). The dirty page can wait\nseconds, even minutes (4).",
   "lineHeight": 1.25,
   "autoResize": true
  },
