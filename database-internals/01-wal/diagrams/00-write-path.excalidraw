   "roundness": {
    "type": 3
   },
   "seed": 1056017705,
   "version": 1,
   "versionNonce": 159090252,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false
  },
  {
   "id": "korDJJzk8TFPHjwa",
   "type": "text",
   "x": 990,
   "y": 618,
   "width": 172.125,
   "height": 21.25,
   "angle": 0,
   "strokeColor": "#e67700",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
