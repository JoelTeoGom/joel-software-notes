   "versionNonce": 1280172654,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "And if it crashes?",
   "fontSize": 17,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "And if it crashes?",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "ynOxhYc6cT3lbTkn",
   "type": "text",
   "x": 990,
   "y": 645.25,
   "width": 363.375,
   "height": 63.75,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 129343593,
   "version": 1,
   "versionNonce": 1309172410,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Start from the last checkpoint and\nreplay the WAL (redo): every committed\nchange comes back, nothing half-done.",
   "fontSize": 17,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Start from the last checkpoint and\nreplay the WAL (redo): every committed\nchange comes back, nothing half-done.",
   "lineHeight": 1.25,
   "autoResize": true
  },
