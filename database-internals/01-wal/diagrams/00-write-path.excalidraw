  {
   "id": "ZsPTqlXejhWbvjVW",
   "type": "text",
   "x": 60,
   "y": 645.25,
   "width": 353.8125,
   "height": 63.75,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
