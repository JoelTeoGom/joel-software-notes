   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "If writes outrun checkpoints, the redo log fills and\nInnoDB stalls everyone to force dirty pages to disk.\nA classic bottleneck under heavy write load.",
   "fontSize": 17,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "If writes outrun checkpoints, the redo log fills and\nInnoDB stalls everyone to force dirty pages to disk.\nA classic bottleneck under heavy write load.",
