  },
  {
   "id": "okG7fJVvEPWUKo49",
   "type": "text",
   "x": 765,
   "y": 3545.75,
   "width": 497.25,
   "height": 63.75,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 190537649,
   "version": 1,
   "versionNonce": 1764505289,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "The write lock only serializes flushers. T8 and T9\nkeep reserving and copying past 9000 the whole time.\nThey just ride the next bus.",
   "fontSize": 17,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "The write lock only serializes flushers. T8 and T9\nkeep reserving and copying past 9000 the whole time.\nThey just ride the next bus.",
   "lineHeight": 1.25,
   "autoResize": true
  },
