  },
  {
   "id": "Ah0w2IWSeiAs7f8w",
   "type": "text",
   "x": 60,
   "y": 6139.75,
   "width": 497.25,
   "height": 63.75,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1024493737,
   "version": 1,
   "versionNonce": 643408690,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Only when (1) a checkpoint is past it and (2) no\nreplication slot still needs it. A stuck slot means\npg_wal grows until the disk is full. LSN only grows.",
   "fontSize": 17,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Only when (1) a checkpoint is past it and (2) no\nreplication slot still needs it. A stuck slot means\npg_wal grows until the disk is full. LSN only grows.",
   "lineHeight": 1.25,
   "autoResize": true
  },
