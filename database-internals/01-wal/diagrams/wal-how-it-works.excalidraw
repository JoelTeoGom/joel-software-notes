   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Why publish insertingAt?",
   "fontSize": 17,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Why publish insertingAt?",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "oOEtJANgdXDnoq7n",
   "type": "text",
   "x": 770,
   "y": 2648.75,
   "width": 506.8125,
   "height": 63.75,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1960118822,
   "version": 1,
   "versionNonce": 1037673022,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "To flush up to LSN X, nobody may still be copying\nbelow X. Right now 1270-1420 is a hole: T3 is done,\nbut a flush can only go up to 1270 until T2 finishes.",
   "fontSize": 17,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "To flush up to LSN X, nobody may still be copying\nbelow X. Right now 1270-1420 is a hole: T3 is done,\nbut a flush can only go up to 1270 until T2 finishes.",
   "lineHeight": 1.25,
   "autoResize": true
  },
