   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Records are variable-size. The WAL is\none continuous tape of bytes, addressed\nby LSN, not an array of cells.",
   "fontSize": 17,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Records are variable-size. The WAL is\none continuous tape of bytes, addressed\nby LSN, not an array of cells.",
   "lineHeight": 1.25,
   "autoResize": true
  },
