  },
  {
   "id": "MCymghsOnKrCXPpA",
   "type": "text",
   "x": 780,
   "y": 5319.75,
   "width": 516.375,
   "height": 63.75,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 2095183619,
   "version": 1,
   "versionNonce": 338110059,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "A producer (inserts) chasing a consumer (write-out).\nIf the producer laps it, it stalls. wal_buffers sets\nthe size (default: 1/32 of shared_buffers, max 16 MB).",
   "fontSize": 17,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "A producer (inserts) chasing a consumer (write-out).\nIf the producer laps it, it stalls. wal_buffers sets\nthe size (default: 1/32 of shared_buffers, max 16 MB).",
   "lineHeight": 1.25,
   "autoResize": true
  },
