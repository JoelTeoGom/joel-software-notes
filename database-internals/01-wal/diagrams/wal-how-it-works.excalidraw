  {
   "id": "UIKu8byo9fpULt9j",
   "type": "text",
   "x": 60,
   "y": 3545.75,
   "width": 487.6875,
   "height": 63.75,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1489409607,
   "version": 1,
   "versionNonce": 1910401914,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "It doesn't leave once per passenger: it leaves with\neveryone at the stop. More load = more commits per\nfsync. It gets more efficient under pressure.",
   "fontSize": 17,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "It doesn't leave once per passenger: it leaves with\neveryone at the stop. More load = more commits per\nfsync. It gets more efficient under pressure.",
   "lineHeight": 1.25,
   "autoResize": true
  },
