   "seed": 1988273050,
   "version": 1,
   "versionNonce": 1289017270,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "A slot can be reused only once its old page is on\ndisk. If p96 weren't written yet, whoever needs\nslot 0 must write it out first, or wait.",
   "fontSize": 17,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "A slot can be reused only once its old page is on\ndisk. If p96 weren't written yet, whoever needs\nslot 0 must write it out first, or wait.",
   "lineHeight": 1.25,
   "autoResize": true
  },
