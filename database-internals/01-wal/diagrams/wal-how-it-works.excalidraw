  },
  {
   "id": "JMVOYk1Pfjp8rVQw",
   "type": "text",
   "x": 60,
   "y": 2648.75,
   "width": 439.875,
   "height": 63.75,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1764355252,
   "version": 1,
   "versionNonce": 1049305809,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Grab any free lock while you copy, release it\nwhen done. Up to 8 transactions can be copying\nat the same instant; a ninth waits a moment.",
   "fontSize": 17,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Grab any free lock while you copy, release it\nwhen done. Up to 8 transactions can be copying\nat the same instant; a ninth waits a moment.",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
