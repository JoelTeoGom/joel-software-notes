  {
   "id": "ZsPTqlXejhWbvjVW",
   "type": "text",
   "x": 60,
   "y": 645.25,
   "width": 353.8125,
   "height": 63.75,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1509369502,
   "version": 1,
   "versionNonce": 974410540,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "COMMIT returns once the WAL record is\non disk (3). The dirty page can wait\nseconds, even minutes (4).",
   "fontSize": 17,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "COMMIT returns once the WAL record is\non disk (3). The dirty page can wait\nseconds, even minutes (4).",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
