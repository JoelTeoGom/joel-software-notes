  {
   "id": "QpUAt3rhxvkukO9q",
   "type": "text",
   "x": 898,
   "y": 4227.5,
   "width": 353.8125,
   "height": 42.5,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1875061530,
   "version": 1,
   "versionNonce": 726495097,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "background process, every 200 ms:\nwrite() + fsync() whatever is pending",
   "fontSize": 17,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "background process, every 200 ms:\nwrite() + fsync() whatever is pending",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "hhssnGbquPeWqrpY",
   "type": "text",
   "x": 880,
   "y": 4317.5,
   "width": 432.0,
   "height": 60.0,
   "angle": 0,
   "strokeColor": "#495057",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 319232999,
   "version": 1,
   "versionNonce": 1801809687,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "COMMIT returns without waiting for the fsync.\nCrash = lose the last few hundred ms of commits.\nNever corruption: the WAL stays consistent.",
   "fontSize": 16,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "COMMIT returns without waiting for the fsync.\nCrash = lose the last few hundred ms of commits.\nNever corruption: the WAL stays consistent.",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "0j5nDAp7Kg2e2f3K",
   "type": "rectangle",
   "x": 40,
   "y": 4417.5,
   "width": 665,
   "height": 127.0,
   "angle": 0,
   "strokeColor": "#e67700",
   "backgroundColor": "#fff9db",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": {
    "type": 3
   },
   "seed": 160771885,
   "version": 1,
   "versionNonce": 1613683643,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false
  },
  {
   "id": "fUPVRDgOjpYZ0PFd",
   "type": "text",
   "x": 60,
   "y": 4435.5,
   "width": 181.6875,
   "height": 21.25,
   "angle": 0,
   "strokeColor": "#e67700",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 953888337,
   "version": 1,
   "versionNonce": 1720695506,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Why not skip fsync?",
   "fontSize": 17,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Why not skip fsync?",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "kcF2fcUHfvpBGZaC",
   "type": "text",
   "x": 60,
   "y": 4462.75,
   "width": 497.25,
   "height": 63.75,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1196429732,
   "version": 1,
   "versionNonce": 1179180682,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Without it the bytes may still sit in kernel memory.\nPower cut after COMMIT returned = a lost commit.\nfsync is what makes the D in ACID true.",
   "fontSize": 17,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Without it the bytes may still sit in kernel memory.\nPower cut after COMMIT returned = a lost commit.\nfsync is what makes the D in ACID true.",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "A0Fym9noT4gjNpqd",
   "type": "rectangle",
   "x": 745,
   "y": 4417.5,
   "width": 665,
   "height": 127.0,
   "angle": 0,
   "strokeColor": "#e67700",
   "backgroundColor": "#fff9db",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": {
    "type": 3
   },
   "seed": 2040872101,
   "version": 1,
   "versionNonce": 731978818,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false
  },
  {
   "id": "X0D0O2dVjxnmetqX",
   "type": "text",
   "x": 765,
   "y": 4435.5,
   "width": 162.5625,
   "height": 21.25,
   "angle": 0,
   "strokeColor": "#e67700",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1537412538,
   "version": 1,
   "versionNonce": 971806056,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Where you feel it",
   "fontSize": 17,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Where you feel it",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "HGwqOAVW1o9zSjhX",
   "type": "text",
   "x": 765,
   "y": 4462.75,
   "width": 497.25,
   "height": 63.75,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1507739800,
   "version": 1,
   "versionNonce": 228325261,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "At low load, commit latency ~ fsync latency. That's\nwhy databases love disks with power-loss protection:\nthey can safely ack an fsync from their own cache.",
   "fontSize": 17,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "At low load, commit latency ~ fsync latency. That's\nwhy databases love disks with power-loss protection:\nthey can safely ack an fsync from their own cache.",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "C5KfI0tvuaGQnMMH",
   "type": "text",
   "x": 40,
   "y": 4724.5,
   "width": 497.25,
   "height": 42.5,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1997624198,
   "version": 1,
   "versionNonce": 1830073475,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "WAL buffers: a ring in RAM",
   "fontSize": 34,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "WAL buffers: a ring in RAM",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "ZNd0yMtVGwaC7o1r",
   "type": "text",
   "x": 40,
   "y": 4772.5,
   "width": 844.3125,
   "height": 23.75,
   "angle": 0,
   "strokeColor": "#495057",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1264462231,
   "version": 1,
   "versionNonce": 264611193,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "the WAL is an endless tape; the memory holding its newest pages is a fixed ring",
   "fontSize": 19,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "the WAL is an endless tape; the memory holding its newest pages is a fixed ring",
   "lineHeight": 1.25,
   "autoResize": true
  },
