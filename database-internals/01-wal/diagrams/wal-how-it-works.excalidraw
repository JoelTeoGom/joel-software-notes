   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false
  },
  {
   "id": "acsmeSCOStSs3dEr",
   "type": "text",
   "x": 60,
   "y": 776,
   "width": 374.0625,
   "height": 23.75,
   "angle": 0,
   "strokeColor": "#e03131",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 501273796,
   "version": 1,
   "versionNonce": 1984083868,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "WARNING: what the WAL is REALLY for",
   "fontSize": 19,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "WARNING: what the WAL is REALLY for",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "Qyyolqz7MbHiOpJ6",
   "type": "text",
   "x": 60,
   "y": 807.75,
   "width": 945.0,
   "height": 100.0,
   "angle": 0,
   "strokeColor": "#e03131",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 570441390,
   "version": 1,
   "versionNonce": 1775176902,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Nobody reads the WAL to write the data files: the dirty pages in RAM already hold the change,\nand the checkpointer (helped by the background writer) writes them to disk.\nThe WAL is only read for:  1) crash recovery   2) point-in-time recovery   3) the senders (replicas, CDC)\n4) the replicas themselves, which are in recovery all the time: pg_is_in_recovery() = true.\nFlush = write to disk. It never means delete.",
   "fontSize": 16,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Nobody reads the WAL to write the data files: the dirty pages in RAM already hold the change,\nand the checkpointer (helped by the background writer) writes them to disk.\nThe WAL is only read for:  1) crash recovery   2) point-in-time recovery   3) the senders (replicas, CDC)\n4) the replicas themselves, which are in recovery all the time: pg_is_in_recovery() = true.\nFlush = write to disk. It never means delete.",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "JEDKyTmv0k6ScHds",
   "type": "text",
   "x": 40,
   "y": 1107.75,
   "width": 401.625,
   "height": 42.5,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 653030851,
   "version": 1,
   "versionNonce": 1502666641,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Step 1: reserve space",
   "fontSize": 34,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Step 1: reserve space",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "Z8RgifcFmC4bvUmQ",
   "type": "text",
