   "roundness": null,
   "seed": 30383379,
   "version": 1,
   "versionNonce": 1520458120,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Why this is fast",
   "fontSize": 17,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Why this is fast",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "iIRCDjSs8Io3wfG3",
   "type": "text",
   "x": 525,
   "y": 645.25,
   "width": 363.375,
   "height": 63.75,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 26339746,
   "version": 1,
   "versionNonce": 1232793534,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "WAL = small sequential appends.\nData pages = random writes, done\nlater and in bulk by the checkpointer.",
   "fontSize": 17,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "WAL = small sequential appends.\nData pages = random writes, done\nlater and in bulk by the checkpointer.",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "SeecVL9DQ83eH0EZ",
   "type": "rectangle",
   "x": 970,
   "y": 600,
   "width": 440,
   "height": 127.0,
   "angle": 0,
   "strokeColor": "#e67700",
   "backgroundColor": "#fff9db",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": {
    "type": 3
   },
   "seed": 1056017705,
   "version": 1,
   "versionNonce": 159090252,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false
  },
  {
   "id": "korDJJzk8TFPHjwa",
   "type": "text",
   "x": 990,
   "y": 618,
   "width": 172.125,
   "height": 21.25,
   "angle": 0,
   "strokeColor": "#e67700",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1302057238,
   "version": 1,
   "versionNonce": 1280172654,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "And if it crashes?",
   "fontSize": 17,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "And if it crashes?",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "ynOxhYc6cT3lbTkn",
   "type": "text",
   "x": 990,
   "y": 645.25,
   "width": 363.375,
   "height": 63.75,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 129343593,
   "version": 1,
   "versionNonce": 1309172410,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Start from the last checkpoint and\nreplay the WAL (redo): every committed\nchange comes back, nothing half-done.",
   "fontSize": 17,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Start from the last checkpoint and\nreplay the WAL (redo): every committed\nchange comes back, nothing half-done.",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "9vG8wNoNQqFKPLjE",
   "type": "rectangle",
   "x": 40,
   "y": 760,
   "width": 1370,
   "height": 167.75,
   "angle": 0,
   "strokeColor": "#e03131",
   "backgroundColor": "#fff5f5",
   "fillStyle": "solid",
   "strokeWidth": 3,
