   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "A bump (arena) allocator: return the\ncurrent pointer, add the size, move on.\nNothing is ever freed piece by piece.",
   "fontSize": 17,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "A bump (arena) allocator: return the\ncurrent pointer, add the size, move on.\nNothing is ever freed piece by piece.",
   "lineHeight": 1.25,
   "autoResize": true
  },
