   "roundness": null,
   "seed": 234017378,
   "version": 1,
   "versionNonce": 333741623,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Crash between processing and committing: that\nmessage is processed again (at-least-once).\nMake the sink idempotent: upsert by PK.",
   "fontSize": 16,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Crash between processing and committing: that\nmessage is processed again (at-least-once).\nMake the sink idempotent: upsert by PK.",
   "lineHeight": 1.25,
   "autoResize": true
  },
