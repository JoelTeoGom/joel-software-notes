   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "More consumers than partitions?",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "9WZgDrTQ0LB8Z2cj",
   "type": "text",
   "x": 60,
   "y": 759.0,
   "width": 603.0,
   "height": 40.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
