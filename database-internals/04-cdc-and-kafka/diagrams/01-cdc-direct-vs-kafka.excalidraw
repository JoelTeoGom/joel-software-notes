   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Kafka absorbs the slowness",
   "fontSize": 16,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Kafka absorbs the slowness",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "O2xaCUvet6zYYqy0",
   "type": "text",
   "x": 525,
   "y": 794.0,
   "width": 360.0,
   "height": 60.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1400200144,
   "version": 1,
   "versionNonce": 2106290926,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "A slow sink only grows lag in Kafka. The\nprimary keeps confirming its slot, so\npg_wal stays small.",
   "fontSize": 16,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "A slow sink only grows lag in Kafka. The\nprimary keeps confirming its slot, so\npg_wal stays small.",
   "lineHeight": 1.25,
   "autoResize": true
  },
