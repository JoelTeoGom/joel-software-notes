  {
   "id": "PdjJYM6mgv4I3ERx",
   "type": "text",
   "x": 60,
   "y": 794.0,
   "width": 360.0,
   "height": 60.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1696525357,
   "version": 1,
   "versionNonce": 1834836615,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Postgres only has to care about one slot\nand decodes the WAL once. Every new\nconsumer reads Kafka, not the primary.",
   "fontSize": 16,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Postgres only has to care about one slot\nand decodes the WAL once. Every new\nconsumer reads Kafka, not the primary.",
   "lineHeight": 1.25,
   "autoResize": true
  },
