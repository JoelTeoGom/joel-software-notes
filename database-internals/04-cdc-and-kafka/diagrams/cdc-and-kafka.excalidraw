  {
   "id": "dTKZrg754txTsHo6",
   "type": "text",
   "x": 990,
   "y": 2551.75,
   "width": 342.0,
   "height": 60.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
