   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "More consumers than partitions?",
   "fontSize": 16,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "More consumers than partitions?",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "9WZgDrTQ0LB8Z2cj",
   "type": "text",
   "x": 60,
   "y": 3568.75,
   "width": 603.0,
   "height": 40.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1606486239,
   "version": 1,
   "versionNonce": 1181375622,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "The extra ones sit idle: inside a group, each partition has exactly\none owner. Partition count = maximum parallelism of a group.",
   "fontSize": 16,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "The extra ones sit idle: inside a group, each partition has exactly\none owner. Partition count = maximum parallelism of a group.",
   "lineHeight": 1.25,
   "autoResize": true
  },
