   "seed": 1963173569,
   "version": 1,
   "versionNonce": 1733757331,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Kafka deletes whole segments by time or size,\nwhether or not a consumer read them. The\ndifference: you size it in days or weeks, on\ndisks that aren't your database's.",
   "fontSize": 16,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Kafka deletes whole segments by time or size,\nwhether or not a consumer read them. The\ndifference: you size it in days or weeks, on\ndisks that aren't your database's.",
   "lineHeight": 1.25,
   "autoResize": true
  },
