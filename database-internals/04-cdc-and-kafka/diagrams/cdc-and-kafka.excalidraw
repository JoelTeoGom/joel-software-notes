   "roundness": null,
   "seed": 1552883384,
   "version": 1,
   "versionNonce": 1826076421,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Order is per partition",
   "fontSize": 16,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Order is per partition",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "7C66La41L76C1Zyf",
   "type": "text",
   "x": 60,
   "y": 2551.75,
   "width": 360.0,
   "height": 80.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 400101172,
   "version": 1,
   "versionNonce": 2011351965,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Kafka only orders messages inside a\npartition. Key = PK puts every change of\nrow 42 in one partition, in order.\nThat's exactly what CDC needs.",
   "fontSize": 16,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Kafka only orders messages inside a\npartition. Key = PK puts every change of\nrow 42 in one partition, in order.\nThat's exactly what CDC needs.",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
