  {
   "id": "ICbFrbM0oJ1mQU6u",
   "type": "text",
   "x": 900,
   "y": 3960.75,
   "width": 405.0,
   "height": 80.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
