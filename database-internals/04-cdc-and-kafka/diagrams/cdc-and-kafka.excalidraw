   "versionNonce": 633588432,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Append-only segment files, the OS page\ncache and zero-copy sendfile() to the\nconsumers. Sequential I/O all the way.",
   "fontSize": 16,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Append-only segment files, the OS page\ncache and zero-copy sendfile() to the\nconsumers. Sequential I/O all the way.",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
