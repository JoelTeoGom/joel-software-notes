   "roundness": null,
   "seed": 1400200144,
   "version": 1,
   "versionNonce": 2106290926,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "A slow sink only grows lag in Kafka. The\nprimary keeps confirming its slot, so\npg_wal stays small.",
   "fontSize": 16,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "A slow sink only grows lag in Kafka. The\nprimary keeps confirming its slot, so\npg_wal stays small.",
   "lineHeight": 1.25,
   "autoResize": true
  },
