   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Kafka is a buffer and a fan-out point. Worth it when you need one of the two.",
   "fontSize": 19,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Kafka is a buffer and a fan-out point. Worth it when you need one of the two.",
