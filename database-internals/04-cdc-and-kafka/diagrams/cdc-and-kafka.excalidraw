   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "When A2 crashes",
   "fontSize": 16,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "When A2 crashes",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "wqY2vuTGNhPaf9DJ",
   "type": "text",
   "x": 860,
   "y": 3363.75,
   "width": 441.0,
   "height": 80.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1528262053,
   "version": 1,
   "versionNonce": 600920198,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "The group rebalances: p1 goes to A1 or A3, which\nasks the broker for p1's committed offset (4) and\ncontinues from there. The committed offset is the\nnext message to read.",
   "fontSize": 16,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "The group rebalances: p1 goes to A1 or A3, which\nasks the broker for p1's committed offset (4) and\ncontinues from there. The committed offset is the\nnext message to read.",
   "lineHeight": 1.25,
   "autoResize": true
  },
