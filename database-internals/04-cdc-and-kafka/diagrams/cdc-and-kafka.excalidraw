   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Consumers pull",
   "fontSize": 16,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Consumers pull",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "QtLAvVySkrwMLn2o",
   "type": "text",
   "x": 525,
   "y": 2551.75,
   "width": 360.0,
   "height": 60.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1926384670,
   "version": 1,
   "versionNonce": 870783944,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Nobody pushes: a consumer asks 'give me\npartition 1 from offset 4'. An offset is\njust a position in the log, like an LSN.",
   "fontSize": 16,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Nobody pushes: a consumer asks 'give me\npartition 1 from offset 4'. An offset is\njust a position in the log, like an LSN.",
   "lineHeight": 1.25,
   "autoResize": true
  },
