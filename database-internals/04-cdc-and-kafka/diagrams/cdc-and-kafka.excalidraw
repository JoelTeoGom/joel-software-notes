   "versionNonce": 776927089,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "every group reads the whole topic; inside a group the partitions are split; the broker remembers each group's position",
   "fontSize": 19,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "every group reads the whole topic; inside a group the partitions are split; the broker remembers each group's position",
   "lineHeight": 1.25,
   "autoResize": true
  },
