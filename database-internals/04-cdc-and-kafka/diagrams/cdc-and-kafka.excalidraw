  {
   "id": "GnvlPPDq5hOoODGa",
   "type": "text",
   "x": 620,
   "y": 2437.75,
   "width": 783.0,
   "height": 40.0,
   "angle": 0,
   "strokeColor": "#495057",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 709300150,
   "version": 1,
   "versionNonce": 1540514701,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Each partition has a leader broker that takes the writes and followers on other brokers\nthat copy it. With acks = all, the producer waits until the in-sync followers have it.",
   "fontSize": 16,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Each partition has a leader broker that takes the writes and followers on other brokers\nthat copy it. With acks = all, the producer waits until the in-sync followers have it.",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "eGrxIA9j7Kap744e",
   "type": "rectangle",
   "x": 40,
