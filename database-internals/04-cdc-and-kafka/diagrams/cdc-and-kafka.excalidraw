   "link": null,
   "locked": false
  },
  {
   "id": "Mw9SUSpD6xFpkOiv",
   "type": "text",
   "x": 60,
   "y": 2525.75,
   "width": 198.0,
   "height": 20.0,
   "angle": 0,
   "strokeColor": "#e67700",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
