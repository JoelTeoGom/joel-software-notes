   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "A service born today reads the topic\nfrom the start instead of asking the\nprimary for another snapshot.",
   "fontSize": 16,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "A service born today reads the topic\nfrom the start instead of asking the\nprimary for another snapshot.",
   "lineHeight": 1.25,
   "autoResize": true
  },
