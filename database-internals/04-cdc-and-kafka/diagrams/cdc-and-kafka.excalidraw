   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Commit after processing",
   "fontSize": 16,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Commit after processing",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "Zs1vUUcROE8MIxxl",
   "type": "text",
   "x": 860,
   "y": 3523.75,
   "width": 405.0,
   "height": 60.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 234017378,
   "version": 1,
   "versionNonce": 333741623,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Crash between processing and committing: that\nmessage is processed again (at-least-once).\nMake the sink idempotent: upsert by PK.",
   "fontSize": 16,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Crash between processing and committing: that\nmessage is processed again (at-least-once).\nMake the sink idempotent: upsert by PK.",
   "lineHeight": 1.25,
   "autoResize": true
  },
