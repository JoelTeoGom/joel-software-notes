  },
  {
   "id": "2VpGrzK7vPhLjKVj",
   "type": "text",
   "x": 525,
   "y": 654.0,
   "width": 360.0,
   "height": 80.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 915621276,
   "version": 1,
   "versionNonce": 2058282807,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Internal two-phase commit. On restart,\na 'prepared' transaction is committed if\nit's in the binlog, rolled back if not.\nThe two logs always agree.",
   "fontSize": 16,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Internal two-phase commit. On restart,\na 'prepared' transaction is committed if\nit's in the binlog, rolled back if not.\nThe two logs always agree.",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
