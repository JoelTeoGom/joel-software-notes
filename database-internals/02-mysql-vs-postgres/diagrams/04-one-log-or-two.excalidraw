  },
  {
   "id": "vhjlskOcXZdxrlsg",
   "type": "text",
   "x": 60,
   "y": 654.0,
   "width": 360.0,
   "height": 80.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 323722279,
   "version": 1,
   "versionNonce": 740811822,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "The same WAL bytes serve crash recovery,\nphysical replicas and, with wal_level =\nlogical, decoding into row changes.\nEach logical slot decodes on its own.",
   "fontSize": 16,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "The same WAL bytes serve crash recovery,\nphysical replicas and, with wal_level =\nlogical, decoding into row changes.\nEach logical slot decodes on its own.",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
