   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Why two logs?",
   "fontSize": 16,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Why two logs?",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "XUMdHQq3fh9oUmYn",
   "type": "text",
   "x": 990,
   "y": 654.0,
   "width": 360.0,
   "height": 80.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 842981834,
   "version": 1,
   "versionNonce": 1260583027,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "MySQL has pluggable storage engines. The\nbinlog lives in the server layer, so\nreplication works for any engine. The\nredo log belongs to InnoDB.",
   "fontSize": 16,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "MySQL has pluggable storage engines. The\nbinlog lives in the server layer, so\nreplication works for any engine. The\nredo log belongs to InnoDB.",
   "lineHeight": 1.25,
   "autoResize": true
  }
