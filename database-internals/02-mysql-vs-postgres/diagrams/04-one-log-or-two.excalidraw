   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "One log, many uses",
   "fontSize": 16,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "One log, many uses",
