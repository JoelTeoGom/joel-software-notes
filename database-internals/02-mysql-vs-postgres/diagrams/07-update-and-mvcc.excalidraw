   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Old versions live in the table itself. VACUUM later\nmakes dead tuples' space reusable. If it can't keep\nup: bloat, the table fills with dead rows.",
   "fontSize": 16,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
