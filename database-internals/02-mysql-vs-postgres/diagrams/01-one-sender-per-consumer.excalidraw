   "roundness": {
    "type": 3
   },
   "seed": 570441390,
   "version": 1,
   "versionNonce": 1775176902,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false
  },
  {
   "id": "JEDKyTmv0k6ScHds",
   "type": "text",
   "x": 1060,
   "y": 488,
   "width": 189.0,
   "height": 20.0,
   "angle": 0,
   "strokeColor": "#e67700",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 653030851,
   "version": 1,
   "versionNonce": 1502666641,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "What a consumer costs",
   "fontSize": 16,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "What a consumer costs",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "Z8RgifcFmC4bvUmQ",
   "type": "text",
   "x": 1060,
   "y": 514.0,
   "width": 315.0,
   "height": 80.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 55544441,
   "version": 1,
   "versionNonce": 196122999,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "One thread (MySQL) or one process\n(Postgres) + socket + buffers. Idle\nones cost memory, not CPU.\nHeartbeats detect dead peers.",
   "fontSize": 16,
   "fontFamily": 1,
   "textAlign": "left",
