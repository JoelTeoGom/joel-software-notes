   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Tuples can be compacted inside the page\nwithout changing their ctid: indexes keep\npointing at the line pointer.",
   "fontSize": 16,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Tuples can be compacted inside the page\nwithout changing their ctid: indexes keep\npointing at the line pointer.",
   "lineHeight": 1.25,
   "autoResize": true
  },
