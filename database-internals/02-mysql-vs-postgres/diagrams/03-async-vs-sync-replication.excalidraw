   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Postgres: 1 sync standby nearby + async ones, or a\nquorum like ANY 1 (a, b). No sync standby = commits hang.\nMySQL semi-sync: waits until a replica has it in its\nrelay log; after a timeout it falls back to async.",
   "fontSize": 16,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Postgres: 1 sync standby nearby + async ones, or a\nquorum like ANY 1 (a, b). No sync standby = commits hang.\nMySQL semi-sync: waits until a replica has it in its\nrelay log; after a timeout it falls back to async.",
   "lineHeight": 1.25,
   "autoResize": true
  }
