  },
  {
   "id": "bYAtNNRwtzyEkGz3",
   "type": "text",
   "x": 990,
   "y": 3435.75,
   "width": 117.0,
   "height": 20.0,
   "angle": 0,
   "strokeColor": "#e67700",
