   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "A background purge thread drops undo records once no\nopen snapshot needs them. A long transaction keeps\nthem alive, and the undo history keeps growing.",
   "fontSize": 16,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "A background purge thread drops undo records once no\nopen snapshot needs them. A long transaction keeps\nthem alive, and the undo history keeps growing.",
   "lineHeight": 1.25,
   "autoResize": true
  },
