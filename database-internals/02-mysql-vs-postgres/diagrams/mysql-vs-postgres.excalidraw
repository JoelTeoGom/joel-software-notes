   "versionNonce": 662585637,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "the price: every COMMIT waits a network round trip + the replica's fsync",
   "fontSize": 16,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "the price: every COMMIT waits a network round trip + the replica's fsync",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "fBF8Zgd9PNlWDDSf",
   "type": "text",
   "x": 40,
   "y": 2457.75,
   "width": 414.0,
   "height": 20.0,
   "angle": 0,
   "strokeColor": "#e03131",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1283161792,
   "version": 1,
   "versionNonce": 1894809599,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "fast, but a failover can lose the last commits",
   "fontSize": 16,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "fast, but a failover can lose the last commits",
   "lineHeight": 1.25,
   "autoResize": true
  },
