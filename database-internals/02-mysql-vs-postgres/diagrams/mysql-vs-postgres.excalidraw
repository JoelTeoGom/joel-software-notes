  },
  {
   "id": "LIYitOgj1qzWEZ3v",
   "type": "text",
   "x": 780,
   "y": 1495.25,
   "width": 468.5625,
   "height": 85.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 90843417,
   "version": 1,
   "versionNonce": 936774458,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "The slot stops advancing, so Postgres keeps every\nWAL segment after it. Nothing is lost, but pg_wal\ngrows until the disk fills. Monitor slot lag (or\nset max_slot_wal_keep_size).",
   "fontSize": 17,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "The slot stops advancing, so Postgres keeps every\nWAL segment after it. Nothing is lost, but pg_wal\ngrows until the disk fills. Monitor slot lag (or\nset max_slot_wal_keep_size).",
   "lineHeight": 1.25,
   "autoResize": true
  },
