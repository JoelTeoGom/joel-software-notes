   "versionNonce": 1093332273,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "remote_write  the replica's OS has it\non            the replica flushed it to disk\nremote_apply  the replica applied it (readable)",
   "fontSize": 16,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "remote_write  the replica's OS has it\non            the replica flushed it to disk\nremote_apply  the replica applied it (readable)",
   "lineHeight": 1.25,
   "autoResize": true
  },
