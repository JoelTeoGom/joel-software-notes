   "updated": 1,
   "link": null,
   "locked": false,
   "text": "PK or not, an index entry is key -> ctid.\nOne hop into the heap, no second tree\ndescent like InnoDB.",
   "fontSize": 16,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "PK or not, an index entry is key -> ctid.\nOne hop into the heap, no second tree\ndescent like InnoDB.",
