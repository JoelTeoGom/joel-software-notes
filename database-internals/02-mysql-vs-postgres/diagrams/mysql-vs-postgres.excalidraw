   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Not a thread per write",
   "fontSize": 16,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Not a thread per write",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "korDJJzk8TFPHjwa",
   "type": "text",
   "x": 1060,
   "y": 174.0,
   "width": 324.0,
   "height": 100.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1302057238,
   "version": 1,
   "versionNonce": 1280172654,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Each sender is a long-lived loop:\nread from my position, send, repeat.\nNothing new? Block until a commit\nsignals. Like a goroutine blocked\non a channel.",
   "fontSize": 16,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Each sender is a long-lived loop:\nread from my position, send, repeat.\nNothing new? Block until a commit\nsignals. Like a goroutine blocked\non a channel.",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "ynOxhYc6cT3lbTkn",
   "type": "rectangle",
   "x": 1040,
   "y": 310,
   "width": 370,
   "height": 142.0,
   "angle": 0,
   "strokeColor": "#e67700",
   "backgroundColor": "#fff9db",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
