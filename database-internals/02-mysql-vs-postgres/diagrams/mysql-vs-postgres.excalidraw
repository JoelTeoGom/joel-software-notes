   "updated": 1,
   "link": null,
   "locked": false,
   "text": "The double hop",
   "fontSize": 16,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "The double hop",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "GyS3i4W4aQYpfkme",
   "type": "text",
   "x": 80,
   "y": 4483.75,
   "width": 963.0,
   "height": 40.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 80456914,
   "version": 1,
   "versionNonce": 369796099,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "A secondary index gives you the PK (1), then InnoDB descends the clustered tree again (2). If the secondary\nindex already holds every column the query needs (a covering index), the second hop is skipped.",
   "fontSize": 16,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "A secondary index gives you the PK (1), then InnoDB descends the clustered tree again (2). If the secondary\nindex already holds every column the query needs (a covering index), the second hop is skipped.",
   "lineHeight": 1.25,
   "autoResize": true
  },
