   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "rows live in the leaves, sorted by PK; secondary indexes store the PK, not a location",
   "fontSize": 19,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "rows live in the leaves, sorted by PK; secondary indexes store the PK, not a location",
   "lineHeight": 1.25,
   "autoResize": true
  },
