    "type": 3
   },
   "seed": 129343593,
   "version": 1,
   "versionNonce": 1309172410,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false
  },
  {
   "id": "9vG8wNoNQqFKPLjE",
   "type": "text",
   "x": 1060,
   "y": 328,
   "width": 252.0,
   "height": 20.0,
   "angle": 0,
   "strokeColor": "#e67700",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 336151246,
   "version": 1,
   "versionNonce": 5746078,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Commit doesn't touch sockets",
   "fontSize": 16,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Commit doesn't touch sockets",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "acsmeSCOStSs3dEr",
   "type": "text",
   "x": 1060,
   "y": 354.0,
   "width": 315.0,
   "height": 80.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 501273796,
   "version": 1,
   "versionNonce": 1984083868,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "The committing backend only appends\nto the log and fires a signal. 10\nconsumers = 10 senders reading the\nsame log, each at its own pace.",
   "fontSize": 16,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "The committing backend only appends\nto the log and fires a signal. 10\nconsumers = 10 senders reading the\nsame log, each at its own pace.",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "Qyyolqz7MbHiOpJ6",
   "type": "rectangle",
   "x": 1040,
   "y": 470,
   "width": 370,
   "height": 142.0,
   "angle": 0,
   "strokeColor": "#e67700",
   "backgroundColor": "#fff9db",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
