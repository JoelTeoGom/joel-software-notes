  {
   "id": "Te0BXVrHalTy5u3s",
   "type": "text",
   "x": 780,
   "y": 2549.75,
   "width": 513.0,
   "height": 80.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1351326605,
   "version": 1,
   "versionNonce": 57224330,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Postgres: 1 sync standby nearby + async ones, or a\nquorum like ANY 1 (a, b). No sync standby = commits hang.\nMySQL semi-sync: waits until a replica has it in its\nrelay log; after a timeout it falls back to async.",
   "fontSize": 16,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Postgres: 1 sync standby nearby + async ones, or a\nquorum like ANY 1 (a, b). No sync standby = commits hang.\nMySQL semi-sync: waits until a replica has it in its\nrelay log; after a timeout it falls back to async.",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "meQ9pyxlkOuDleKh",
   "type": "text",
   "x": 40,
   "y": 2827.75,
   "width": 286.875,
   "height": 42.5,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1350821412,
   "version": 1,
   "versionNonce": 1548728349,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "One log or two?",
   "fontSize": 34,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "One log or two?",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "nx1YJ0rPCk8sHMBc",
   "type": "text",
   "x": 40,
   "y": 2875.75,
   "width": 1015.3125,
   "height": 23.75,
   "angle": 0,
   "strokeColor": "#495057",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 673649476,
   "version": 1,
   "versionNonce": 899323843,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Postgres writes one WAL for everything. MySQL writes InnoDB's redo log AND the server's binlog.",
   "fontSize": 19,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Postgres writes one WAL for everything. MySQL writes InnoDB's redo log AND the server's binlog.",
   "lineHeight": 1.25,
   "autoResize": true
  },
