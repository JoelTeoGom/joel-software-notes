   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Binary search over the directory slots (each\nowns 4-8 records), then walk a few records\nalong the list. No full scan of the page.",
   "fontSize": 16,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Binary search over the directory slots (each\nowns 4-8 records), then walk a few records\nalong the list. No full scan of the page.",
   "lineHeight": 1.25,
   "autoResize": true
  },
