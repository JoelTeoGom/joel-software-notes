  },
  {
   "id": "ICbFrbM0oJ1mQU6u",
   "type": "text",
   "x": 870,
   "y": 4343.75,
   "width": 441.0,
   "height": 60.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1963173569,
   "version": 1,
   "versionNonce": 1733757331,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Auto-increment: inserts append at the right edge.\nRandom UUIDs: inserts land anywhere -> page\nsplits and half-empty pages.",
   "fontSize": 16,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Auto-increment: inserts append at the right edge.\nRandom UUIDs: inserts land anywhere -> page\nsplits and half-empty pages.",
   "lineHeight": 1.25,
   "autoResize": true
  },
