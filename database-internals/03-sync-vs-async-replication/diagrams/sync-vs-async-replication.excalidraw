  },
  {
   "id": "E02yyarfIoTPQqJt",
   "type": "text",
   "x": 525,
   "y": 3585.75,
   "width": 351.0,
   "height": 60.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 908660362,
   "version": 1,
   "versionNonce": 1694529453,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Primary lost: promote the sync standby,\nzero lost transfers. Whole region lost:\npromote the DR replica, lose its lag.",
   "fontSize": 16,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Primary lost: promote the sync standby,\nzero lost transfers. Whole region lost:\npromote the DR replica, lose its lag.",
   "lineHeight": 1.25,
   "autoResize": true
  },
