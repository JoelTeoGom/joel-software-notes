   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Why the sync standby is close",
   "fontSize": 16,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Why the sync standby is close",
