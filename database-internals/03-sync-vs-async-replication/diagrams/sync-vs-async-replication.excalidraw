   "locked": false
  },
  {
   "id": "RbfBYVqrzZuK1d6I",
   "type": "text",
   "x": 60,
   "y": 746,
   "width": 374.0625,
   "height": 23.75,
   "angle": 0,
   "strokeColor": "#e03131",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 2106084416,
   "version": 1,
   "versionNonce": 1336286653,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "WARNING: what the WAL is REALLY for",
   "fontSize": 19,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "WARNING: what the WAL is REALLY for",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "iB6ZlkqBFpbI3dLD",
   "type": "text",
   "x": 60,
   "y": 777.75,
   "width": 945.0,
   "height": 100.0,
   "angle": 0,
   "strokeColor": "#e03131",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 558681427,
   "version": 1,
   "versionNonce": 814119354,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Nobody reads the WAL to write the data files: the dirty pages in RAM already hold the change,\nand the checkpointer (helped by the background writer) writes them to disk.\nThe WAL is only read for:  1) crash recovery   2) point-in-time recovery   3) the senders (replicas, CDC)\n4) the replicas themselves, which are in recovery all the time: pg_is_in_recovery() = true.\nFlush = write to disk. It never means delete.",
   "fontSize": 16,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Nobody reads the WAL to write the data files: the dirty pages in RAM already hold the change,\nand the checkpointer (helped by the background writer) writes them to disk.\nThe WAL is only read for:  1) crash recovery   2) point-in-time recovery   3) the senders (replicas, CDC)\n4) the replicas themselves, which are in recovery all the time: pg_is_in_recovery() = true.\nFlush = write to disk. It never means delete.",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "UNdUVw4YRw81aQ1F",
   "type": "text",
   "x": 40,
   "y": 1077.75,
   "width": 535.5,
   "height": 42.5,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1009976243,
   "version": 1,
   "versionNonce": 41625284,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Replication: what is it for?",
   "fontSize": 34,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Replication: what is it for?",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "viD8WOpEx9pCwB8P",
   "type": "text",
   "x": 40,
   "y": 1125.75,
   "width": 833.625,
   "height": 23.75,
   "angle": 0,
   "strokeColor": "#495057",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 428123803,
