   "versionNonce": 1320720451,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Where sync vs async comes in",
   "fontSize": 16,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Where sync vs async comes in",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "mgYdlj9yv5Cc6zkp",
   "type": "text",
   "x": 60,
   "y": 1701.75,
   "width": 1035.0,
   "height": 40.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 404241178,
   "version": 1,
   "versionNonce": 690473472,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "All four work with async replication. Sync adds one guarantee: a commit the client saw as OK also exists on another\nmachine. That matters the moment the primary is gone for good and you promote a replica (failover).",
   "fontSize": 16,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "All four work with async replication. Sync adds one guarantee: a commit the client saw as OK also exists on another\nmachine. That matters the moment the primary is gone for good and you promote a replica (failover).",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "megJ9DcGz51VtFgp",
   "type": "text",
   "x": 40,
   "y": 1939.75,
   "width": 879.75,
   "height": 42.5,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 370567446,
   "version": 1,
   "versionNonce": 84057081,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "fsync survives a crash, not losing the machine",
   "fontSize": 34,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "fsync survives a crash, not losing the machine",
   "lineHeight": 1.25,
   "autoResize": true
  },
