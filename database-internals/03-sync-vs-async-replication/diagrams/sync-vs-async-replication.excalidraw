   "versionNonce": 1802230237,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "four jobs; sync vs async only changes how much of the newest work you can lose",
   "fontSize": 19,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "four jobs; sync vs async only changes how much of the newest work you can lose",
   "lineHeight": 1.25,
   "autoResize": true
  },
