  },
  {
   "id": "XIvx3Ru4Hx5BVzbR",
   "type": "text",
   "x": 60,
   "y": 4327.75,
   "width": 468.0,
   "height": 120.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1124968366,
   "version": 1,
   "versionNonce": 137164053,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Postgres: commits wait until a standby is back. It\nchooses safety over availability. Use 2+ standbys\nwith ANY 1 (...) so one failure doesn't stop writes.\nMySQL semi-sync: after a timeout (10 s by default)\nit falls back to async on its own. Your RPO quietly\nchanged: alert on it.",
   "fontSize": 16,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Postgres: commits wait until a standby is back. It\nchooses safety over availability. Use 2+ standbys\nwith ANY 1 (...) so one failure doesn't stop writes.\nMySQL semi-sync: after a timeout (10 s by default)\nit falls back to async on its own. Your RPO quietly\nchanged: alert on it.",
   "lineHeight": 1.25,
   "autoResize": true
  },
