   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Don't let one standby freeze you",
   "fontSize": 16,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Don't let one standby freeze you",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "CkprpZ9wV9ybGAGQ",
   "type": "text",
   "x": 990,
   "y": 3585.75,
   "width": 369.0,
   "height": 60.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 476743696,
   "version": 1,
   "versionNonce": 1096668867,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "If the only sync standby dies, Postgres\ncommits wait. Use two and ANY 1 (s1, s2):\nany one ack is enough.",
   "fontSize": 16,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "If the only sync standby dies, Postgres\ncommits wait. Use two and ANY 1 (s1, s2):\nany one ack is enough.",
   "lineHeight": 1.25,
   "autoResize": true
  },
