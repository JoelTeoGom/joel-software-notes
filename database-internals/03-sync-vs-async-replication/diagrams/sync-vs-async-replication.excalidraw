  {
   "id": "NVmJU3tUu3WZIwXg",
   "type": "text",
   "x": 990,
   "y": 2563.75,
   "width": 360.0,
   "height": 60.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1206136801,
   "version": 1,
   "versionNonce": 228028270,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Every commit waits a round trip to the\nstandby + its fsync. Same region: ~1 ms.\nAnother country: tens of ms, every time.",
   "fontSize": 16,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Every commit waits a round trip to the\nstandby + its fsync. Same region: ~1 ms.\nAnother country: tens of ms, every time.",
   "lineHeight": 1.25,
   "autoResize": true
  },
