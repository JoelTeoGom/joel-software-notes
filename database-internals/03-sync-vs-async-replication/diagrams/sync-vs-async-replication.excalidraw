   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Async: whatever the replica hadn't\nreceived yet (the lag: ms, seconds under\nload). Sync: zero committed transactions.",
   "fontSize": 16,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Async: whatever the replica hadn't\nreceived yet (the lag: ms, seconds under\nload). Sync: zero committed transactions.",
   "lineHeight": 1.25,
   "autoResize": true
  },
