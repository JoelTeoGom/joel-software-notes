   "roundness": null,
   "seed": 1173727037,
   "version": 1,
   "versionNonce": 1633123131,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "\"Payments commit synchronously to a standby in another zone of the same region (RPO = 0, ~1 ms per commit),\nand replicate asynchronously to another region for disaster recovery and reads.\"",
   "fontSize": 16,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "\"Payments commit synchronously to a standby in another zone of the same region (RPO = 0, ~1 ms per commit),\nand replicate asynchronously to another region for disaster recovery and reads.\"",
   "lineHeight": 1.25,
   "autoResize": true
  }
