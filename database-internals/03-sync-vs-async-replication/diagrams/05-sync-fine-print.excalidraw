   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "BEGIN;\nSET LOCAL synchronous_commit = local;\nINSERT INTO audit_log ...;   -- ok to lose\nCOMMIT;\n-- payments keep the default: on",
   "fontSize": 16,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "BEGIN;\nSET LOCAL synchronous_commit = local;\nINSERT INTO audit_log ...;   -- ok to lose\nCOMMIT;\n-- payments keep the default: on",
   "lineHeight": 1.25,
   "autoResize": true
