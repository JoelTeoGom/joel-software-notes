  {
   "id": "SkyTvnPdXlfxxMu5",
   "type": "text",
   "x": 60,
   "y": 734.0,
   "width": 963.0,
   "height": 40.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
