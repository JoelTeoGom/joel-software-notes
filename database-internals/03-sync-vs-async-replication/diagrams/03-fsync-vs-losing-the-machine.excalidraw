   "versionNonce": 228028270,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Every commit waits a round trip to the\nstandby + its fsync. Same region: ~1 ms.\nAnother country: tens of ms, every time.",
   "fontSize": 16,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Every commit waits a round trip to the\nstandby + its fsync. Same region: ~1 ms.\nAnother country: tens of ms, every time.",
   "lineHeight": 1.25,
   "autoResize": true
  }
