   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Why fsync isn't enough",
   "fontSize": 16,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Why fsync isn't enough",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "JKqnu5mV17kC03BF",
   "type": "text",
   "x": 525,
   "y": 644.0,
   "width": 396.0,
   "height": 60.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 97628477,
   "version": 1,
   "versionNonce": 2036988849,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "fsync survives a crash or power cut of\nTHIS machine. If the machine or its disk\nis gone, only another machine's copy counts.",
   "fontSize": 16,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "fsync survives a crash or power cut of\nTHIS machine. If the machine or its disk\nis gone, only another machine's copy counts.",
   "lineHeight": 1.25,
   "autoResize": true
  },
