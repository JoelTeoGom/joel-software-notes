  },
  {
   "id": "iB6ZlkqBFpbI3dLD",
   "type": "text",
   "x": 60,
   "y": 777.75,
   "width": 945.0,
   "height": 100.0,
   "angle": 0,
   "strokeColor": "#e03131",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 558681427,
   "version": 1,
   "versionNonce": 814119354,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Nobody reads the WAL to write the data files: the dirty pages in RAM already hold the change,\nand the checkpointer (helped by the background writer) writes them to disk.\nThe WAL is only read for:  1) crash recovery   2) point-in-time recovery   3) the senders (replicas, CDC)\n4) the replicas themselves, which are in recovery all the time: pg_is_in_recovery() = true.\nFlush = write to disk. It never means delete.",
   "fontSize": 16,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Nobody reads the WAL to write the data files: the dirty pages in RAM already hold the change,\nand the checkpointer (helped by the background writer) writes them to disk.\nThe WAL is only read for:  1) crash recovery   2) point-in-time recovery   3) the senders (replicas, CDC)\n4) the replicas themselves, which are in recovery all the time: pg_is_in_recovery() = true.\nFlush = write to disk. It never means delete.",
   "lineHeight": 1.25,
   "autoResize": true
  }
 ],
