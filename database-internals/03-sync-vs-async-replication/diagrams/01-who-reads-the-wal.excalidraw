   "seed": 2024522297,
   "version": 1,
   "versionNonce": 755396287,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Flush = write to disk (fsync). On the primary the WAL is never 'applied' from the file: the change is already in the\npage in RAM, and the checkpointer writes that page. The WAL is the insurance for when RAM is lost before that.",
   "fontSize": 16,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Flush = write to disk (fsync). On the primary the WAL is never 'applied' from the file: the change is already in the\npage in RAM, and the checkpointer writes that page. The WAL is the insurance for when RAM is lost before that.",
   "lineHeight": 1.25,
   "autoResize": true
  },
