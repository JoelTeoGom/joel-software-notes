  },
  {
   "id": "pmITUm8sMeUL9Z9U",
   "type": "text",
   "x": 60,
   "y": 784.0,
   "width": 333.0,
   "height": 60.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 625880144,
   "version": 1,
   "versionNonce": 1578130682,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Every commit waits for its ack.\nAnother zone, same region: ~1 ms.\nAnother country: ~30 ms per transfer.",
   "fontSize": 16,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Every commit waits for its ack.\nAnother zone, same region: ~1 ms.\nAnother country: ~30 ms per transfer.",
   "lineHeight": 1.25,
   "autoResize": true
  },
