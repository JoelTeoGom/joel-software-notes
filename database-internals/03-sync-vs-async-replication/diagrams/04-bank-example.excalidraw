  },
  {
   "id": "CkprpZ9wV9ybGAGQ",
   "type": "text",
   "x": 990,
   "y": 784.0,
   "width": 369.0,
   "height": 60.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
