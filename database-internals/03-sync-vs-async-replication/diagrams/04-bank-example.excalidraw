  {
   "id": "E02yyarfIoTPQqJt",
   "type": "text",
   "x": 525,
   "y": 784.0,
   "width": 351.0,
   "height": 60.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
