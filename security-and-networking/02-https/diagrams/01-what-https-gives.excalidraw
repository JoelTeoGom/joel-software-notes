      "isDeleted": false,
      "boundElements": null,
      "updated": 1793700000000,
      "link": null,
      "locked": false,
      "text": "Any change on the way breaks\nthe check: the connection fails\ninstead of accepting the data.",
      "fontSize": 17,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Any change on the way breaks\nthe check: the connection fails\ninstead of accepting the data.",
