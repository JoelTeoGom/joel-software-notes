      "isDeleted": false,
      "boundElements": null,
      "updated": 1793700000000,
      "link": null,
      "locked": false,
      "text": "Nobody on the path can read\nthe request or the response.\nThey only see IPs, ports and\nthe server name (SNI).",
      "fontSize": 17,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Nobody on the path can read\nthe request or the response.\nThey only see IPs, ports and\nthe server name (SNI).",
      "autoResize": true,
      "lineHeight": 1.25
    },
