      "versionNonce": 7038,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1793700000000,
      "link": null,
      "locked": false,
      "text": "You are talking to the real\nbank.com, not an impostor.\nThis is what the certificate\nis for.",
      "fontSize": 17,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "You are talking to the real\nbank.com, not an impostor.\nThis is what the certificate\nis for.",
      "autoResize": true,
      "lineHeight": 1.25
    },
