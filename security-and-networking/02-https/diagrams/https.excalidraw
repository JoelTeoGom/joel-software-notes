    {
      "id": "04-session-keys-and-cost-hyqyjko9u2",
      "type": "text",
      "x": 1030,
      "y": 3397,
      "width": 161.70000000000002,
      "height": 26.25,
      "angle": 0,
      "strokeColor": "#495057",
