      "versionNonce": 7070,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1793700000000,
      "link": null,
      "locked": false,
      "text": "Why it's cheap",
      "fontSize": 21,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Why it's cheap",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "04-session-keys-and-cost-hzmvw9r0af",
      "type": "text",
      "x": 1030,
      "y": 3439,
      "width": 271.15000000000003,
      "height": 233.75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1j",
      "roundness": null,
      "seed": 7071,
      "version": 1,
      "versionNonce": 7072,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1793700000000,
      "link": null,
      "locked": false,
      "text": "TLS 1.2 needed 2 round trips;\nTLS 1.3 needs 1.\n\nAES-GCM runs in hardware\n(AES-NI): encrypting each\nrequest is almost free.\n\nThat's why clients keep idle\nconnections open: Go's\nMaxIdleConnsPerHost and\nIdleConnTimeout.",
      "fontSize": 17,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "TLS 1.2 needed 2 round trips;\nTLS 1.3 needs 1.\n\nAES-GCM runs in hardware\n(AES-NI): encrypting each\nrequest is almost free.\n\nThat's why clients keep idle\nconnections open: Go's\nMaxIdleConnsPerHost and\nIdleConnTimeout.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "04-session-keys-and-cost-h10p2s7rf45",
      "type": "rectangle",
      "x": 40,
      "y": 3770,
      "width": 1320,
      "height": 90,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "#ebfbee",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1k",
      "roundness": {
        "type": 3
      },
      "seed": 7073,
      "version": 1,
      "versionNonce": 7074,
      "isDeleted": false,
      "boundElements": [
        {
          "type": "text",
          "id": "04-session-keys-and-cost-h111hg8cna5"
        }
      ],
      "updated": 1793700000000,
      "link": null,
      "locked": false
    },
    {
      "id": "04-session-keys-and-cost-h111hg8cna5",
      "type": "text",
      "x": 360.375,
      "y": 3791.25,
      "width": 679.25,
      "height": 47.5,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1l",
      "roundness": null,
      "seed": 7075,
      "version": 1,
      "versionNonce": 7076,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1793700000000,
      "link": null,
      "locked": false,
      "text": "The cost is one extra round trip and some CPU per new connection.\nReuse the connection and HTTPS costs almost nothing.",
      "fontSize": 19,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "04-session-keys-and-cost-h10p2s7rf45",
      "originalText": "The cost is one extra round trip and some CPU per new connection.\nReuse the connection and HTTPS costs almost nothing.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "05-where-tls-ends-h0ykx3ztci",
      "type": "text",
      "x": 40,
      "y": 4090,
      "width": 523.6,
      "height": 42.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1m",
      "roundness": null,
      "seed": 7001,
      "version": 1,
      "versionNonce": 7002,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1793700000000,
      "link": null,
      "locked": false,
      "text": "Where TLS ends in a platform",
      "fontSize": 34,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Where TLS ends in a platform",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "05-where-tls-ends-h1mzrs1snm",
      "type": "text",
      "x": 40,
      "y": 4148,
      "width": 891.0000000000001,
      "height": 25,
      "angle": 0,
      "strokeColor": "#868e96",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
