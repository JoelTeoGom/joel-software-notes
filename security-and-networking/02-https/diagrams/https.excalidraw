      "versionNonce": 7064,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1793700000000,
      "link": null,
      "locked": false,
      "text": "A stolen certificate is useless: it is public anyway.\nWithout the private key, an impostor cannot produce CertificateVerify.",
      "fontSize": 19,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "03-tls-handshake-huo1ap2fp1",
      "originalText": "A stolen certificate is useless: it is public anyway.\nWithout the private key, an impostor cannot produce CertificateVerify.",
      "autoResize": true,
      "lineHeight": 1.25
    },
