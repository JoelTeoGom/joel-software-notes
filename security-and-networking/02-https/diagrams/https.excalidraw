    {
      "id": "04-session-keys-and-cost-h7vdxxrb9g",
      "type": "text",
      "x": 750,
      "y": 3214,
      "width": 486.20000000000005,
      "height": 63.75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1H",
      "roundness": null,
      "seed": 7015,
      "version": 1,
      "versionNonce": 7016,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1793700000000,
      "link": null,
      "locked": false,
      "text": "The keys are ephemeral: thrown away when the\nconnection closes. Stealing the server's private key\nnext year cannot decrypt today's recorded traffic.",
      "fontSize": 17,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The keys are ephemeral: thrown away when the\nconnection closes. Stealing the server's private key\nnext year cannot decrypt today's recorded traffic.",
      "autoResize": true,
      "lineHeight": 1.25
    },
