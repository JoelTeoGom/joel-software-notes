    {
      "id": "03-tls-handshake-hve4rui9hy",
      "type": "text",
      "x": 334.24999999999994,
      "y": 2731.25,
      "width": 731.5000000000001,
      "height": 47.5,
      "angle": 0,
      "strokeColor": "#6741d9",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
