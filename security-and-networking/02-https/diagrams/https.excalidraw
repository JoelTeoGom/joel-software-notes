      "index": "b1n",
      "roundness": null,
      "seed": 7003,
      "version": 1,
      "versionNonce": 7004,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1793700000000,
      "link": null,
      "locked": false,
      "text": "inbound you need a certificate for your domain; outbound the client only verifies",
      "fontSize": 20,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "inbound you need a certificate for your domain; outbound the client only verifies",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "05-where-tls-ends-h2t7wiilqg",
      "type": "text",
      "x": 40,
      "y": 4210,
      "width": 449.35,
      "height": 23.75,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
