    },
    {
      "id": "hfudtkgqwp",
      "type": "text",
      "x": 70,
      "y": 404,
      "width": 585,
      "height": 108,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aF",
      "roundness": null,
      "seed": 7031,
      "version": 1,
      "versionNonce": 7032,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1793700000000,
      "link": null,
      "locked": false,
      "text": "Root CA              already in the OS / browser trust store\n  └─ signs  Intermediate CA\n              └─ signs  the bank.com certificate (leaf)\n\nThe server sends the leaf + the intermediate.\nThe client already has the root, so it can check every signature.",
      "fontSize": 15,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Root CA              already in the OS / browser trust store\n  └─ signs  Intermediate CA\n              └─ signs  the bank.com certificate (leaf)\n\nThe server sends the leaf + the intermediate.\nThe client already has the root, so it can check every signature.",
      "autoResize": true,
      "lineHeight": 1.2
    },
