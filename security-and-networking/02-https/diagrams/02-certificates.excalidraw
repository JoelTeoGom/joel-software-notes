      "index": "aI",
      "roundness": null,
      "seed": 7037,
      "version": 1,
      "versionNonce": 7038,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1793700000000,
      "link": null,
      "locked": false,
      "text": "You can sign your own certificate,\nbut no CA in the trust store vouches\nfor it: browsers warn, curl and Go\nrefuse to connect.\n\nFine for local tests: mkcert creates\na local CA that only your machine trusts.",
      "fontSize": 17,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "You can sign your own certificate,\nbut no CA in the trust store vouches\nfor it: browsers warn, curl and Go\nrefuse to connect.\n\nFine for local tests: mkcert creates\na local CA that only your machine trusts.",
      "autoResize": true,
      "lineHeight": 1.25
    }
