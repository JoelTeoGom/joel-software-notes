      "updated": 1793700000000,
      "link": null,
      "locked": false,
      "text": "The chain of trust",
      "fontSize": 21,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The chain of trust",
      "autoResize": true,
