      "updated": 1793700000000,
      "link": null,
      "locked": false,
      "text": "Session keys (ECDHE)",
      "fontSize": 21,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Session keys (ECDHE)",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "h4j69jm41a",
      "type": "text",
      "x": 70,
      "y": 214,
      "width": 495.55000000000007,
      "height": 63.75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a4",
      "roundness": null,
      "seed": 7009,
      "version": 1,
      "versionNonce": 7010,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1793700000000,
      "link": null,
      "locked": false,
      "text": "Each side sends half (its key share) and both compute\nthe same secret. The secret itself never travels.\nKeys live as long as the connection, not one request.",
      "fontSize": 17,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Each side sends half (its key share) and both compute\nthe same secret. The secret itself never travels.\nKeys live as long as the connection, not one request.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "h5mgsazj0r",
