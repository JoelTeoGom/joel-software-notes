      "versionNonce": 7004,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1793700000000,
      "link": null,
      "locked": false,
      "text": "the expensive part happens once per connection; requests on an open connection are cheap",
      "fontSize": 20,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "the expensive part happens once per connection; requests on an open connection are cheap",
      "autoResize": true,
      "lineHeight": 1.25
    },
