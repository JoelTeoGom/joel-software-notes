      "roundness": {
        "type": 3
      },
      "seed": 7011,
      "version": 1,
      "versionNonce": 7012,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1793700000000,
      "link": null,
      "locked": false
    },
    {
      "id": "h674i0k9oi",
      "type": "text",
      "x": 750,
      "y": 172,
      "width": 173.25,
      "height": 26.25,
