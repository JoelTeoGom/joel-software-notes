      "isDeleted": false,
      "boundElements": null,
      "updated": 1793636677088,
      "link": null,
      "locked": false,
      "text": "\n\nevil.com is a public domain.\nIts DNS record says:\n\n  evil.com  A  127.0.0.1\n\nThe text looks public.",
      "fontSize": 15,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "\n\nevil.com is a public domain.\nIts DNS record says:\n\n  evil.com  A  127.0.0.1\n\nThe text looks public.",
      "autoResize": true,
      "lineHeight": 1.25
    },
