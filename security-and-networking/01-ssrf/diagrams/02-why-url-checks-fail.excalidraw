      "link": null,
      "locked": false,
      "text": "DNS rebinding\n(time-of-check vs time-of-use)",
      "fontSize": 19,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "DNS rebinding\n(time-of-check vs time-of-use)",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "m1OdJhcxZzHC0CcaABIXR",
      "type": "text",
      "x": 412,
      "y": 212,
      "width": 230.9716033935547,
      "height": 131.25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a7",
      "roundness": null,
      "seed": 912482359,
      "version": 2,
      "versionNonce": 1593534553,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1793636677088,
      "link": null,
      "locked": false,
      "text": "\n\nThe answer changes between\nthe check and the connection.\nIn a scheduler the gap is\nhours or days: the task is\nvalidated once, run many times.",
      "fontSize": 15,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "\n\nThe answer changes between\nthe check and the connection.\nIn a scheduler the gap is\nhours or days: the task is\nvalidated once, run many times.",
      "autoResize": true,
      "lineHeight": 1.25
    },
