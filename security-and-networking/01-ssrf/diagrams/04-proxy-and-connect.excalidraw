      "verticalAlign": "top",
      "containerId": null,
      "originalText": "And for http:// URLs",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "oMv6lPCi72oOrlAlt_JRs",
      "type": "text",
      "x": 792,
      "y": 562,
      "width": 387.49761962890625,
      "height": 131.25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aN",
      "roundness": null,
      "seed": 66942841,
      "version": 2,
      "versionNonce": 1679445527,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1793636677461,
      "link": null,
      "locked": false,
      "text": "No CONNECT: the full URL goes in the request line,\nand the proxy makes the request itself.\n\n  GET http://evil.com/path HTTP/1.1\n\nEither way, the proxy is the one that resolves\nthe name and opens the final connection.",
      "fontSize": 15,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "No CONNECT: the full URL goes in the request line,\nand the proxy makes the request itself.\n\n  GET http://evil.com/path HTTP/1.1\n\nEither way, the proxy is the one that resolves\nthe name and opens the final connection.",
      "autoResize": true,
      "lineHeight": 1.25
    },
