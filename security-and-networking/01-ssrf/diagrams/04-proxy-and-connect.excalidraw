      "updated": 1793636677461,
      "link": null,
      "locked": false,
      "text": "CONNECT evil.com:443 HTTP/1.1\nHost: evil.com:443\n\n<- HTTP/1.1 200 Connection established\n\nthen TLS end to end through the tunnel:\nthe proxy only copies bytes",
      "fontSize": 14,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "CONNECT evil.com:443 HTTP/1.1\nHost: evil.com:443\n\n<- HTTP/1.1 200 Connection established\n\nthen TLS end to end through the tunnel:\nthe proxy only copies bytes",
      "autoResize": true,
      "lineHeight": 1.2
    },
