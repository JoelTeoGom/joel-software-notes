      "isDeleted": false,
      "boundElements": null,
      "updated": 1793636678077,
      "link": null,
      "locked": false,
      "text": "1. mTLS: who is calling?\n   (client certificate CN)\n2. ACL for that role:\n   which hosts it may reach\n3. resolve DNS, reject\n   internal IPs\n4. connect, then only\n   copy bytes",
      "fontSize": 15,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. mTLS: who is calling?\n   (client certificate CN)\n2. ACL for that role:\n   which hosts it may reach\n3. resolve DNS, reject\n   internal IPs\n4. connect, then only\n   copy bytes",
      "autoResize": true,
      "lineHeight": 1.25
    },
