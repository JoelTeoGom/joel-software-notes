      "isDeleted": false,
      "boundElements": null,
      "updated": 1793636678077,
      "link": null,
      "locked": false,
      "text": "The proxy trap: HTTPS_PROXY and CONNECT",
      "fontSize": 34,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The proxy trap: HTTPS_PROXY and CONNECT",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "F5mQLegxyMxg3gkw9q_uW",
      "type": "text",
      "x": 40,
      "y": 3234,
      "width": 865.3591918945312,
      "height": 25,
      "angle": 0,
      "strokeColor": "#868e96",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0F",
      "roundness": null,
      "seed": 101875063,
      "version": 2,
      "versionNonce": 1335924761,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1793636678077,
      "link": null,
      "locked": false,
      "text": "behind a proxy, the proxy resolves the name and picks the IP; your check never sees it",
      "fontSize": 20,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "behind a proxy, the proxy resolves the name and picks the IP; your check never sees it",
      "autoResize": true,
      "lineHeight": 1.25
    },
