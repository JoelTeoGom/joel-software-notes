      "link": null,
      "locked": false,
      "text": "What the client sends to the proxy (https://)",
      "fontSize": 19,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "What the client sends to the proxy (https://)",
