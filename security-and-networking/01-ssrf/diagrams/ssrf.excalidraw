      "isDeleted": false,
      "boundElements": null,
      "updated": 1793636678077,
      "link": null,
      "locked": false,
      "text": "\n\nThe answer changes between\nthe check and the connection.\nIn a scheduler the gap is\nhours or days: the task is\nvalidated once, run many times.",
      "fontSize": 15,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "\n\nThe answer changes between\nthe check and the connection.\nIn a scheduler the gap is\nhours or days: the task is\nvalidated once, run many times.",
      "autoResize": true,
      "lineHeight": 1.25
    },
