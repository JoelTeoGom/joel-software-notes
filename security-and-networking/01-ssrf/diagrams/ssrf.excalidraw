    },
    {
      "id": "hgzytt5fdiqyDLIm4RIB9",
      "type": "text",
      "x": 62,
      "y": 3712,
      "width": 319.921875,
      "height": 117.60000000000001,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0Y",
      "roundness": null,
      "seed": 834746713,
      "version": 2,
      "versionNonce": 88749079,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1793636678077,
      "link": null,
      "locked": false,
      "text": "CONNECT evil.com:443 HTTP/1.1\nHost: evil.com:443\n\n<- HTTP/1.1 200 Connection established\n\nthen TLS end to end through the tunnel:\nthe proxy only copies bytes",
      "fontSize": 14,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "CONNECT evil.com:443 HTTP/1.1\nHost: evil.com:443\n\n<- HTTP/1.1 200 Connection established\n\nthen TLS end to end through the tunnel:\nthe proxy only copies bytes",
      "autoResize": true,
      "lineHeight": 1.2
    },
