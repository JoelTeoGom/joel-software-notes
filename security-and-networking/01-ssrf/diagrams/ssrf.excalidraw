    {
      "id": "xKPJw5oM1uhxtTk_NX3Tk",
      "type": "text",
      "x": 772,
      "y": 2610,
      "width": 342.6470642089844,
      "height": 23.75,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0C",
      "roundness": null,
      "seed": 221270969,
      "version": 2,
      "versionNonce": 1817023415,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1793636678077,
      "link": null,
      "locked": false,
      "text": "It runs on every connection attempt",
      "fontSize": 19,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "It runs on every connection attempt",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "S5TxRP1IPTWY7qpwlmccJ",
      "type": "text",
      "x": 772,
      "y": 2652,
      "width": 396.18267822265625,
      "height": 150,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0D",
      "roundness": null,
      "seed": 1534763095,
      "version": 2,
      "versionNonce": 2010113849,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1793636678077,
      "link": null,
      "locked": false,
      "text": "- every IP of a name (Happy Eyeballs tries IPv4\n  and IPv6 in parallel)\n- every retry and every redirect\n- an IP written straight into the URL (no DNS step,\n  but it still goes through Control)\n\nKeep-alive reuse skips the dial: fine, that connection\nwas checked when it was opened.",
      "fontSize": 15,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- every IP of a name (Happy Eyeballs tries IPv4\n  and IPv6 in parallel)\n- every retry and every redirect\n- an IP written straight into the URL (no DNS step,\n  but it still goes through Control)\n\nKeep-alive reuse skips the dial: fine, that connection\nwas checked when it was opened.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "-101CUTul8B4__jtHMN00",
      "type": "text",
      "x": 40,
      "y": 3180,
      "width": 787.64208984375,
      "height": 42.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
